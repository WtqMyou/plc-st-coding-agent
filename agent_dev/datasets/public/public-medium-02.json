{
  "pid": "public-medium-02",
  "source": "public",
  "difficulty": "medium",
  "title": "Analog Batch Processing",
  "requirements": "Write a PLC function block that processes analog inputs in batches and converts them into engineering values.\n\n1. analogValues supplies the raw-value array. channels supplies per-channel settings and receives conversion results. count specifies how many channels to process from the beginning of the arrays. The caller must provide count from zero through the smaller of the two array lengths. Match channels by ordinal position starting at each array's own lower bound. Read analogValues without modifying it.\n2. Each channel is enabled by its enable field and converted according to measuringMode. Read configuration fields without modifying them; write only retVal and outputValue.\n3. For measuringMode 0, perform non-temperature linear scaling: when bipolar is FALSE, map raw values 0..27648 to loLIM..hiLIM; when TRUE, map -27648..27648 to loLIM..hiLIM.\n4. For measuringMode 1, perform standard-temperature conversion: outputValue is one tenth of the raw analog value.\n5. For measuringMode 2, perform climatic-temperature conversion: outputValue is one hundredth of the raw analog value.\n6. If measuringMode is not 0, 1 or 2, set that channel's retVal to 16#8001 and skip its conversion.\n7. If hiLIM is less than or equal to loLIM, set that channel's retVal to 16#8002 and skip its conversion.",
  "variables": [
    {
      "name": "count",
      "data_type": "DINT",
      "description": "Number of channels to be converted",
      "direction": "input",
      "fields": []
    },
    {
      "name": "analogValues",
      "data_type": "ARRAY[1..8] OF INT",
      "description": "Variable-length analog array passed by reference to preserve its bounds. Read-only to the function block; no element may be modified. 容量上限 8（平台不解析 ARRAY[*] 的运行时长度）；实际有效通道数由 count 给出，按 1..count 取值。",
      "direction": "inout",
      "fields": []
    },
    {
      "name": "channels",
      "data_type": "ARRAY[1..8] OF ST_AnalogChannel",
      "description": "Channel records passed by reference. Configuration fields are read-only; write only retVal and outputValue. 容量上限 8（平台不解析 ARRAY[*] 的运行时长度）；实际有效通道数由 count 给出，按 1..count 取值。",
      "direction": "inout",
      "fields": [
        {
          "name": "enable",
          "data_type": "BOOL",
          "description": "Channel conversion enable. Read-only to the function block. |",
          "direction": "input",
          "fields": []
        },
        {
          "name": "hiLIM",
          "data_type": "REAL",
          "description": "Upper engineering-unit limit. Read-only to the function block. |",
          "direction": "input",
          "fields": []
        },
        {
          "name": "loLIM",
          "data_type": "REAL",
          "description": "Lower engineering-unit limit. Read-only to the function block. |",
          "direction": "input",
          "fields": []
        },
        {
          "name": "bipolar",
          "data_type": "BOOL",
          "description": "FALSE selects unipolar and TRUE selects bipolar operation. Read-only to the function block. |",
          "direction": "input",
          "fields": []
        },
        {
          "name": "measuringMode",
          "data_type": "INT",
          "description": "0 non-temperature, 1 standard temperature, 2 climatic temperature. Read-only to the function block. |",
          "direction": "input",
          "fields": []
        },
        {
          "name": "retVal",
          "data_type": "WORD",
          "description": "Per-channel status code written by the function block. |",
          "direction": "output",
          "fields": []
        },
        {
          "name": "outputValue",
          "data_type": "REAL",
          "description": "Converted value written by the function block. |",
          "direction": "output",
          "fields": []
        }
      ]
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S5",
      "text": "count 小于 1 时不得处理任何通道，channels 的 retVal/outputValue 必须保持上一拍的值。",
      "ltl": "G(count < 1 -> (channels[1].retVal = prev(channels[1].retVal) & channels[1].outputValue = prev(channels[1].outputValue) & channels[8].retVal = prev(channels[8].retVal)))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S6",
      "text": "未使能通道的 retVal 不得被改写（enable=FALSE 的通道整条跳过）。",
      "ltl": "G(!channels[1].enable -> channels[1].retVal = prev(channels[1].retVal))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S1",
      "text": "analogValues 是只读输入量，任何周期都不得被改写；未使能通道的 retVal/outputValue 必须保持原值。",
      "ltl": "",
      "kind": "safety",
      "verified_by": "simulation"
    },
    {
      "sid": "S2",
      "text": "measuringMode 不在 0/1/2 时该通道 retVal=16#8001 且跳过转换；hiLIM<=loLIM 时 retVal=16#8002 且跳过转换。",
      "ltl": "",
      "kind": "safety",
      "verified_by": "simulation"
    },
    {
      "sid": "S3",
      "text": "mode0 线性标定：bipolar=FALSE 时 0..27648 线性映射到 loLIM..hiLIM，bipolar=TRUE 时 -27648..27648 映射到 loLIM..hiLIM。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    },
    {
      "sid": "S4",
      "text": "mode1 标准温度 outputValue=raw/10，mode2 气候温度 outputValue=raw/100；count 指定从各数组下界起处理的通道数并按序号对应（容量上限 8）。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    }
  ],
