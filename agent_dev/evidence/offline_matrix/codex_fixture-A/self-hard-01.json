      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    flowLow : BOOL;\n    ackBtn : BOOL;\n    sensorOK : BOOL;\nEND_VAR\nVAR_OUTPUT\n    alarmActive : BOOL;\n    alarmAcked : BOOL;\n    highHigh : BOOL;\nEND_VAR\nVAR\n    ackEdge : BOOL;\nEND_VAR\n\nackEdge := ackBtn AND NOT ackEdge;\n\n(* 高优先级：传感器断线，独立判定，不被低优先级抑制 *)\nhighHigh := NOT sensorOK;\n\n(* 生命周期：激活 -> (操作员确认) 已确认 -> 条件消失 清除。\n   顺序很关键——\"条件仍在\"的分支会显式把 acked 置 False，\n   所以 ackBtn 的判定必须放在它**之后**，否则当拍确认立刻被冲掉。 *)\nIF flowLow THEN\n    alarmActive := TRUE;\n    alarmAcked := FALSE;\nELSIF alarmActive THEN\n    (* 条件先消失：无论是否确认过都要清除 *)\n    alarmActive := FALSE;\n    alarmAcked := FALSE;\nEND_IF\nIF alarmActive AND flowLow AND ackEdge THEN\n    alarmAcked := TRUE;\nEND_IF\nEND_FUNCTION_BLOCK",
