      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    resetBtn : BOOL;\n    doneSensor : BOOL;\n    targetVol : REAL;\n    flowVol : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen : BOOL;\n    fillsToday : INT;\nEND_VAR\nVAR\n    startEdge : BOOL;\n    resetEdge : BOOL;\n    accumulated : REAL;\n    filling : BOOL;\n    waitAck : BOOL;\nEND_VAR\n\nstartEdge := startBtn AND NOT startEdge;\nresetEdge := resetBtn AND NOT resetEdge;\n\n(* 复位最高优先级：清零计数、关阀 *)\nIF resetEdge THEN\n    fillsToday := 0;\n    valveOpen := FALSE;\n    filling := FALSE;\n    waitAck := FALSE;\n    accumulated := 0.0;\nELSE\n    (* 运途中重复按启动无效：只在非灌装、非待确认时接受 *)\n    (* 待确认期间再按启动：允许直接开灌下一瓶，上一瓶未确认就不计数了 *)\n    IF startEdge AND waitAck THEN\n        waitAck := FALSE;\n    END_IF\n    IF startEdge AND NOT filling THEN\n        filling := TRUE;\n        valveOpen := TRUE;\n        accumulated := 0.0;\n    END_IF\n\n    IF filling THEN\n        accumulated := accumulated + flowVol;\n        (* 达到或超过目标立即关阀，用 >= 而不是 > *)\n        IF accumulated >= targetVol THEN\n            valveOpen := FALSE;\n            filling := FALSE;\n            waitAck := TRUE;\n        END_IF\n    END_IF\n\n    (* 计数只在满瓶确认之后发生一次 *)\n    IF waitAck AND doneSensor THEN\n        fillsToday := fillsToday + 1;\n        waitAck := FALSE;\n    END_IF\nEND_IF\nEND_FUNCTION_BLOCK",
