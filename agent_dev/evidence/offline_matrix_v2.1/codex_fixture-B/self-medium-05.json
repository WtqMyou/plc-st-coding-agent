      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n enable : BOOL;\n resetBtn : BOOL;\n scanSeconds : LREAL;\n steamFlow : LREAL;\n fuelFlow : LREAL;\n steamTemp : LREAL;\n steamPressure : LREAL;\nEND_VAR\nVAR_OUTPUT\n qualified : BOOL;\n dataFault : BOOL;\n qualifiedTon : LREAL;\n fuelTon : LREAL;\n revenue : LREAL;\n cost : LREAL;\n netProfit : LREAL;\nEND_VAR\nVAR\n prevReset : BOOL;\n qTon : LREAL;\n fTon : LREAL;\nEND_VAR\nqualified := (steamTemp >= 447.0) AND (steamTemp <= 453.0)\n AND (steamPressure >= 3750.0) AND (steamPressure <= 3850.0);\ndataFault := (scanSeconds <= 0.0) OR (scanSeconds > 10.0)\n OR (steamFlow < 0.0) OR (steamFlow > 90.0)\n OR (fuelFlow < 0.0) OR (fuelFlow > 6.0);\nIF resetBtn AND NOT prevReset THEN\n qTon := 0.0;\n fTon := 0.0;\nELSIF enable AND NOT dataFault THEN\n fTon := fTon + fuelFlow * scanSeconds / 1000.0;\n IF qualified THEN\n  qTon := qTon + steamFlow * scanSeconds / 1000.0;\n END_IF;\nEND_IF;\nprevReset := resetBtn;\nqualifiedTon := qTon;\nfuelTon := fTon;\nrevenue := qTon * 280.0;\ncost := fTon * 1500.0;\nnetProfit := revenue - cost;\nEND_FUNCTION_BLOCK",
