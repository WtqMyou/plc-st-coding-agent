      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n enable : BOOL;\n resetBtn : BOOL;\n sensorValid : BOOL;\n setpoint : REAL;\n temperature : REAL;\n scanSeconds : REAL;\n bias : REAL;\nEND_VAR\nVAR_OUTPUT\n power : REAL;\n correction : REAL;\n fault : BOOL;\nEND_VAR\nVAR\n prevReset : BOOL;\n prevE : REAL;\n hasHist : BOOL;\n eNow : REAL;\n eDe : REAL;\n xx : REAL;\n yy : REAL;\n mx : REAL;\n zx : REAL;\n px : REAL;\n my : REAL;\n zy : REAL;\n py : REAL;\n wsum : REAL;\n wc : REAL;\n cOut : REAL;\n edgeReset : BOOL;\nEND_VAR\nfault := (NOT sensorValid) OR (scanSeconds <= 0.0) OR (scanSeconds > 10.0);\nedgeReset := resetBtn AND NOT prevReset;\nIF edgeReset OR (NOT enable) OR fault THEN\n cOut := 0.0;\n hasHist := FALSE;\n prevE := 0.0;\nELSE\n eNow := setpoint - temperature;\n IF hasHist THEN\n  eDe := (eNow - prevE) / scanSeconds;\n ELSE\n  eDe := 0.0;\n END_IF;\n xx := eNow / 10.0;\n IF xx > 1.0 THEN xx := 1.0; END_IF;\n IF xx < -1.0 THEN xx := -1.0; END_IF;\n yy := eDe / 2.0;\n IF yy > 1.0 THEN yy := 1.0; END_IF;\n IF yy < -1.0 THEN yy := -1.0; END_IF;\n mx := MAX(-xx, 0.0);\n zx := 1.0 - ABS(xx);\n px := MAX(xx, 0.0);\n my := MAX(-yy, 0.0);\n zy := 1.0 - ABS(yy);\n py := MAX(yy, 0.0);\n wsum := mx * my + mx * zy + mx * py + zx * my + zx * zy + zx * py\n  + px * my + px * zy + px * py;\n wc := mx * my * (-30.0) + mx * zy * (-20.0) + mx * py * (-10.0)\n  + zx * my * (-10.0) + zx * zy * 0.0 + zx * py * 10.0\n  + px * my * 10.0 + px * zy * 20.0 + px * py * 30.0;\n IF wsum > 0.0 THEN\n  cOut := wc / wsum;\n ELSE\n  cOut := 0.0;\n END_IF;\n prevE := eNow;\n hasHist := TRUE;\nEND_IF;\nprevReset := resetBtn;\ncorrection := cOut;\nIF edgeReset OR (NOT enable) OR fault THEN\n power := 0.0;\nELSE\n power := bias + cOut;\n IF power > 100.0 THEN power := 100.0; END_IF;\n IF power < 0.0 THEN power := 0.0; END_IF;\nEND_IF;\nEND_FUNCTION_BLOCK",
