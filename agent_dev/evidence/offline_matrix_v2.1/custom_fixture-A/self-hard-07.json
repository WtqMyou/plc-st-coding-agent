F;\n  accF := oValve - 2.0 * eFlow;\n END_IF;\nEND_IF;\nprevReset := resetBtn;\nflowSP := oFlow;\nvalveCommand := oValve;\nnormalMode := normalMem;\nEND_FUNCTION_BLOCK",
