      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n runRequest : BOOL;\n flameOK : BOOL;\n o2Valid : BOOL;\n o2PV : REAL;\n baseAir : REAL;\n resetBtn : BOOL;\nEND_VAR\nVAR_OUTPUT\n fuelPermit : BOOL;\n trimEnable : BOOL;\n airTrim : REAL;\n airCommand : REAL;\n tripLatched : BOOL;\n o2Fault : BOOL;\nEND_VAR\nVAR\n prevReset : BOOL;\n tripMem : BOOL;\nEND_VAR\no2Fault := (NOT o2Valid) OR (o2PV < 0.0) OR (o2PV > 21.0);\nIF runRequest AND NOT flameOK THEN\n tripMem := TRUE;\nELSIF resetBtn AND NOT prevReset AND NOT runRequest AND NOT flameOK THEN\n tripMem := FALSE;\nEND_IF;\nprevReset := resetBtn;\ntripLatched := tripMem;\nfuelPermit := runRequest AND flameOK AND NOT tripMem;\ntrimEnable := fuelPermit AND NOT o2Fault;\nIF trimEnable THEN\n airTrim := 2.0 * (2.0 - o2PV);\n IF airTrim > 10.0 THEN airTrim := 10.0; END_IF;\n IF airTrim < -10.0 THEN airTrim := -10.0; END_IF;\nELSE\n airTrim := 0.0;\nEND_IF;\nIF fuelPermit THEN\n airCommand := baseAir + airTrim;\n IF airCommand > 100.0 THEN airCommand := 100.0; END_IF;\n IF airCommand < 0.0 THEN airCommand := 0.0; END_IF;\nELSE\n airCommand := 0.0;\nEND_IF;\nEND_FUNCTION_BLOCK",
