      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorA : BOOL;\n    SensorB : BOOL;\n    SensorC : BOOL;\n    ButtonA : BOOL;\n    ButtonB : BOOL;\n    ButtonC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    CompletionLight : BOOL;\nEND_VAR\nVAR\n    step : INT;\nEND_VAR\n\n(* R2: 正反转互锁，先无条件清零，任何分支都不允许两个方向同时输出 *)\nMotorForward := FALSE;\nMotorReverse := FALSE;\nCompletionLight := FALSE;\n\nIF Mode THEN\n    (* R3: 自动模式按 A -> B -> C 顺序推进；\n       0=等待 A，1=去 B，2=等待 B，3=去 C，4=等待 C，5=已完成 *)\n    CASE step OF\n        0:\n            (* 必须\"产品在 A（SensorA）且工位 A 加工完成（ButtonA）\"才起步 *)\n            IF SensorA AND ButtonA THEN\n                step := 1;\n                MotorForward := TRUE;\n            END_IF\n        1:\n            (* 去 B 途中正转；B 工位传感器一到就立即停，进入等待 B *)\n            MotorForward := TRUE;\n            IF SensorB THEN\n                MotorForward := FALSE;\n                step := 2;\n            END_IF\n        2:\n            IF SensorB AND ButtonB THEN\n                step := 3;\n                MotorForward := TRUE;\n            END_IF\n        3:\n            MotorForward := TRUE;\n            IF SensorC THEN\n                MotorForward := FALSE;\n                step := 4;\n            END_IF\n        4:\n            (* 产品到 C 且工位 C 加工完成 -> 完成灯亮 *)\n            IF SensorC AND ButtonC THEN\n                CompletionLight := TRUE;\n                step := 5;\n            END_IF\n        5:\n            (* 产品被取走（SensorC 不再检测）即灭灯并回到初始等待下一件 *)\n            CompletionLight := SensorC;\n            IF NOT SensorC THEN\n                step := 0;\n            END_IF\n    ELSE\n        step := 0;\n    END_CASE\nELSE\n    (* R2: 手动模式，自动流程作废；正反转按钮互锁，两个同时按下则都不动作 *)\n    step := 0;\n    IF ForwardButton AND NOT ReverseButton THEN\n        MotorForward := TRUE;\n    END_IF\n    IF ReverseButton AND NOT ForwardButton THEN\n        MotorReverse := TRUE;\n    END_IF\nEND_IF\nEND_FUNCTION_BLOCK",
