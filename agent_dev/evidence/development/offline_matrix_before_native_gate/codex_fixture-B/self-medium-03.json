      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn : BOOL;\n    closeBtn : BOOL;\n    openLimit : BOOL;\n    closeLimit : BOOL;\n    obstacle : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp : BOOL;\n    motorDown : BOOL;\n    errorFlag : BOOL;\nEND_VAR\nVAR\n    state : INT;\n    openPrev : BOOL;\n    closePrev : BOOL;\n    openEdge : BOOL;\n    closeEdge : BOOL;\nEND_VAR\n\n(* 状态编码：0=IDLE 1=OPENING 2=CLOSING 3=FAULT *)\nopenEdge := openBtn AND NOT openPrev;\nopenPrev := openBtn;\ncloseEdge := closeBtn AND NOT closePrev;\nclosePrev := closeBtn;\n\n(* 障碍优先于一切：无论哪个方向，立即停机 *)\nIF obstacle THEN\n    motorUp := FALSE;\n    motorDown := FALSE;\n    IF state <> 3 THEN\n        IF state = 2 THEN\n            state := 1;\n        ELSE\n            state := 3;\n            errorFlag := TRUE;\n        END_IF\n    END_IF\nELSE\n    (* 障碍解除后必须能重新启动：FAULT 只是\"停着等\"，不是永久锁死。\n       这一段必须写在 ELSE 里——写进 IF obstacle 里面就成了\"只有还挡着\n       的时候才放行\"，语义完全反了。\n       但**不能在这里清 errorFlag**：清锁存和\"允许动作\"必须是同一件事，\n       否则会出现\"errorFlag 还亮着电机已经转起来\"的中间状态，\n       直接违反 S4（G(errorFlag -> !motorUp & !motorDown)）。\n       所以锁存只在真正接受指令、状态从 IDLE 迁出时清除。 *)\n    CASE state OF\n        0:\n            IF openEdge AND NOT openLimit THEN\n                state := 1;\n                errorFlag := FALSE;\n            ELSIF closeEdge AND NOT closeLimit THEN\n                state := 2;\n                errorFlag := FALSE;\n            END_IF\n        1:\n            IF openLimit THEN\n                state := 0;\n            END_IF\n        2:\n            IF closeLimit THEN\n                state := 0;\n            END_IF\n        3:\n            (* 故障锁存：按第 8 条，只有两键同按才算人工复位。\n               障碍消失只是\"可以复位了\"，不是\"已经复位\"——\n               否则障碍消失的那一拍就会允许起机，违反第 7 条。 *)\n            IF openBtn AND closeBtn THEN\n                state := 0;\n                errorFlag := FALSE;\n            END_IF\n    END_CASE\n\n    (* 电机输出由状态唯一决定，互锁保证不会同时两个方向 *)\n    motorUp := (state = 1);\n    motorDown := (state = 2);\nEND_IF\nEND_FUNCTION_BLOCK",
