      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    rawValue : REAL;\nEND_VAR\nVAR_OUTPUT\n    filteredValue : REAL;\n    windowFull : BOOL;\n    sampleCount : INT;\nEND_VAR\nVAR\n    buf : ARRAY[1..8] OF REAL;\n    wr : INT;\n    i : INT;\n    sum : REAL;\n    keep : REAL;\nEND_VAR\n\n(* 关断时清空历史，但输出保持最后一次的有效值 *)\nIF NOT enable THEN\n    FOR i := 1 TO 8 DO\n        buf[i] := 0.0;\n    END_FOR\n    wr := 0;\n    sampleCount := 0;\n    windowFull := FALSE;\nELSE\n    (* 环形缓冲：wr 指向最老元素，写进去就等于淘汰最老的那个 *)\n    wr := wr + 1;\n    IF wr > 8 THEN\n        wr := 1;\n    END_IF\n    buf[wr] := rawValue;\n    IF sampleCount < 8 THEN\n        sampleCount := sampleCount + 1;\n    END_IF\n    windowFull := sampleCount >= 8;\n\n    (* 只对**实际已有**的样本求平均，未满时不得按 0 填充 *)\n    sum := 0.0;\n    FOR i := 1 TO sampleCount DO\n        sum := sum + buf[i];\n    END_FOR\n    keep := sum / INT_TO_REAL(sampleCount);\nEND_IF\n(* 每一拍都从静态变量刷新输出：输出变量本身不记忆，靠 keep 记忆 *)\nfilteredValue := keep;\nEND_FUNCTION_BLOCK",
