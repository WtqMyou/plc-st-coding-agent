      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    average : LREAL;\n    windowSizeReached : BOOL;\n    error : BOOL;\n    status : WORD;\nEND_VAR\nVAR\n    buf : ARRAY[1..100] OF LREAL;\n    cnt : INT;\n    head : INT;\n    prevTrigger : BOOL;\n    trigEdge : BOOL;\n    n : INT;\n    i : INT;\n    idx : INT;\n    sum : LREAL;\n    take : BOOL;\nEND_VAR\n\n(* R2: 外部触发只取上升沿；周期模式与触发模式共用同一个采样标志 *)\ntrigEdge := trigger AND NOT prevTrigger;\nprevTrigger := trigger;\n\n(* R3: 窗口尺寸校验，16#0000 正常 / 16#8200 窗口长度错误。\n   校验不受 reset 影响：尺寸非法时报错优先，避免复位把错误状态掩盖掉 *)\nIF windowSize < 1 OR windowSize > 100 THEN\n    error := TRUE;\n    status := 16#8200;\nELSE\n    error := FALSE;\n    status := 16#0000;\nEND_IF\n\n(* R3: 复位清空窗口统计；复位当拍不再采样，避免\"清零后立刻又加一个值\" *)\nIF reset THEN\n    cnt := 0;\n    average := 0.0;\n    windowSizeReached := FALSE;\nELSE\n    IF NOT error THEN\n        (* R1: 周期模式每扫描周期采样一次，且此模式下 trigger 无效 *)\n        take := cyclicExecution OR trigEdge;\n        IF take THEN\n            head := head + 1;\n            IF head > 100 THEN\n                head := 1;\n            END_IF\n            buf[head] := value;\n            IF cnt < 100 THEN\n                cnt := cnt + 1;\n            END_IF\n        END_IF\n\n        (* 窗口长度运行时可变：只对最近 n 个样本求均值，FIFO 淘汰最旧样本 *)\n        n := cnt;\n        IF n > windowSize THEN\n            n := windowSize;\n        END_IF\n        windowSizeReached := cnt >= windowSize;\n        IF n > 0 THEN\n            sum := 0.0;\n            FOR i := 0 TO n - 1 DO\n                idx := head - i;\n                IF idx < 1 THEN\n                    idx := idx + 100;\n                END_IF\n                sum := sum + buf[idx];\n            END_FOR\n            average := sum / n;\n        END_IF\n    END_IF\nEND_IF\nEND_FUNCTION_BLOCK",
