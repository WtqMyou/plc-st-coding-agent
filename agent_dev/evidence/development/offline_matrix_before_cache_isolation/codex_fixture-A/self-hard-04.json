      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    demand : INT;\n    runHours : ARRAY[1..5] OF LINT;\n    rotated : BOOL;\nEND_VAR\nVAR_OUTPUT\n    leadPump : INT;\n    lagPump : INT;\n    runningCount : INT;\nEND_VAR\nVAR\n    i : INT;\n    j : INT;\n    need : INT;\n    tmp : LINT;\n    order : ARRAY[1..5] OF INT;\nEND_VAR\n\n(* 需求先裁剪到 0..5，否则后面按 order[i] 取泵号会越界 *)\nneed := demand;\nIF need < 0 THEN\n    need := 0;\nELSIF need > 5 THEN\n    need := 5;\nEND_IF\n\n(* 选择排序：按运行小时升序得到泵号次序 *)\nFOR i := 1 TO 5 DO\n    order[i] := i;\nEND_FOR\nFOR i := 1 TO 4 DO\n    FOR j := i + 1 TO 5 DO\n        IF runHours[order[j]] < runHours[order[i]] THEN\n            tmp := order[i];\n            order[i] := order[j];\n            order[j] := tmp;\n        END_IF\n    END_FOR\nEND_FOR\n\nrunningCount := need;\nIF need = 0 THEN\n    leadPump := 0;\n    lagPump := 0;\nELSIF need = 1 THEN\n    leadPump := order[1];\n    lagPump := 0;\nELSE\n    leadPump := order[1];\n    lagPump := order[2];\n    (* 均衡轮换：两台泵小时数差小于阈值 50 时互换主备，\n       让备泵有机会顶上去，避免主泵长期独挑磨损。 *)\n    IF rotated AND (runHours[order[2]] - runHours[order[1]]) < 50 THEN\n        leadPump := order[2];\n        lagPump := order[1];\n    END_IF\nEND_IF\nEND_FUNCTION_BLOCK",
