+
+# ==========================================================================
+# P05 self-hard-07 串级 PI 控制手自动无扰切换
+# ==========================================================================
+
+def p05_cascade_pi() -> Problem:
+    variables = [
+        V("mode", "INT", "0=手动 1=外环手动/内环自动 2=串级全自动"),
+        V("resetBtn", "BOOL", "复位（上升沿）"),
