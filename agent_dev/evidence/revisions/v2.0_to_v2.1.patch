--- v2.0/datasets/selfmade/tests/self-hard-05.reference.st
+++ v2.1/datasets/selfmade/tests/self-hard-05.reference.st
@@ -0,0 +1,46 @@
+FUNCTION_BLOCK FB
+VAR_INPUT
+ runRequest : BOOL;
+ flameOK : BOOL;
+ o2Valid : BOOL;
+ o2PV : REAL;
+ baseAir : REAL;
+ resetBtn : BOOL;
+END_VAR
+VAR_OUTPUT
+ fuelPermit : BOOL;
+ trimEnable : BOOL;
+ airTrim : REAL;
+ airCommand : REAL;
+ tripLatched : BOOL;
+ o2Fault : BOOL;
+END_VAR
+VAR
+ prevReset : BOOL;
+ tripMem : BOOL;
+END_VAR
+o2Fault := (NOT o2Valid) OR (o2PV < 0.0) OR (o2PV > 21.0);
+IF runRequest AND NOT flameOK THEN
+ tripMem := TRUE;
+ELSIF resetBtn AND NOT prevReset AND NOT runRequest AND NOT flameOK THEN
+ tripMem := FALSE;
+END_IF;
+prevReset := resetBtn;
+tripLatched := tripMem;
+fuelPermit := runRequest AND flameOK AND NOT tripMem;
+trimEnable := fuelPermit AND NOT o2Fault;
+IF trimEnable THEN
+ airTrim := 2.0 * (2.0 - o2PV);
+ IF airTrim > 10.0 THEN airTrim := 10.0; END_IF;
+ IF airTrim < -10.0 THEN airTrim := -10.0; END_IF;
+ELSE
+ airTrim := 0.0;
+END_IF;
+IF fuelPermit THEN
+ airCommand := baseAir + airTrim;
+ IF airCommand > 100.0 THEN airCommand := 100.0; END_IF;
+ IF airCommand < 0.0 THEN airCommand := 0.0; END_IF;
+ELSE
+ airCommand := 0.0;
+END_IF;
+END_FUNCTION_BLOCK
--- v2.0/datasets/selfmade/tests/self-hard-06.reference.st
+++ v2.1/datasets/selfmade/tests/self-hard-06.reference.st
@@ -0,0 +1,66 @@
+FUNCTION_BLOCK FB
+VAR_INPUT
+ runRequest : BOOL;
+ pressure : REAL;
+ pressureValid : BOOL;
+ fuelFlow : REAL;
+ steamFlow : REAL;
+ outletCmd : INT;
+ outletFeedback : INT;
+ resetBtn : BOOL;
+END_VAR
+VAR_OUTPUT
+ tripLatched : BOOL;
+ fuelPermit : BOOL;
+ currentCauseMask : WORD;
+ latchedCauseMask : WORD;
+ diagnosticActive : BOOL;
+END_VAR
+VAR
+ prevReset : BOOL;
+ tripMem : BOOL;
+ latMem : WORD;
+ valveCnt : INT;
+END_VAR
+currentCauseMask := 0;
+IF resetBtn AND NOT prevReset AND NOT runRequest AND pressureValid
+ AND (pressure <= 4200.0) THEN
+ tripMem := FALSE;
+ latMem := 0;
+ valveCnt := 0;
+END_IF;
+prevReset := resetBtn;
+IF NOT runRequest THEN
+ valveCnt := 0;
+ELSIF NOT pressureValid THEN
+ currentCauseMask := 16#0001;
+ valveCnt := 0;
+ tripMem := TRUE;
+ELSIF pressureValid AND (pressure >= 4500.0) THEN
+ IF (outletCmd >= 50) AND (outletFeedback <= 10) THEN
+  valveCnt := valveCnt + 1;
+  IF valveCnt > 3 THEN valveCnt := 3; END_IF;
+ ELSE
+  valveCnt := 0;
+ END_IF;
+ IF valveCnt >= 3 THEN
+  currentCauseMask := currentCauseMask OR 16#0002;
+ END_IF;
+ IF (fuelFlow >= 4.0) AND (steamFlow <= 10.0) THEN
+  currentCauseMask := currentCauseMask OR 16#0004;
+ END_IF;
+ IF currentCauseMask = 0 THEN
+  currentCauseMask := 16#0008;
+ END_IF;
+ tripMem := TRUE;
+ELSE
+ valveCnt := 0;
+END_IF;
+IF tripMem THEN
+ latMem := latMem OR currentCauseMask;
+END_IF;
+tripLatched := tripMem;
+latchedCauseMask := latMem;
+diagnosticActive := (currentCauseMask <> 0);
+fuelPermit := runRequest AND NOT tripMem;
+END_FUNCTION_BLOCK
--- v2.0/datasets/selfmade/tests/self-hard-07.reference.st
+++ v2.1/datasets/selfmade/tests/self-hard-07.reference.st
@@ -0,0 +1,82 @@
+FUNCTION_BLOCK FB
+VAR_INPUT
+ mode : INT;
+ resetBtn : BOOL;
+ dt : REAL;
+ tempSP : REAL;
+ tempPV : REAL;
+ flowPV : REAL;
+ manualFlowSP : REAL;
+ manualValve : REAL;
+END_VAR
+VAR_OUTPUT
+ flowSP : REAL;
+ valveCommand : REAL;
+ fault : BOOL;
+ normalMode : BOOL;
+END_VAR
+VAR
+ prevReset : BOOL;
+ initDone : BOOL;
+ lastMode : INT;
+ accT : REAL;
+ accF : REAL;
+ oFlow : REAL;
+ oValve : REAL;
+ eTemp : REAL;
+ eFlow : REAL;
+ trial : REAL;
+ normalMem : BOOL;
+END_VAR
+fault := (mode < 0) OR (mode > 2) OR (dt <= 0.0) OR (dt > 10.0);
+normalMem := FALSE;
+IF (NOT initDone) OR (resetBtn AND NOT prevReset) OR fault THEN
+ oFlow := manualFlowSP;
+ oValve := manualValve;
+ accT := oFlow - 1.0 * (tempSP - tempPV);
+ accF := oValve - 2.0 * (oFlow - flowPV);
+ lastMode := mode;
+ initDone := TRUE;
+ELSIF lastMode <> mode THEN
+ IF mode <> 2 THEN
+  oFlow := manualFlowSP;
+ END_IF;
+ accT := oFlow - 1.0 * (tempSP - tempPV);
+ accF := oValve - 2.0 * (oFlow - flowPV);
+ lastMode := mode;
+ELSE
+ normalMem := TRUE;
+ IF mode = 0 THEN
+  oFlow := manualFlowSP;
+  oValve := manualValve;
+  accT := oFlow - 1.0 * (tempSP - tempPV);
+  accF := oValve - 2.0 * (oFlow - flowPV);
+ ELSIF mode = 1 THEN
+  oFlow := manualFlowSP;
+  accT := oFlow - 1.0 * (tempSP - tempPV);
+  eFlow := oFlow - flowPV;
+  trial := accF + 0.5 * eFlow * dt;
+  oValve := 2.0 * eFlow + trial;
+  IF oValve > 100.0 THEN oValve := 100.0; END_IF;
+  IF oValve < 0.0 THEN oValve := 0.0; END_IF;
+  accF := oValve - 2.0 * eFlow;
+ ELSE
+  eTemp := tempSP - tempPV;
+  trial := accT + 0.2 * eTemp * dt;
+  oFlow := 1.0 * eTemp + trial;
+  IF oFlow > 50.0 THEN oFlow := 50.0; END_IF;
+  IF oFlow < 0.0 THEN oFlow := 0.0; END_IF;
+  accT := oFlow - 1.0 * eTemp;
+  eFlow := oFlow - flowPV;
+  trial := accF + 0.5 * eFlow * dt;
+  oValve := 2.0 * eFlow + trial;
+  IF oValve > 100.0 THEN oValve := 100.0; END_IF;
+  IF oValve < 0.0 THEN oValve := 0.0; END_IF;
+  accF := oValve - 2.0 * eFlow;
+ END_IF;
+END_IF;
+prevReset := resetBtn;
+flowSP := oFlow;
+valveCommand := oValve;
+normalMode := normalMem;
+END_FUNCTION_BLOCK
--- v2.0/datasets/selfmade/tests/self-medium-05.reference.st
+++ v2.1/datasets/selfmade/tests/self-medium-05.reference.st
@@ -0,0 +1,45 @@
+FUNCTION_BLOCK FB
+VAR_INPUT
+ enable : BOOL;
+ resetBtn : BOOL;
+ dt : LREAL;
+ steamFlow : LREAL;
+ fuelFlow : LREAL;
+ steamTemp : LREAL;
+ steamPressure : LREAL;
+END_VAR
+VAR_OUTPUT
+ qualified : BOOL;
+ dataFault : BOOL;
+ qualifiedTon : LREAL;
+ fuelTon : LREAL;
+ revenue : LREAL;
+ cost : LREAL;
+ netProfit : LREAL;
+END_VAR
+VAR
+ prevReset : BOOL;
+ qTon : LREAL;
+ fTon : LREAL;
+END_VAR
+qualified := (steamTemp >= 447.0) AND (steamTemp <= 453.0)
+ AND (steamPressure >= 3750.0) AND (steamPressure <= 3850.0);
+dataFault := (dt <= 0.0) OR (dt > 10.0)
+ OR (steamFlow < 0.0) OR (steamFlow > 90.0)
+ OR (fuelFlow < 0.0) OR (fuelFlow > 6.0);
+IF resetBtn AND NOT prevReset THEN
+ qTon := 0.0;
+ fTon := 0.0;
+ELSIF enable AND NOT dataFault THEN
+ fTon := fTon + fuelFlow * dt / 1000.0;
+ IF qualified THEN
+  qTon := qTon + steamFlow * dt / 1000.0;
+ END_IF;
+END_IF;
+prevReset := resetBtn;
+qualifiedTon := qTon;
+fuelTon := fTon;
+revenue := qTon * 280.0;
+cost := fTon * 1500.0;
+netProfit := revenue - cost;
+END_FUNCTION_BLOCK
--- v2.0/datasets/selfmade/tests/self-medium-06.reference.st
+++ v2.1/datasets/selfmade/tests/self-medium-06.reference.st
@@ -0,0 +1,82 @@
+FUNCTION_BLOCK FB
+VAR_INPUT
+ enable : BOOL;
+ resetBtn : BOOL;
+ sensorValid : BOOL;
+ setpoint : REAL;
+ temperature : REAL;
+ dt : REAL;
+ bias : REAL;
+END_VAR
+VAR_OUTPUT
+ power : REAL;
+ correction : REAL;
+ fault : BOOL;
+END_VAR
+VAR
+ prevReset : BOOL;
+ prevE : REAL;
+ hasHist : BOOL;
+ eNow : REAL;
+ eDe : REAL;
+ xx : REAL;
+ yy : REAL;
+ mx : REAL;
+ zx : REAL;
+ px : REAL;
+ my : REAL;
+ zy : REAL;
+ py : REAL;
+ wsum : REAL;
+ wc : REAL;
+ cOut : REAL;
+ edgeReset : BOOL;
+END_VAR
+fault := (NOT sensorValid) OR (dt <= 0.0) OR (dt > 10.0);
+edgeReset := resetBtn AND NOT prevReset;
+IF edgeReset OR (NOT enable) OR fault THEN
+ cOut := 0.0;
+ hasHist := FALSE;
+ prevE := 0.0;
+ELSE
+ eNow := setpoint - temperature;
+ IF hasHist THEN
+  eDe := (eNow - prevE) / dt;
+ ELSE
+  eDe := 0.0;
+ END_IF;
+ xx := eNow / 10.0;
+ IF xx > 1.0 THEN xx := 1.0; END_IF;
+ IF xx < -1.0 THEN xx := -1.0; END_IF;
+ yy := eDe / 2.0;
+ IF yy > 1.0 THEN yy := 1.0; END_IF;
+ IF yy < -1.0 THEN yy := -1.0; END_IF;
+ mx := MAX(-xx, 0.0);
+ zx := 1.0 - ABS(xx);
+ px := MAX(xx, 0.0);
+ my := MAX(-yy, 0.0);
+ zy := 1.0 - ABS(yy);
+ py := MAX(yy, 0.0);
+ wsum := mx * my + mx * zy + mx * py + zx * my + zx * zy + zx * py
+  + px * my + px * zy + px * py;
+ wc := mx * my * (-30.0) + mx * zy * (-20.0) + mx * py * (-10.0)
+  + zx * my * (-10.0) + zx * zy * 0.0 + zx * py * 10.0
+  + px * my * 10.0 + px * zy * 20.0 + px * py * 30.0;
+ IF wsum > 0.0 THEN
+  cOut := wc / wsum;
+ ELSE
+  cOut := 0.0;
+ END_IF;
+ prevE := eNow;
+ hasHist := TRUE;
+END_IF;
+prevReset := resetBtn;
+correction := cOut;
+IF edgeReset OR (NOT enable) OR fault THEN
+ power := 0.0;
+ELSE
+ power := bias + cOut;
+ IF power > 100.0 THEN power := 100.0; END_IF;
+ IF power < 0.0 THEN power := 0.0; END_IF;
+END_IF;
+END_FUNCTION_BLOCK
