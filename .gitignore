# Only the two development snapshots and collaboration notes belong in this repo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/progress/
!/agent_dev/
!/agent_dev_r9/
!/agent_dev_r9_stage3/

# Local credentials, environments and generated runtime files.
**/.env
**/.env.*
**/config.local.json
**/credentials.json
**/credentials.*.json
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/runs/
*.pyc
*.tmp
*.zip
*.pem
*.key
*.pfx
*.p12

# Generated native platform projects remain in the local evidence archive.
/agent_dev/platform_projects/
/agent_dev_r9/platform_projects/
/agent_dev_r9_stage3/platform_projects/

# Small, verified handout explicitly prepared for the assigned human reviewer.
!/progress/工艺复核材料_刘晏铭_20261101.zip

# Local viewer identity is runtime state, not experiment evidence.
/progress/evidence/v13_review_20261108/status_viewer.json
/progress/evidence/v13_r2_20261108/status_viewer.json
