      "inputs": {
        "count": 3,
        "avgEnable": false
      },
      "expected": {
        "avgOut": 0.0
      },
      "note": "avgEnable=False：不更新，保持初值 0.0",
      "const_inputs": {
        "enable": true,
        "values": [
          100,
          100,
          100,
          0,
          0,
          0,
          0,
          0
        ]
      },
      "init": {},
      "mode": "",
