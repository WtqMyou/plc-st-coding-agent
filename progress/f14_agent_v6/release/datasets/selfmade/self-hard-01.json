{
  "pid": "self-hard-01",
  "source": "selfmade",
  "difficulty": "hard",
  "title": "带确认与优先级的报警管理（四态报警模型）",
  "requirements": "写一个功能块 FB，实现 ISA-18.2 风格的四态报警管理。\n控制要求：\n1. 报警条件成立（flowLow = TRUE）→ alarmActive 置 TRUE，alarmAcked 置 FALSE；\n2. 报警未被确认时，即使条件消失，alarmActive 仍保持 TRUE（报警在未确认前不得消失），同时 alarmAcked 置 TRUE 表示'已转为待确认清除'；\n3. ackBtn 的**上升沿**确认报警：若此时条件已消失 → alarmActive 与 alarmAcked 一起清除；若条件仍存在 → 只置 alarmAcked，报警继续；\n4. sensorOK 为 FALSE 表示传感器断线 → highHigh 置 TRUE（高优先级）；**高优先级报警与低优先级报警必须同时可见，不得互相抑制**；\n5. 传感器恢复后，highHigh 自动清除，低优先级仍按 1~3 的规则独立判定。",
  "variables": [
    {
      "name": "flowLow",
      "data_type": "BOOL",
      "description": "流量低开关量输入",
      "direction": "input",
      "fields": []
    },
    {
      "name": "ackBtn",
      "data_type": "BOOL",
      "description": "确认按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "sensorOK",
      "data_type": "BOOL",
      "description": "传感器健康状态（FALSE 表示断线）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "alarmActive",
      "data_type": "BOOL",
      "description": "报警激活（条件仍存在）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "alarmAcked",
      "data_type": "BOOL",
      "description": "报警已确认（条件消失后自动清除）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "highHigh",
      "data_type": "BOOL",
      "description": "高优先级报警（传感器断线导致）",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "报警条件持续存在时，确认按钮不得使报警消失（当周期即成立）。",
      "ltl": "G(flowLow & ackBtn -> alarmActive)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "未经确认的报警不会自行消失：条件仍在且未确认时，下一拍必须仍激活。",
      "ltl": "G(alarmActive & !alarmAcked & X(flowLow) -> X(alarmActive))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "传感器断线时高优先级报警必须在当周期置位。",
      "ltl": "G(!sensorOK -> highHigh)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "确认只在上升沿生效：确认沿出现且报警条件仍在时，当拍即置已确认。",
      "ltl": "G(rising(ackBtn) & flowLow -> alarmAcked)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "kind": "safety",
      "text": "断线高报警与传感器状态双向一致，恢复同拍须清除。",
      "ltl": "G(highHigh <-> !sensorOK)",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "kind": "safety",
      "text": "低报警出现即有效；条件消失后仅实际确认或新确认沿允许清除。",
      "ltl": "G(alarmActive <-> (flowLow OR (prev(alarmActive) AND !rising(ackBtn) AND !prev(flowLow AND alarmAcked))))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S7",
      "kind": "safety",
      "text": "区分低报警持续时的真实确认记忆与条件消失后的待清标志。",
      "ltl": "G(alarmAcked <-> (alarmActive AND (!flowLow OR rising(ackBtn) OR prev(flowLow AND alarmActive AND alarmAcked))))",
      "verified_by": "bounded_checker"
    }
  ],
