{
  "pid": "self-medium-03",
  "source": "selfmade",
  "difficulty": "medium",
  "title": "闸门电机有限状态机（四状态与安全互锁）",
  "requirements": "实现闸门功能块 FB，状态为 IDLE、OPENING、CLOSING、FAULT。上电为 IDLE，两按钮的初始前值为 FALSE。输入在每次扫描开始时采样，输出表示本拍结束时的命令。采用以下课程用防夹规则。\n1. 无障碍的 IDLE 中，只有开按钮出现新上升沿、关按钮为 FALSE 且未开到位才开始上升。关方向对称。双键同按不启动。启动当拍即给出对应电机命令；松开按钮继续运行。在运行中忽略方向按钮。\n2. 无障碍时，到达本方向限位则当拍停机并回到 IDLE。另一方向限位不妨碍运动。任一时刻两个电机方向互斥。\n3. 任意状态检测到障碍，当拍关闭两个方向并进入FAULT，errorFlag置TRUE；优先于限位、运动与复位。\n4. FAULT 锁存 errorFlag 并停机。清除须在无障碍时让双键组合从未同时按下变为同时按下；有障碍时按住双键，不能在障碍解除那一拍自动复位。复位仅回到 IDLE，复位当拍两方向都停止，之后按规则 1 重启。",
  "variables": [
    {
      "name": "openBtn",
      "data_type": "BOOL",
      "description": "开门按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "closeBtn",
      "data_type": "BOOL",
      "description": "关门按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "openLimit",
      "data_type": "BOOL",
      "description": "开到位限位开关",
      "direction": "input",
      "fields": []
    },
    {
      "name": "closeLimit",
      "data_type": "BOOL",
      "description": "关到位限位开关",
      "direction": "input",
      "fields": []
    },
    {
      "name": "obstacle",
      "data_type": "BOOL",
      "description": "防夹物体检测",
      "direction": "input",
      "fields": []
    },
    {
      "name": "motorUp",
      "data_type": "BOOL",
      "description": "电机上升（开门）输出",
      "direction": "output",
      "fields": []
    },
    {
      "name": "motorDown",
      "data_type": "BOOL",
      "description": "电机下降（关门）输出",
      "direction": "output",
      "fields": []
    },
    {
      "name": "errorFlag",
      "data_type": "BOOL",
      "description": "故障锁存（需人工复位后清除）",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "两方向不可同时启动。",
      "ltl": "G(!(motorUp AND motorDown))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "有障碍的扫描周期两个方向都停。",
      "ltl": "G(obstacle -> (!motorUp AND !motorDown))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "达到本方向限位就停该方向。",
      "ltl": "G((openLimit -> !motorUp) AND (closeLimit -> !motorDown))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "故障有效时两个方向都停。",
      "ltl": "G(errorFlag -> (!motorUp AND !motorDown))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "已锁存的故障，只有无障碍且双键组合出现新上升沿时才可清除。",
      "ltl": "G((prev(errorFlag) AND !(!obstacle AND rising(openBtn AND closeBtn))) -> errorFlag)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "下降遇障当拍置故障并停机。",
      "ltl": "G((prev(motorDown) AND obstacle) -> (errorFlag AND !motorUp AND !motorDown))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S7",
      "text": "上一拍有障碍，若无新的方向按键沿，两个输出继续保持停止。",
      "ltl": "G((prev(obstacle) AND !rising(openBtn) AND !rising(closeBtn)) -> (!motorUp AND !motorDown))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S8",
      "text": "上升时遇障或障碍连续两拍，故障当拍置位。",
      "ltl": "G((obstacle AND (prev(motorUp) OR prev(obstacle))) -> errorFlag)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S9",
      "text": "在无障碍时人工复位故障：清除报警，当拍仍停机。",
      "ltl": "G((prev(errorFlag) AND !obstacle AND rising(openBtn AND closeBtn)) -> (!errorFlag AND !motorUp AND !motorDown))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S10",
      "text": "空闲状态收到合法开门新指令，当拍上升。",
      "ltl": "G((!prev(motorUp) AND !prev(motorDown) AND !prev(errorFlag) AND !obstacle AND rising(openBtn) AND !closeBtn AND !openLimit) -> motorUp)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S11",
      "text": "空闲状态收到合法关门新指令，当拍下降。",
      "ltl": "G((!prev(motorUp) AND !prev(motorDown) AND !prev(errorFlag) AND !obstacle AND rising(closeBtn) AND !openBtn AND !closeLimit) -> motorDown)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S12",
      "kind": "safety",
      "text": "运动命令必须来自该方向的合法新启动或运行延续；障碍或本方向限位立即停机。",
      "ltl": "G(motorUp <-> (!obstacle AND !openLimit AND (prev(motorUp) OR (!prev(motorUp) AND !prev(motorDown) AND !prev(errorFlag) AND rising(openBtn) AND !closeBtn))))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S13",
      "kind": "safety",
      "text": "运动命令必须来自该方向的合法新启动或运行延续；障碍或本方向限位立即停机。",
      "ltl": "G(motorDown <-> (!obstacle AND !closeLimit AND (prev(motorDown) OR (!prev(motorUp) AND !prev(motorDown) AND !prev(errorFlag) AND rising(closeBtn) AND !openBtn))))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S14",
      "kind": "safety",
      "text": "任意障碍置故障；障碍解除后仅双键组合新沿可复位。",
      "ltl": "G(errorFlag <-> (obstacle OR (prev(errorFlag) AND !rising(openBtn AND closeBtn))))",
      "verified_by": "bounded_checker"
    }
  ],
