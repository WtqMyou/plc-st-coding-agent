FUNCTION_BLOCK FB
VAR_INPUT
    VISCOSITY_OK : BOOL;
    PASTE_E_STOP_NC : BOOL;
    DebounceTime : TIME;
    CycleTime : TIME;
END_VAR
VAR_OUTPUT
    VFD_RUN : BOOL;
    PUMP_MAINT_DUE : BOOL;
    PUMP_RUNTIME_ACC : LTIME;
END_VAR
VAR
    viscosityDelay : TON;
END_VAR
viscosityDelay(IN := VISCOSITY_OK AND PASTE_E_STOP_NC, PT := DebounceTime);
VFD_RUN := viscosityDelay.Q;
IF VFD_RUN THEN
    PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + TIME_TO_LTIME(CycleTime);
END_IF;
PUMP_MAINT_DUE := PUMP_RUNTIME_ACC >= LTIME#500h;
END_FUNCTION_BLOCK
