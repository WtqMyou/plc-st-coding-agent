{
  "pid": "public-medium-04",
  "source": "public",
  "difficulty": "medium",
  "title": "Temperature Logic Control",
  "requirements": "Write a function block FB to implement a temperature control logic. The program should include the following functions:\n1. Read the value of the temperature sensor through an analog input module.\n2. Compare the read temperature value TemperatureSensorInput with the set temperature value SetTemperature.\n3. If the actual temperature is lower than the set temperature, start the heater HeaterOutput.\n4. If the actual temperature is higher than the set temperature, turn off the heater HeaterOutput.\n5. Each scan represents 1 second. The fifth consecutive heating-demand scan triggers protection and already turns the heater off. Cooling starts on the next scan: two scans remain off; the third clears protection and re-evaluates the current input. Cooling advances independently of sensor readings and faults.\n6. Provide status indication, displaying the current temperature, set temperature, heater status, and whether overheating protection is triggered.\n7. Provide temperature sensor fault judgment, if the read temperature value TemperatureSensorInput is less than 0 or greater than 100, it is considered a sensor fault, and the heater should be turned off.\n本修订明确逐拍验收边界：每拍1秒。读数合法（0..100，含边界）且严格低于设定才有加热需求；等于设定或读数故障均关断并清连续加热计数。\n连续需求第5拍触发过热保护，当拍已关断；从下一拍计冷却，前两拍保持关断，第3拍解除保护并按当拍读数重新决策。冷却计数独立于温度和故障；若解除当拍重新加热，该拍为下一轮第1拍。\n连续低温时第1..4拍开，第5..7拍关，第8拍重新开。显示直通当前输入，HeaterStatus跟随HeaterOutput。",
  "variables": [
    {
      "name": "TemperatureSensorInput",
      "data_type": "REAL",
      "description": "The input value of the temperature sensor, i.e., the actual temperature",
      "direction": "input",
      "fields": []
    },
    {
      "name": "SetTemperature",
      "data_type": "REAL",
      "description": "The set temperature value",
      "direction": "input",
      "fields": []
    },
    {
      "name": "CurrentTemperature",
      "data_type": "REAL",
      "description": "Display of the current temperature",
      "direction": "output",
      "fields": []
    },
    {
      "name": "SetTempDisplay",
      "data_type": "REAL",
      "description": "Display of the set temperature",
      "direction": "output",
      "fields": []
    },
    {
      "name": "HeaterStatus",
      "data_type": "BOOL",
      "description": "Display of the heater status",
      "direction": "output",
      "fields": []
    },
    {
      "name": "OverheatProtection",
      "data_type": "BOOL",
      "description": "Display of the overheating protection status",
      "direction": "output",
      "fields": []
    },
    {
      "name": "HeaterOutput",
      "data_type": "BOOL",
      "description": "The control output of the heater",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "传感器读数低于 0 或高于 100 时，加热输出必须为 FALSE。",
      "ltl": "G((TemperatureSensorInput < 0.0 | TemperatureSensorInput > 100.0) -> !HeaterOutput)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "过热保护有效期间，加热输出必须被强制关断。",
      "ltl": "G(OverheatProtection -> !HeaterOutput)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "读数等于或高于设定温度时关断加热。",
      "ltl": "G((TemperatureSensorInput >= SetTemperature & TemperatureSensorInput <= 100.0) -> !HeaterOutput)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "无故障、无过热保护且读数低于设定温度时，加热输出必须为 TRUE（过载触发保护的当拍除外）。",
      "ltl": "G((TemperatureSensorInput < SetTemperature & TemperatureSensorInput >= 0.0 & TemperatureSensorInput <= 100.0 & !OverheatProtection) -> HeaterOutput)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "过热保护连续 3 个周期后必须解除。",
      "ltl": "G((OverheatProtection & X(OverheatProtection) & X(X(OverheatProtection))) -> X(X(X(!OverheatProtection))))",
      "kind": "liveness",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "CurrentTemperature 等于传感器读数、SetTempDisplay 等于设定温度、HeaterStatus 跟随 HeaterOutput；连续加热 5 个扫描周期触发过热保护（1 个扫描周期代表 1s，平台无 TIME 类型）。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    }
  ],
