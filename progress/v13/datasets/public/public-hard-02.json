  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "两条输送带任何时候都不得同时输出（方向互斥）。",
      "ltl": "G(!(conveyorLeft AND conveyorRight))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S2",
      "text": "空闲态（phase=0，尚未接到启动）时输送带必须静止。",
      "ltl": "G(phase = 0 -> !conveyorLeft AND !conveyorRight)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S3",
      "text": "停在工位等加工完成信号期间（phase=2）输送带必须静止，不得自动起步。",
      "ltl": "G(phase = 2 -> !conveyorLeft AND !conveyorRight)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S4",
      "text": "目标工位在当前工位右侧时，输送中必须输出正转。",
      "ltl": "G(phase = 1 AND dstStation > curStation -> conveyorRight)",
      "kind": "sequencing",
      "verified_by": "plcverif"
    },
    {
      "sid": "S5",
      "text": "目标工位在当前工位左侧时，输送中必须输出反转。",
      "ltl": "G(phase = 1 AND dstStation < curStation -> conveyorLeft)",
      "kind": "sequencing",
      "verified_by": "plcverif"
    },
    {
      "sid": "S6",
      "text": "每收到一次当前工位的加工完成信号，工序下标 idx 恰好加 1。",
      "ltl": "G(compEdge -> idx = prev(idx) + 1)",
      "kind": "sequencing",
      "verified_by": "plcverif"
    },
    {
      "sid": "S7",
      "text": "输送中且目标工位与当前工位不同时，必须至少有一条输送带在输出。",
      "ltl": "G(phase = 1 AND dstStation <> curStation -> conveyorLeft OR conveyorRight)",
      "kind": "safety",
      "verified_by": "plcverif"
    }
  ],
