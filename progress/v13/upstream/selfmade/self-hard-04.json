{
  "pid": "self-hard-04",
  "source": "selfmade",
  "difficulty": "hard",
  "title": "多泵均衡运行与主备切换（数组遍历与迟滞阈值）",
  "requirements": "写一个功能块 FB，管理 5 台并联泵的均衡运行。\n控制要求：\n1. demand 为工艺需求台数，**超出 0..5 时先按边界裁剪**（负数按 0、大于 5 按 5）；\n2. 需要运行的泵必须是 runHours 最小的若干台，以均衡磨损；\n3. leadPump 为主泵号、lagPump 为备用泵号，两者**必须是不同的泵**；需求 1 台时 lagPump = 0；需求 0 台时两者都为 0；\n4. runningCount 输出实际运行台数，必须严格等于裁剪后的需求；\n5. **迟滞要求**：rotated 为维护逻辑下发的**轮换请求（输入）**；仅当待选泵的运行小时数比当前主泵少超过 50 小时时才允许切换，否则即使收到请求也保持原主备；无请求时永不切换；\n6. 数组下标必须按题面 1..5 访问，不得把 0 号槽用掉。",
  "variables": [
    {
      "name": "demand",
      "data_type": "INT",
      "description": "需求泵台数 0..5（超出请先按边界裁剪）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "runHours",
      "data_type": "ARRAY[1..5] OF LINT",
      "description": "各泵累计运行小时数（只读）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "leadPump",
      "data_type": "INT",
      "description": "当前主泵号 1..5，0 表示尚未选定",
      "direction": "output",
      "fields": []
    },
    {
      "name": "lagPump",
      "data_type": "INT",
      "description": "当前备用泵号 1..5，0 表示无",
      "direction": "output",
      "fields": []
    },
    {
      "name": "runningCount",
      "data_type": "INT",
      "description": "实际运行泵台数",
      "direction": "output",
      "fields": []
    },
    {
      "name": "rotated",
      "data_type": "BOOL",
      "description": "本周期存在轮换请求（输入，由维护逻辑置位）",
      "direction": "input",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "运行台数必须等于裁剪后的需求值（需求先收敛到 0..5）。",
      "ltl": "G(demand >= 0 & demand <= 5 -> runningCount = demand)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S2",
      "text": "主备泵必须是不同的泵（备泵为 0 表示只有一台）。",
      "ltl": "G(lagPump <> 0 -> leadPump <> lagPump)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S3",
      "text": "收到轮换请求时，主备切换仅在两泵运行小时差超过阈值 50 时发生（涉及内部排序表，只在用例中校验）。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    },
    {
      "sid": "S4",
      "text": "需求为 0 时不得有任何泵处于选中状态（当周期即成立）。",
      "ltl": "G(demand <= 0 -> leadPump = 0 & lagPump = 0)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S5",
      "text": "需求为 0 时运行台数必须为 0。",
      "ltl": "G(demand <= 0 -> runningCount = 0)",
      "kind": "safety",
      "verified_by": "plcverif"
    }
  ],
  "test_cases": [
    {
      "tc_id": "p1",
      "inputs": {
        "demand": 0
      },
      "expected": {
        "leadPump": 0,
        "lagPump": 0,
        "runningCount": 0
      },
      "note": "无需求：全停",
      "const_inputs": {
        "runHours": [
          100,
          200,
          300,
          400,
          500
        ],
        "rotated": false
      },
      "init": {},
      "mode": "",
      "cycles": 1,
      "expect_full": false
    },
    {
