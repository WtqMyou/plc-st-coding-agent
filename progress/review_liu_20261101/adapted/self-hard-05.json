{
  "pid": "self-hard-05",
  "source": "selfmade",
  "difficulty": "hard",
  "title": "燃烧状态与氧量修正联锁（熄火跳闸 + 分析仪故障降级）",
  "requirements": "写一个功能块 FB，实现燃烧器的火焰联锁与烟气氧量修正。\n控制要求：\n1. 运行请求 runRequest 为 TRUE 且火焰探测器 flameOK 为 FALSE 时，**当拍**置位熄火跳闸 tripLatched，并切断燃料许可；\n2. tripLatched 自保持，只有在 runRequest=FALSE 且 flameOK=FALSE 的前提下，resetBtn 的**上升沿**才能清除；\n3. fuelPermit = runRequest AND flameOK AND NOT tripLatched；\n4. 氧量修正：trimEnable = fuelPermit AND NOT o2Fault；trimmer = 2.0 * (2.0 - o2PV)，并钳位到 [-10, +10]；trimEnable=FALSE 时 airTrim 必须为 0.0；\n5. o2Fault = NOT o2Valid OR o2PV < 0.0 OR o2PV > 21.0（分析仪故障只切除修正，**不得**切除燃料）；\n6. airCommand = baseAir + airTrim，钳位到 [0, 100]；fuelPermit=FALSE 时 airCommand 必须为 0.0。",
  "variables": [
    {
      "name": "runRequest",
      "data_type": "BOOL",
      "description": "燃烧运行请求",
      "direction": "input",
      "fields": []
    },
    {
      "name": "flameOK",
      "data_type": "BOOL",
      "description": "火焰探测器反馈（TRUE=检测到火焰）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "o2Valid",
      "data_type": "BOOL",
      "description": "氧量分析仪数据有效",
      "direction": "input",
      "fields": []
    },
    {
      "name": "o2PV",
      "data_type": "REAL",
      "description": "烟气含氧量测量值（%）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "baseAir",
      "data_type": "REAL",
      "description": "主风门基础开度给定（%）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "resetBtn",
      "data_type": "BOOL",
      "description": "复位按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "fuelPermit",
      "data_type": "BOOL",
      "description": "燃料允许（联锁输出）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "trimEnable",
      "data_type": "BOOL",
      "description": "氧量修正投入（无故障才为 TRUE）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "airTrim",
      "data_type": "REAL",
      "description": "氧量修正偏置（%），钳位 ±10",
      "direction": "output",
      "fields": []
    },
    {
      "name": "airCommand",
      "data_type": "REAL",
      "description": "风门开度命令（%），钳位 0..100",
      "direction": "output",
      "fields": []
    },
    {
      "name": "tripLatched",
      "data_type": "BOOL",
      "description": "熄火跳闸自保持",
      "direction": "output",
      "fields": []
    },
    {
      "name": "o2Fault",
      "data_type": "BOOL",
      "description": "氧量分析仪故障（无效或越界）",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "运行中失去火焰时，**同一周期**就必须跳闸（不得延迟一拍）。",
      "ltl": "G((runRequest & !flameOK) -> tripLatched)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "跳闸一旦置位就自保持，只能由复位上升沿清除。",
      "ltl": "G((prev(tripLatched) & !rising(resetBtn) & (flameOK | runRequest)) -> tripLatched)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "跳闸状态下绝不允许燃料许可。",
      "ltl": "G(tripLatched -> !fuelPermit)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "无运行请求时不得给出燃料许可。",
      "ltl": "G(fuelPermit -> runRequest)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "无燃料许可时风门命令必须归零（防止停机后残留开度）。",
      "ltl": "G(!fuelPermit -> airCommand = 0.0)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "风门命令恒在 0..100 之间。",
      "ltl": "G((airCommand >= 0.0) & (airCommand <= 100.0))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S7",
      "text": "氧量修正偏置恒在 ±10 之间。",
      "ltl": "G((airTrim >= -10.0) & (airTrim <= 10.0))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S8",
      "text": "氧量分析仪故障当拍必须切除修正。",
      "ltl": "G(o2Fault -> (trimEnable = FALSE & airTrim = 0.0))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S9",
      "text": "故障判据：数据无效或超出 0..21 量程。",
      "ltl": "G(o2Fault <-> (!o2Valid | o2PV < 0.0 | o2PV > 21.0))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S10",
      "text": "修正系数与钳位后的合成值。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    }
  ],
