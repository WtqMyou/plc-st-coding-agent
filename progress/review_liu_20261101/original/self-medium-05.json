      "init": {},
      "mode": "sequence",
      "cycles": 1,
      "expect_full": false
    },
    {
      "tc_id": "q7",
      "inputs": {
        "enable": true,
        "resetBtn": false,
        "dt": 11.0,
        "steamFlow": 20.0,
