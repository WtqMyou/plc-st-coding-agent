{
  "pid": "self-medium-04",
  "source": "selfmade",
  "difficulty": "medium",
  "title": "定量灌装阀控制（浮点累计与计数去抖）",
  "requirements": "写一个功能块 FB，控制一条定量灌装工位。\n控制要求：\n1. startBtn 的上升沿开始一瓶的灌装：valveOpen 置 TRUE，并把内部累计体积清零；\n2. 每个扫描周期把 flowVol 累加到内部体积；**累计值达到或超过** targetVol 时立即关阀；\n3. 关阀后等待 doneSensor 为 TRUE，确认该瓶装满；\n4. **只有确认之后** fillsToday 才加 1；阀未确认就再次启动不得重复计数；\n5. 正在灌装过程中 startBtn 再次按下无效（不重新开始，也不重复计数）；\n6. resetBtn 的上升沿把 fillsToday 清零，并关闭灌装阀、清除内部累计。\n待确认时若接收下一瓶的新启动沿，取消上一瓶的待确认；新瓶的阀仍开时不得给旧瓶记账。计数边界（F1.3 明确的教学约定）：fillsToday 沿用有符号 INT。达到 32767 后确认新瓶仍正常完成灌装握手，计数保持 32767，禁止回绕到负数。合法复位沿清零，下一瓶确认后重新从 1 计数。",
  "variables": [
    {
      "name": "startBtn",
      "data_type": "BOOL",
      "description": "启动按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "resetBtn",
      "data_type": "BOOL",
      "description": "复位按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "doneSensor",
      "data_type": "BOOL",
      "description": "满瓶检测传感器",
      "direction": "input",
      "fields": []
    },
    {
      "name": "targetVol",
      "data_type": "REAL",
      "description": "目标灌装体积 mL",
      "direction": "input",
      "fields": []
    },
    {
      "name": "flowVol",
      "data_type": "REAL",
      "description": "本周期累计流量增量 mL",
      "direction": "input",
      "fields": []
    },
    {
      "name": "valveOpen",
      "data_type": "BOOL",
      "description": "灌装阀开命令",
      "direction": "output",
      "fields": []
    },
    {
      "name": "fillsToday",
      "data_type": "INT",
      "description": "今日完成瓶数",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "复位按钮上升沿必须在**当周期**把今日计数清零。",
      "ltl": "G(rising(resetBtn) -> fillsToday = 0)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "阀门本拍由关变开时，本拍必须有启动按钮上升沿；上电前阀门关闭。",
      "ltl": "G(rising(valveOpen) -> rising(startBtn))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "除复位那一拍外，计数单调不减（不得回退）。",
      "ltl": "G(!rising(resetBtn) -> fillsToday >= prev(fillsToday))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "每拍计数最多增加 1（不得因阀抖动重复计数）。",
      "ltl": "G(fillsToday <= prev(fillsToday) + 1)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "计数只发生在满瓶确认之后：计数增加的那一拍 doneSensor 必须为真。",
      "ltl": "G(fillsToday > prev(fillsToday) -> doneSensor)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "累计流量达到目标体积后，灌装阀必须在当周期关闭（涉及内部累计量，只在用例中校验）。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    },
    {
      "sid": "S7",
      "kind": "safety",
      "text": "复位沿优先，关阀并归零。",
      "ltl": "G(rising(resetBtn) -> !valveOpen)",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S8",
      "kind": "safety",
      "text": "新瓶启动拍即计入流量，未达标开阀、达标当拍关阀。",
      "ltl": "G((!rising(resetBtn) AND rising(startBtn) AND !prev(valveOpen)) -> (valveOpen <-> flowVol < targetVol))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S9",
      "kind": "safety",
      "text": "运行中本拍无新增流量且目标不变，保持开阀。",
      "ltl": "G((!rising(resetBtn) AND prev(valveOpen) AND flowVol = 0.0 AND targetVol = prev(targetVol)) -> valveOpen)",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S10",
      "kind": "safety",
      "text": "非复位关阀且关阀拍尚未确认，下一拍没有复位或新启动而确认时，未饱和计数加一。",
      "ltl": "G((prev(falling(valveOpen) AND !rising(resetBtn) AND !doneSensor) AND !rising(resetBtn) AND !rising(startBtn) AND doneSensor AND !prev(fillsToday = 32767)) -> fillsToday = prev(fillsToday) + 1)",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S11",
      "kind": "safety",
      "text": "复位已清除待确认标志；其后未新启动时，确认信号不能计瓶。",
      "ltl": "G((prev(rising(resetBtn)) AND !rising(resetBtn) AND !rising(startBtn)) -> fillsToday = prev(fillsToday))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S12",
      "kind": "safety",
      "text": "首次启动贡献至少半个目标体积，下一拍无复位且不倒流仍开阀；第三拍再次启动且补入至少另一半时，须按原累计关阀。",
      "ltl": "G((prev(prev(rising(startBtn) AND !prev(valveOpen) AND !rising(resetBtn) AND valveOpen AND flowVol + flowVol >= targetVol)) AND prev(!startBtn AND !rising(resetBtn) AND valveOpen AND flowVol >= 0.0 AND targetVol = prev(targetVol)) AND rising(startBtn) AND !rising(resetBtn) AND targetVol = prev(targetVol) AND flowVol + flowVol >= targetVol) -> !valveOpen)",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S13",
      "kind": "safety",
      "text": "本拍结束时新瓶仍在开阀灌装，确认信号不能给上一瓶计数。",
      "ltl": "G((!rising(resetBtn) AND valveOpen) -> fillsToday = prev(fillsToday))",
      "verified_by": "bounded_checker"
    }
  ],
