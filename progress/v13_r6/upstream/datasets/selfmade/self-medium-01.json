  "provenance": {
    "source_record": "sources/index.json#self-medium-01",
    "historical_origin": "流程行业多产品罐装线按配方切换：赛题里常见'配方号 + 比例和 + 工艺温度'三元组，需要操作员选槽位后校验再投产。",
    "historical_review": "人工审核：所有边界（99.0 / 101.0 / 30.0 / 180.0）都写成闭区间并各有正反两个用例；槽位越界单独成用例 c7。",
    "historical_source_type": "自主构思 / 行业经验改编",
    "historical_adaptation": "把配方库简化为固定 8 槽数组，把'组分比例和必须为 100%'变成带容差的闭区间判定，从而把浮点边界与数组下标两类易错点放在同一题里。",
    "source_type": "自建教学题",
    "attribution": "上游自述为行业场景启发；缺少可独立核验的外部题号或标准条款。",
    "independent_process_review": "包内未见可核验的逐题独立签署"
  },
