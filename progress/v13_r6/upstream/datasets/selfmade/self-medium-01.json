{
  "pid": "self-medium-01",
  "source": "selfmade",
  "difficulty": "medium",
  "title": "配料配方装载与校验（数组越界与浮点区间）",
  "requirements": "写一个功能块 FB，从配方库中按槽位装载配方并校验。\n控制要求：\n1. recipe 是 8 个槽位的配方数组，槽位 recipeID = 0 表示空槽；\n2. selSlot 是操作员选中的槽位，合法范围 1..8；**越界时必须判为非法，不得访问数组外**；\n3. loadCmd 的**上升沿**触发一次装载；按住不放不得重复装载；\n4. 校验规则（**全部满足**才算 valid）：槽位非空；totalRatio 在 99.0..101.0 之间（含端点）；temperature 在 30.0..180.0 之间（含端点）；\n5. 校验通过时 valid := TRUE 且 loadedID 更新为该槽位的 recipeID；校验失败时 valid := FALSE 且 loadedID 归 0；\n6. running 为 TRUE 表示正在生产，此时装载命令无效，loadedID 保持原值。",
  "variables": [
    {
      "name": "recipe",
      "data_type": "ARRAY[1..8] OF ST_Recipe",
      "description": "配方槽位 1..8，槽位 recipeID=0 表示空",
      "direction": "input",
      "fields": [
        {
          "name": "recipeID",
          "data_type": "INT",
          "description": "配方号，0 表示空槽",
          "direction": "input",
          "fields": []
        },
        {
          "name": "totalRatio",
          "data_type": "REAL",
          "description": "配方总比例，合法 99.0..101.0",
          "direction": "input",
          "fields": []
        },
        {
          "name": "temperature",
          "data_type": "REAL",
          "description": "工艺温度，合法 30.0..180.0",
          "direction": "input",
          "fields": []
        }
      ]
    },
    {
      "name": "selSlot",
      "data_type": "INT",
      "description": "操作员选中的槽位，合法范围 1..8",
      "direction": "input",
      "fields": []
    },
    {
      "name": "loadCmd",
      "data_type": "BOOL",
      "description": "装载命令（上升沿触发一次装载）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "running",
      "data_type": "BOOL",
      "description": "当前是否处于生产状态",
      "direction": "input",
      "fields": []
    },
    {
      "name": "valid",
      "data_type": "BOOL",
      "description": "配方校验通过",
      "direction": "output",
      "fields": []
    },
    {
      "name": "loadedID",
      "data_type": "INT",
      "description": "已装载的配方号，无配方时为 0",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "选中的槽位为空（recipeID = 0）时，装载必须判为非法，且不得改变已装载的 loadedID。",
      "ltl": "G(!running & rising(loadCmd) & (selSlot >= 1) & (selSlot <= 8) & (recipe[selSlot].recipeID = 0) -> !valid)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "总配比越界（totalRatio < 99 或 > 101）时装载必须判为非法。",
      "ltl": "G(!running & rising(loadCmd) & (selSlot >= 1) & (selSlot <= 8) & (recipe[selSlot].totalRatio < 99.0) -> !valid)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "温度越界（temperature < 30 或 > 180）时装载必须判为非法。",
      "ltl": "G(!running & rising(loadCmd) & (selSlot >= 1) & (selSlot <= 8) & (recipe[selSlot].temperature > 180.0) -> !valid)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "本拍处于生产状态时，loadedID 保持上一拍的值，包括刚进入生产的第一拍。",
      "ltl": "G(running -> loadedID = prev(loadedID))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "槽位越界（selSlot < 1 或 > 8）时必须判为非法，不得访问数组外内存。",
      "ltl": "G(!running & rising(loadCmd) & ((selSlot < 1) | (selSlot > 8)) -> !valid)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "装载命令只在上升沿生效，电平保持期间不得重复装载。",
      "ltl": "G(loadCmd & prev(loadCmd) -> loadedID = prev(loadedID))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S7",
      "kind": "safety",
      "text": "接收装载沿且下标合法时，有效位等价于槽非空、配比和温度均在闭区间。",
      "ltl": "G((!running AND rising(loadCmd) AND selSlot >= 1 AND selSlot <= 8) -> (valid <-> (recipe[selSlot].recipeID <> 0 AND recipe[selSlot].totalRatio >= 99.0 AND recipe[selSlot].totalRatio <= 101.0 AND recipe[selSlot].temperature >= 30.0 AND recipe[selSlot].temperature <= 180.0)))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S8",
      "kind": "safety",
      "text": "有效装载回传选中槽的实际编号；无效装载清零编号。",
      "ltl": "G((!running AND rising(loadCmd)) -> ((!valid -> loadedID = 0) AND ((valid AND selSlot >= 1 AND selSlot <= 8) -> loadedID = recipe[selSlot].recipeID)))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S9",
      "kind": "safety",
      "text": "没有接受装载沿时，ID 和有效位都保持上拍。",
      "ltl": "G((running OR !rising(loadCmd)) -> ((valid <-> prev(valid)) AND loadedID = prev(loadedID)))",
      "verified_by": "bounded_checker"
    }
  ],
