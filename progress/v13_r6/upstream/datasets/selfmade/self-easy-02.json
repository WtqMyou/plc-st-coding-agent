  "provenance": {
    "source_record": "sources/index.json#self-easy-02",
    "historical_origin": "罐区液位联锁是流程行业自动化赛项的基础题型，涉及带迟滞的报警、报警自保持、上升沿复位与'停止优先'四件事。",
    "historical_review": "人工审核：边界值用 >= / <= 明确写死，避免 LLM 用 >/< 产生 off-by-one；复位必须按边沿而非常电平，这一条最容易被写错，故单独设规约 S2。",
    "historical_source_type": "自主构思 / 行业经验改编",
    "historical_adaptation": "把赛题中的多罐切换简化为单罐，保留边界值（85.0/15.0）与报警优先的语义，使它成为可独立测试的最小单元。",
    "source_type": "自建教学题",
    "attribution": "上游自述为行业场景启发；缺少可独立核验的外部题号或标准条款。",
    "independent_process_review": "包内未见可核验的逐题独立签署"
  },
