{
  "pid": "self-easy-02",
  "source": "selfmade",
  "difficulty": "easy",
  "title": "储罐高低液位联锁与报警自保持",
  "requirements": "实现储罐进料联锁功能块 FB。每拍采样液位、进料许可和复位按钮；所有输出在同一拍结束时判定。初始两个报警和上一拍按钮均为 FALSE。\n1. tankLevel >= 85.0 是高液位危险条件，tankLevel <= 15.0 是低液位危险条件。每个报警在各自条件成立时立即置位并锁存。回到正常区本身不清除报警。\n2. resetBtn 从 FALSE 变为 TRUE 的那一拍，分别检查每个报警：危险条件已消失才清除，条件仍成立则保持置位。两项均可同时锁存；复位只能清除已安全的那一项。危险条件刚出现的同一拍按下复位，危险条件仍优先。\n3. 按住复位跨越液位变化不产生新复位；需先松手再按。首次扫描前按钮按 FALSE 处理。\n4. 本拍更新报警后，只有 inletPermit 为 TRUE 且两个报警均为 FALSE 才运行进料泵 pumpRun。出口阀 outletValveOpen 在低报警锁存期间关闭，其他情况下开启。outletFlow 是预留观测接口，本题不按流量设动作阈值。",
  "variables": [
    {
      "name": "tankLevel",
      "data_type": "REAL",
      "description": "储罐液位百分比 0..100",
      "direction": "input",
      "fields": []
    },
    {
      "name": "outletFlow",
      "data_type": "REAL",
      "description": "出口流量 m³/h",
      "direction": "input",
      "fields": []
    },
    {
      "name": "inletPermit",
      "data_type": "BOOL",
      "description": "进料许可（工艺联锁允许进料）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "resetBtn",
      "data_type": "BOOL",
      "description": "复位按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "pumpRun",
      "data_type": "BOOL",
      "description": "进料泵运行命令",
      "direction": "output",
      "fields": []
    },
    {
      "name": "alarmHigh",
      "data_type": "BOOL",
      "description": "高液位报警（自保持，需复位）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "alarmLow",
      "data_type": "BOOL",
      "description": "低液位报警（自保持，需复位）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "outletValveOpen",
      "data_type": "BOOL",
      "description": "出口阀开命令",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "达到或超过高阈值，当拍报警；复位与越限同拍仍报警。",
      "ltl": "G(tankLevel >= 85.0 -> alarmHigh)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "已脱离高阈值时，高报警等于上拍锁存且本拍没有复位沿。",
      "ltl": "G(tankLevel < 85.0 -> (alarmHigh <-> (prev(alarmHigh) AND !rising(resetBtn))))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "高或低报警任一有效，当拍禁止运行进料泵。",
      "ltl": "G((alarmHigh OR alarmLow) -> !pumpRun)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "阀开命令与低报警互反，包括复位拍。",
      "ltl": "G(outletValveOpen <-> !alarmLow)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "两报警均清除时，进料泵命令等于本拍进料许可。",
      "ltl": "G((!alarmHigh AND !alarmLow) -> (pumpRun <-> inletPermit))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "达到或低于低阈值即置位低报警；危险消失前复位无效，之后需新的复位沿清除。",
      "ltl": "G(alarmLow <-> ((tankLevel <= 15.0) OR (prev(alarmLow) AND !rising(resetBtn))))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    }
  ],
