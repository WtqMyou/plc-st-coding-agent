{
  "pid": "self-medium-02",
  "source": "selfmade",
  "difficulty": "medium",
  "title": "模拟量滑动平均滤波（窗口未满与 FIFO 淘汰）",
  "requirements": "写一个功能块 FB，对模拟量采样值做 8 点滑动平均滤波。\n控制要求：\n1. 每个扫描周期，若 enable 为 TRUE，把 rawValue 压入长度为 8 的环形缓冲区，并用缓冲区内**实际已有**的样本计算算术平均，输出到 filteredValue；\n2. 缓冲区**未填满时不得用 0 填充**：只有 3 个样本时就是这 3 个的平均；\n3. 缓冲区填满后，每来一个新样本挤掉最老的一个（先进先出）；\n4. sampleCount 输出当前缓冲区内的有效样本数（0..8）；\n5. 当样本数达到 8 时 windowFull 置 TRUE，之后保持 TRUE；\n6. enable 为 FALSE 时清空缓冲区（sampleCount 归 0、windowFull 归 FALSE），但 filteredValue 保持上一次的计算结果不变。\n每个新启用时段独立计数；同一时段第 8 个样本首次置满，第 9 个样本开始淘汰最老值。停用时清零计数和满标志，保持末次均值。",
  "variables": [
    {
      "name": "enable",
      "data_type": "BOOL",
      "description": "滤波使能，FALSE 时清空历史",
      "direction": "input",
      "fields": []
    },
    {
      "name": "rawValue",
      "data_type": "REAL",
      "description": "本周期原始采样值",
      "direction": "input",
      "fields": []
    },
    {
      "name": "filteredValue",
      "data_type": "REAL",
      "description": "滤波输出",
      "direction": "output",
      "fields": []
    },
    {
      "name": "windowFull",
      "data_type": "BOOL",
      "description": "历史窗口已填满 8 个样本后置 TRUE",
      "direction": "output",
      "fields": []
    },
    {
      "name": "sampleCount",
      "data_type": "INT",
      "description": "当前窗口内有效样本数 0..8",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "输出等于最近最多 8 个有效样本的均值；满窗后按先入先出淘汰最老值，以连续样本序列检查第 8、9 拍。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    },
    {
      "sid": "S2",
      "text": "windowFull 当且仅当本周期结束后已有 8 个样本。",
      "ltl": "G(windowFull <-> sampleCount = 8)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "enable 拉低后，sampleCount 必须在**当周期**归零，窗口同时退出满载。",
      "ltl": "G(!enable -> sampleCount = 0 & !windowFull)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "样本数在 0..8 之间；使能时按拍增加至 8，已满时保持 8。",
      "ltl": "G((sampleCount >= 0 AND sampleCount <= 8) AND (enable AND prev(sampleCount < 8) -> sampleCount = prev(sampleCount) + 1) AND (enable AND prev(sampleCount = 8) -> sampleCount = 8))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "kind": "safety",
      "text": "停用当拍与持续停用均保持上次输出，不随新的 rawValue 变化。",
      "ltl": "G(!enable -> filteredValue = prev(filteredValue))",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "kind": "safety",
      "text": "新启用时段的第一个样本直接输出原值。",
      "ltl": "G((enable AND sampleCount = 1) -> filteredValue = rawValue)",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S7",
      "kind": "safety",
      "text": "连续第二个样本输出两个有效样本的算术平均。",
      "ltl": "G((enable AND sampleCount = 2) -> filteredValue = (prev(rawValue) + rawValue) / 2.0)",
      "verified_by": "bounded_checker"
    }
  ],
