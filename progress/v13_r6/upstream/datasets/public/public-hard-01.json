  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "当急停触发（estop=FALSE）时，阀 A/B/C/D 与混合电机必须全部停止",
      "ltl": "G(estop = FALSE -> (valveARun = FALSE AND valveBRun = FALSE AND valveCRun = FALSE AND valveDRun = FALSE AND mixMotorRun = FALSE))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "自动模式下阀 A、B、C 两两不得同时运行（进料同一时刻只有一个）",
      "ltl": "G(opeMode = TRUE -> (NOT (valveARun = TRUE AND valveBRun = TRUE) AND NOT (valveARun = TRUE AND valveCRun = TRUE) AND NOT (valveBRun = TRUE AND valveCRun = TRUE)))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "自动模式下阀 D 运行时，阀 A/B/C 与混合电机必须停止（出料与前序设备互斥）",
      "ltl": "G(opeMode = TRUE AND valveDRun = TRUE -> (valveARun = FALSE AND valveBRun = FALSE AND valveCRun = FALSE AND mixMotorRun = FALSE))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "自动模式下混合电机运行时，阀 A/B/C 必须关闭",
      "ltl": "G(opeMode = TRUE AND mixMotorRun = TRUE -> (valveARun = FALSE AND valveBRun = FALSE AND valveCRun = FALSE))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "上一拍处于自动搅拌，本拍仍为自动且无急停时，完成信号有效则当拍停电机并开 D 阀。",
      "ltl": "G(prev(opeMode) AND prev(mixMotorRun) AND opeMode AND estop AND mixMotorComplete -> (NOT mixMotorRun AND valveDRun))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "手动按钮的边沿翻转记忆、换模式与急停时的复位、自动步序的推进顺序：由用例验证的时序/数据性质",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    },
    {
      "sid": "S7",
      "text": "从上电或连续急停已解除的手动拍开始，五个按钮分别只在上升沿翻转对应输出。",
      "ltl": "G(((estop AND NOT opeMode AND (NOT prev(TRUE) OR prev(estop AND NOT opeMode))) -> ((valveARun <-> NOT (rising(valveAStart) <-> prev(valveARun))) AND (valveBRun <-> NOT (rising(valveBStart) <-> prev(valveBRun))) AND (valveCRun <-> NOT (rising(valveCStart) <-> prev(valveCRun))) AND (valveDRun <-> NOT (rising(valveDStart) <-> prev(valveDRun))) AND (mixMotorRun <-> NOT (rising(mixMotorStart) <-> prev(mixMotorRun))))))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S8",
      "text": "自动模式空闲时，启动沿首先开启 A 阀。",
      "ltl": "G(((opeMode AND estop AND rising(autoStart) AND (NOT prev(opeMode) OR prev((NOT valveARun AND NOT valveBRun AND NOT valveCRun AND NOT valveDRun AND NOT mixMotorRun)))) -> valveARun))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S9",
      "text": "自动A 转 B：上拍原设备已开，液位小于 50 时保持，达到阈值时切换。",
      "ltl": "G((((estop AND opeMode AND prev(opeMode)) AND prev(valveARun)) -> ((levelSensor < 50 -> valveARun) AND (levelSensor >= 50 -> (NOT valveARun AND valveBRun)))))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S10",
      "text": "自动B 转 C 或混合：上拍原设备已开，液位小于 80 时保持，达到阈值时切换。",
      "ltl": "G((((estop AND opeMode AND prev(opeMode)) AND prev(valveBRun)) -> ((levelSensor < 80 -> valveBRun) AND (levelSensor >= 80 -> (NOT valveBRun AND ((valveCRun <-> processMode) AND (mixMotorRun <-> NOT processMode)))))))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S11",
      "text": "自动C 转混合：上拍原设备已开，液位小于 100 时保持，达到阈值时切换。",
      "ltl": "G((((estop AND opeMode AND prev(opeMode)) AND prev(valveCRun)) -> ((levelSensor < 100 -> valveCRun) AND (levelSensor >= 100 -> (NOT valveCRun AND mixMotorRun)))))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S12",
      "text": "自动混合中，完成信号到来以前保持混合。",
      "ltl": "G((((estop AND opeMode AND prev(opeMode)) AND prev(mixMotorRun) AND NOT mixMotorComplete) -> mixMotorRun))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S13",
      "text": "上电或处于自动空闲时，没有新启动沿应保持五路设备全停。",
      "kind": "safety",
      "verified_by": "bounded_checker",
      "ltl": "G((opeMode AND estop AND (NOT prev(opeMode) OR prev((NOT valveARun AND NOT valveBRun AND NOT valveCRun AND NOT valveDRun AND NOT mixMotorRun))) AND NOT rising(autoStart)) -> (NOT valveARun AND NOT valveBRun AND NOT valveCRun AND NOT valveDRun AND NOT mixMotorRun))"
    },
    {
      "sid": "S14",
      "text": "上电起的前四拍中，从未发出自动或手动启动信号时，不得因模式切换、急停或解除而凭空启动设备。",
      "kind": "safety",
      "verified_by": "bounded_checker",
      "ltl": "G((NOT prev(prev(prev(prev(TRUE)))) AND NOT (valveAStart OR valveBStart OR valveCStart OR valveDStart OR mixMotorStart OR autoStart) AND NOT prev((valveAStart OR valveBStart OR valveCStart OR valveDStart OR mixMotorStart OR autoStart)) AND NOT prev(prev((valveAStart OR valveBStart OR valveCStart OR valveDStart OR mixMotorStart OR autoStart))) AND NOT prev(prev(prev((valveAStart OR valveBStart OR valveCStart OR valveDStart OR mixMotorStart OR autoStart))))) -> (NOT valveARun AND NOT valveBRun AND NOT valveCRun AND NOT valveDRun AND NOT mixMotorRun))"
    }
  ],
