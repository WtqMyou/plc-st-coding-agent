{
  "pid": "public-easy-06",
  "source": "public",
  "difficulty": "easy",
  "title": "Aeration Blower Delayed Start",
  "requirements": "Control a wastewater-treatment aeration blower with a low-dissolved-oxygen demand, a 5-second start delay, emergency-stop priority and start-cycle counting.\n\n1. Start delay timing when both DO_LOW and AERATION_E_STOP_NC are TRUE. Allow BLOWER_RUN to become TRUE only after these conditions have remained satisfied for 5 seconds.\n2. If DO_LOW becomes FALSE or an emergency stop occurs, immediately disable BLOWER_RUN and reset the start timer, whether timing is incomplete or complete. A new demand must wait the full 5 seconds again.\n3. Increment AERATION_BLOWER_CYCLE_COUNT once on each FALSE-to-TRUE transition of BLOWER_RUN. Do not count repeatedly during continuous operation.\n4. At power-up, initialize the blower to OFF and the start count to zero. The start delay gates a BOOL enable; no continuous speed ramp is required.",
  "variables": [
    {
      "name": "DO_LOW",
      "data_type": "BOOL",
      "description": "Dissolved oxygen is below its threshold and aeration is needed.",
      "direction": "input",
      "fields": []
    },
    {
      "name": "AERATION_E_STOP_NC",
      "data_type": "BOOL",
      "description": "TRUE means the emergency stop is inactive; FALSE means it is active.",
      "direction": "input",
      "fields": []
    },
    {
      "name": "BLOWER_RUN",
      "data_type": "BOOL",
      "description": "Blower motor-contactor run command.",
      "direction": "output",
      "fields": []
    },
    {
      "name": "AERATION_BLOWER_CYCLE_COUNT",
      "data_type": "UINT",
      "description": "Count of actual blower starts.",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "当急停按下（AERATION_E_STOP_NC=FALSE）时，鼓风机运行命令必须为 FALSE。",
      "ltl": "G(NOT AERATION_E_STOP_NC -> NOT BLOWER_RUN)",
      "kind": "safety",
      "verified_by": "timed_simulation"
    },
    {
      "sid": "S2",
      "text": "当低氧需求为 FALSE 时，鼓风机运行命令必须为 FALSE。",
      "ltl": "G(NOT DO_LOW -> NOT BLOWER_RUN)",
      "kind": "safety",
      "verified_by": "timed_simulation"
    },
    {
      "sid": "S3",
      "text": "鼓风机连续运行期间（本拍与上一拍都在运行）启动计数不得增加。",
      "ltl": "G(BLOWER_RUN AND prev(BLOWER_RUN) -> AERATION_BLOWER_CYCLE_COUNT = prev(AERATION_BLOWER_CYCLE_COUNT))",
      "kind": "sequencing",
      "verified_by": "timed_simulation"
    },
    {
      "sid": "S4",
      "text": "同时满足低氧需求和急停释放连续满5秒才启动，中断后重新等待。按4999/5000毫秒及不等周期执行。",
      "ltl": "",
      "kind": "data",
      "verified_by": "timed_simulation"
    },
    {
      "sid": "S6",
      "text": "可表示范围内每次启动沿计一次，其他拍保持计数。原题未约定65535后再次启动的溢出处理。",
      "ltl": "G(((rising(BLOWER_RUN) AND NOT prev(AERATION_BLOWER_CYCLE_COUNT = 65535)) -> AERATION_BLOWER_CYCLE_COUNT = prev(AERATION_BLOWER_CYCLE_COUNT) + 1) AND (NOT rising(BLOWER_RUN) -> AERATION_BLOWER_CYCLE_COUNT = prev(AERATION_BLOWER_CYCLE_COUNT)))",
      "kind": "safety",
      "verified_by": "timed_simulation"
    }
  ],
