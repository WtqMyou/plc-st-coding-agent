{
  "pid": "self-easy-02",
  "source": "selfmade",
  "difficulty": "easy",
  "title": "储罐高低液位联锁与报警自保持",
  "requirements": "写一个功能块 FB，实现储罐的进料联锁。\n控制要求：\n1. tankLevel 低于 85.0 且不低于 15.0、inletPermit 为 TRUE、且当前无高液位报警时，pumpRun 置 TRUE，outletValveOpen 置 TRUE；\n2. tankLevel **达到或超过** 85.0 时，alarmHigh 置 TRUE（自保持），并立即停止进料泵；\n3. tankLevel **达到或低于** 15.0 时，alarmLow 置 TRUE（自保持），并关闭出口阀；\n4. resetBtn 的**上升沿**同时清除两个报警；按住不放只算一次复位；\n5. 报警存在期间，即使按下复位按钮，复位也不生效（报警优先）；\n6. 所有报警清除、条件满足后，系统自动恢复运行，不需要重新上电。",
  "variables": [
    {
      "name": "tankLevel",
      "data_type": "REAL",
      "description": "储罐液位百分比 0..100",
      "direction": "input",
      "fields": []
    },
    {
      "name": "outletFlow",
      "data_type": "REAL",
      "description": "出口流量 m³/h",
      "direction": "input",
      "fields": []
    },
    {
      "name": "inletPermit",
      "data_type": "BOOL",
      "description": "进料许可（工艺联锁允许进料）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "resetBtn",
      "data_type": "BOOL",
      "description": "复位按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "pumpRun",
      "data_type": "BOOL",
      "description": "进料泵运行命令",
      "direction": "output",
      "fields": []
    },
    {
      "name": "alarmHigh",
      "data_type": "BOOL",
      "description": "高液位报警（自保持，需复位）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "alarmLow",
      "data_type": "BOOL",
      "description": "低液位报警（自保持，需复位）",
      "direction": "output",
      "fields": []
    },
    {
      "name": "outletValveOpen",
      "data_type": "BOOL",
      "description": "出口阀开命令",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "液位不低于 85.0 时，高液位报警必须在当周期置位。",
      "ltl": "G(tankLevel >= 85.0 & !rising(resetBtn) -> alarmHigh)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "高液位报警置位后，在复位按钮上升沿出现之前必须保持。",
      "ltl": "G(alarmHigh & !X(rising(resetBtn)) -> X(alarmHigh))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "高液位报警有效期间，进料泵不得运行（停止优先于启动）。",
      "ltl": "G(alarmHigh -> !pumpRun)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "液位不高于 15.0 时，出口阀必须在当周期关闭。",
      "ltl": "G(tankLevel <= 15.0 -> !outletValveOpen)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "无进料许可时，进料泵不得运行。",
      "ltl": "G(!inletPermit -> !pumpRun)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    }
  ],
  "test_cases": [
