{
  "pid": "self-medium-04",
  "source": "selfmade",
  "difficulty": "medium",
  "title": "定量灌装阀控制（浮点累计与计数去抖）",
  "requirements": "写一个功能块 FB，控制一条定量灌装工位。\n控制要求：\n1. startBtn 的上升沿开始一瓶的灌装：valveOpen 置 TRUE，并把内部累计体积清零；\n2. 每个扫描周期把 flowVol 累加到内部体积；**累计值达到或超过** targetVol 时立即关阀；\n3. 关阀后等待 doneSensor 为 TRUE，确认该瓶装满；\n4. **只有确认之后** fillsToday 才加 1；阀未确认就再次启动不得重复计数；\n5. 正在灌装过程中 startBtn 再次按下无效（不重新开始，也不重复计数）；\n6. resetBtn 的上升沿把 fillsToday 清零，并关闭灌装阀、清除内部累计。",
  "variables": [
    {
      "name": "startBtn",
      "data_type": "BOOL",
      "description": "启动按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "resetBtn",
      "data_type": "BOOL",
      "description": "复位按钮（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "doneSensor",
      "data_type": "BOOL",
      "description": "满瓶检测传感器",
      "direction": "input",
      "fields": []
    },
    {
      "name": "targetVol",
      "data_type": "REAL",
      "description": "目标灌装体积 mL",
      "direction": "input",
      "fields": []
    },
    {
      "name": "flowVol",
      "data_type": "REAL",
      "description": "本周期累计流量增量 mL",
      "direction": "input",
      "fields": []
    },
    {
      "name": "valveOpen",
      "data_type": "BOOL",
      "description": "灌装阀开命令",
      "direction": "output",
      "fields": []
    },
    {
      "name": "fillsToday",
      "data_type": "INT",
      "description": "今日完成瓶数",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "复位按钮上升沿必须在**当周期**把今日计数清零。",
      "ltl": "G(rising(resetBtn) -> fillsToday = 0)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "开阀只允许发生在启动按钮的上升沿：阀从关到开的那一拍必须有新按下。",
      "ltl": "G(!valveOpen & X(valveOpen) -> X(rising(startBtn)))",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "除复位那一拍外，计数单调不减（不得回退）。",
      "ltl": "G(!rising(resetBtn) -> fillsToday >= prev(fillsToday))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S6",
      "text": "每拍计数最多增加 1（不得因阀抖动重复计数）。",
      "ltl": "G(fillsToday <= prev(fillsToday) + 1)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "计数只发生在满瓶确认之后：计数增加的那一拍 doneSensor 必须为真。",
      "ltl": "G(fillsToday > prev(fillsToday) -> doneSensor)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "累计流量达到目标体积后，灌装阀必须在当周期关闭（涉及内部累计量，只在用例中校验）。",
      "ltl": "",
      "kind": "data",
      "verified_by": "simulation"
    }
  ],
  "test_cases": [
