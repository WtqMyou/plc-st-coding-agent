  "provenance": {
    "r9_spec_policy": {
      "observer": "process",
      "changes": [
        {
          "sid": "S2",
          "original_ltl": "G(phase = 0 -> !conveyorLeft AND !conveyorRight)",
          "original_text": "空闲态（phase=0，尚未接到启动）时输送带必须静止。",
          "original_verified_by": "plcverif"
        },
        {
          "sid": "S3",
          "original_ltl": "G(phase = 2 -> !conveyorLeft AND !conveyorRight)",
          "original_text": "停在工位等加工完成信号期间（phase=2）输送带必须静止，不得自动起步。",
          "original_verified_by": "plcverif"
        },
        {
          "sid": "S4",
          "original_ltl": "G(phase = 1 AND dstStation > curStation -> conveyorRight)",
          "original_text": "目标工位在当前工位右侧时，输送中必须输出正转。",
          "original_verified_by": "plcverif"
        },
        {
          "sid": "S5",
          "original_ltl": "G(phase = 1 AND dstStation < curStation -> conveyorLeft)",
          "original_text": "目标工位在当前工位左侧时，输送中必须输出反转。",
          "original_verified_by": "plcverif"
        },
        {
