{
  "pid": "self-hard-02",
  "source": "selfmade",
  "difficulty": "hard",
  "title": "批次工艺阶段与运行时长统计（无外部时钟）",
  "requirements": "写一个功能块 FB，管理一个间歇反应釜的批次生命周期。\n控制要求：\n1. startBtn 的上升沿开始一个新批次：phase := 1，elapsed := 0，timeout := FALSE；\n2. phase = 1（升温）时，每个扫描周期 elapsed 加 1；当 pv **达到或超过** setpoint 时进入 phase = 2（保温）；\n3. phase = 2（保温）时，elapsed 继续每周期加 1，直到操作员按确认或超时；\n4. **超时判定**：elapsed 达到 maxDuration 时 timeout 置 TRUE，并进入 phase = 3（完成）；\n5. **中止按钮优先级最高**：任何阶段按下 abortBtn 都立即进入 phase = 9，且 elapsed 停止累加；\n6. 进入中止态后不得自动恢复，必须重新按 startBtn 并在新批次中清零一切状态；\n7. **不得使用任何系统时钟**（无 TIME/TON 等计时器），时长只能来自扫描周期计数。",
  "variables": [
    {
      "name": "startBtn",
      "data_type": "BOOL",
      "description": "批次开始（上升沿有效）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "abortBtn",
      "data_type": "BOOL",
      "description": "中止按钮（直接中止批次）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "setpoint",
      "data_type": "REAL",
      "description": "工艺设定值",
      "direction": "input",
      "fields": []
    },
    {
      "name": "pv",
      "data_type": "REAL",
      "description": "过程测量值",
      "direction": "input",
      "fields": []
    },
    {
      "name": "maxDuration",
      "data_type": "INT",
      "description": "本批次允许的最长持续时间（秒）",
      "direction": "input",
      "fields": []
    },
    {
      "name": "elapsed",
      "data_type": "INT",
      "description": "已运行秒数",
      "direction": "output",
      "fields": []
    },
    {
      "name": "phase",
      "data_type": "INT",
      "description": "阶段号：0=空闲 1=升温 2=保温 3=完成 9=已中止",
      "direction": "output",
      "fields": []
    },
    {
      "name": "timeout",
      "data_type": "BOOL",
      "description": "超时标志",
      "direction": "output",
      "fields": []
    }
  ],
  "target_pou": "FUNCTION_BLOCK",
  "specs": [
    {
      "sid": "S1",
      "text": "批次的秒数只在运行阶段（phase 1/2）每周期恰好增加 1，重新开始的那一拍例外（要清零）。",
      "ltl": "G((phase = 1 | phase = 2) & !rising(startBtn) -> elapsed = prev(elapsed) + 1)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S2",
      "text": "已运行秒数达到最长持续时间后，timeout 必须在当拍置 TRUE。",
      "ltl": "G(elapsed >= maxDuration & !rising(startBtn) -> timeout)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S3",
      "text": "中止按钮优先级最高：按下即进入中止态（同一拍生效）。",
      "ltl": "G(abortBtn & !rising(startBtn) -> phase = 9)",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S4",
      "text": "进入中止态后不得自动离开，除非出现新的启动上升沿。",
      "ltl": "G(phase = 9 & !X(rising(startBtn)) -> X(phase = 9))",
      "kind": "safety",
      "verified_by": "bounded_checker"
    },
    {
      "sid": "S5",
      "text": "重新开始时 elapsed 与 timeout 必须在同一拍清零/复位。",
      "ltl": "G(rising(startBtn) -> elapsed = 0 & !timeout & phase = 1)",
      "kind": "sequencing",
      "verified_by": "bounded_checker"
    }
  ],
  "test_cases": [
