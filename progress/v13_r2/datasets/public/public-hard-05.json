  "specs": [
    {
      "sid": "S1",
      "text": "同一条轴上的两个相反动作永远不会同时输出。",
      "ltl": "G(NOT (MoveDown AND MoveUp))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S2",
      "text": "左右两个相反动作永远不会同时输出。",
      "ltl": "G(NOT (MoveLeft AND MoveRight))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S3",
      "text": "抓取与释放永远不会同时输出。",
      "ltl": "G(NOT (ActivateGrip AND ActivateRelease))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S4",
      "text": "急停（EmergencyStop=FALSE）时六个动作输出全部为 0，压过任何模式与按钮。",
      "ltl": "G(NOT EmergencyStop -> (NOT MoveDown AND NOT MoveUp AND NOT MoveLeft AND NOT MoveRight AND NOT ActivateGrip AND NOT ActivateRelease))",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S5",
      "text": "手动模式下动作只能由对应按钮驱动（下行动作必须 DownButton 有效）。",
      "ltl": "G(ManualMode AND MoveDown -> DownButton)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S6",
      "text": "手动模式下已到位的方向不能再输出动作（到位即停）。",
      "ltl": "G(ManualMode AND DownLimitSwitch -> NOT MoveDown)",
      "kind": "safety",
      "verified_by": "plcverif"
    },
    {
      "sid": "S7",
      "text": "三种自动模式的预置程序顺序（下→抓→上→右→下→放→上→左，单步逐次确认、单循环跑完一轮停下、连续到第 8 步后环回第 1 步）、模式切换即停、急停冻结后从同一步恢复，均由 32 条用例逐拍验证（这些性质涉及程序步计数，用规约表达会退化成对内部实现细节的约束，故用仿真覆盖）。",
      "ltl": "",
      "kind": "sequencing",
      "verified_by": "simulation"
    }
  ],
