  "provenance": {
    "source_type": "自主构思 / 行业经验改编",
    "origin": "流程行业赛题里物料缓冲、成品暂存常用于吸收上下游节拍差异，赛题中常要求 FIFO 队列；环形缓冲的满/空判定是经典易错点。",
    "adaptation": "把赛题中随管线运行的输送队列固化为 8 槽缓冲区，并强制要求每周期整理成紧凑数组（下标 1 为最老），这排除了只写读写指针的偷懒实现，考察真实数据搬移。",
    "review": "人工审核：满/空边界、同周期双向操作、计数不得为负三项均有独立用例；'先出队再入队'的顺序在题面明确，避免歧义。",
    "interface_resolution": "原始 input 原样留档；运行平台适配统一为 inout，与参考解和调用方可写存储一致。",
    "review_revision": "v1.3-review-r2"
  },
