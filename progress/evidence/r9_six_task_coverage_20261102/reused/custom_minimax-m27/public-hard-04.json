    "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue   : BOOL;\n    dequeue   : BOOL;\n    reset     : BOOL;\n    capacity  : DINT;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT;\n    status       : WORD;\nEND_VAR\nVAR_IN_OUT\n    item   : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\nVAR\n    head         : DINT := 1;\n    tail         : DINT := 1;\n    count        : DINT := 0;\n    enqueuePrev  : BOOL := FALSE;\n    dequeuePrev  : BOOL := FALSE;\n    enqueueRising: BOOL;\n    dequeueRising: BOOL;\nEND_VAR\n\n(* Reset handling – highest priority *)\nIF reset THEN\n    count      := 0;\n    head       := 1;\n    tail       := 1;\n    status     := 16#0000;\n\n    (* Store current input state to avoid spurious edges after reset *)\n    enqueuePrev := enqueue;\n    dequeuePrev := dequeue;\nELSE\n    (* Rising‑edge detection *)\n    enqueueRising := enqueue AND NOT enqueuePrev;\n    dequeueRising := dequeue AND NOT dequeuePrev;\n\n    (* Enqueue request *)\n    IF enqueueRising THEN\n        IF count < capacity THEN\n            buffer[tail] := item;\n            tail := tail + 1;\n            IF tail > capacity THEN\n                tail := 1;\n            END_IF;\n            count := count + 1;\n            status := 16#0000;\n        ELSE\n            (* Queue full – reject *)\n            status := 16#8002;\n        END_IF\n\n    (* Dequeue request *)\n    ELSIF dequeueRising THEN\n        IF count > 0 THEN\n            item := buffer[head];\n            head := head + 1;\n            IF head > capacity THEN\n                head := 1;\n            END_IF;\n            count := count - 1;\n            status := 16#0000;\n        ELSE\n            (* Queue empty – reject *)\n            status := 16#8001;\n        END_IF\n    ELSE\n        (* Idle – no request *)\n        status := 16#0000;\n    END_IF\n\n    (* Update edge‑history for next scan *)\n    enqueuePrev := enqueue;\n    dequeuePrev := dequeue;\nEND_IF\n\n(* Expose current fill level *)\nelementCount := count;\n\nEND_FUNCTION_BLOCK",
