    "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL := FALSE;\n    motorDown  : BOOL := FALSE;\n    errorFlag  : BOOL := FALSE;\nEND_VAR\nVAR\n    currentState : INT := 0; (* 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT *)\n    prevOpenBtn  : BOOL := FALSE;\n    prevCloseBtn : BOOL := FALSE;\nEND_VAR\n\n    // Edge detection\n    IF openBtn AND NOT prevOpenBtn THEN\n        prevOpenBtn := openBtn;\n        IF currentState = 0 AND NOT openLimit THEN\n            currentState := 1;\n        END_IF\n    ELSIF NOT openBtn THEN\n        prevOpenBtn := FALSE;\n    END_IF\n\n    IF closeBtn AND NOT prevCloseBtn THEN\n        prevCloseBtn := closeBtn;\n        IF currentState = 0 AND NOT closeLimit THEN\n            currentState := 2;\n        END_IF\n    ELSIF NOT closeBtn THEN\n        prevCloseBtn := FALSE;\n    END_IF\n\n    // State machine\n    CASE currentState OF\n        3: // FAULT\n            motorUp   := FALSE;\n            motorDown := FALSE;\n            IF openBtn AND closeBtn THEN\n                errorFlag  := FALSE;\n                currentState := 0;\n            END_IF\n\n        0: // IDLE\n            motorUp   := FALSE;\n            motorDown := FALSE;\n\n        1: // OPENING\n            motorUp   := TRUE;\n            motorDown := FALSE;\n            IF openLimit THEN\n                motorUp   := FALSE;\n                currentState := 0;\n            ELSIF obstacle THEN\n                motorUp   := FALSE;\n                errorFlag  := TRUE;\n                currentState := 3;\n            END_IF\n\n        2: // CLOSING\n            motorUp   := FALSE;\n            motorDown := TRUE;\n            IF obstacle THEN\n                motorDown  := FALSE;\n                currentState := 1;\n            ELSIF closeLimit THEN\n                motorDown  := FALSE;\n                currentState := 0;\n            END_IF\n    END_CASE\nEND_FUNCTION_BLOCK",
