      "code": "TYPE ST_Recipe : STRUCT\n    recipeID   : INT;\n    totalRatio : REAL;\n    temperature: REAL;\nEND_STRUCT\nEND_TYPE\n\nFUNCTION_BLOCK FB\nVAR_INPUT\n    recipe   : ARRAY[1..8] OF ST_Recipe;\n    selSlot  : INT;\n    loadCmd  : BOOL;\n    running  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    valid    : BOOL;\n    loadedID : INT;\nEND_VAR\nVAR\n    prevLoadCmd  : BOOL;\n    curLoadedID : INT;\n    curValid    : BOOL;\n    curRecipe   : ST_Recipe;\nEND_VAR\n\n// Detect rising edge of load command\nIF loadCmd AND NOT prevLoadCmd THEN\n    // Rising edge – process only when not running\n    IF NOT running THEN\n        // Slot bounds check\n        IF (selSlot >= 1) AND (selSlot <= 8) THEN\n            curRecipe := recipe[selSlot];\n            // Validation: non‑empty slot, totalRatio in 99..101, temperature in 30..180\n            IF (curRecipe.recipeID <> 0) AND\n               (curRecipe.totalRatio >= 99.0) AND (curRecipe.totalRatio <= 101.0) AND\n               (curRecipe.temperature >= 30.0) AND (curRecipe.temperature <= 180.0) THEN\n                curLoadedID := curRecipe.recipeID;\n                curValid    := TRUE;\n            ELSE\n                curLoadedID := 0;\n                curValid    := FALSE;\n            END_IF\n        ELSE\n            // Out‑of‑range slot – illegal\n            curLoadedID := 0;\n            curValid    := FALSE;\n        END_IF\n    END_IF\nEND_IF\n\n// Drive outputs\nloadedID := curLoadedID;\nvalid    := curValid;\n\n// Update edge‑detection memory\nprevLoadCmd := loadCmd;\nEND_FUNCTION_BLOCK",
