      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest      : BOOL;\n    pressure        : REAL;\n    pressureValid   : BOOL;\n    fuelFlow        : REAL;\n    steamFlow       : REAL;\n    outletCmd       : INT;\n    outletFeedback  : INT;\n    resetBtn        : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    tripLatched        : BOOL;\n    fuelPermit         : BOOL;\n    currentCauseMask   : WORD;\n    latchedCauseMask   : WORD;\n    diagnosticActive   : BOOL;\nEND_VAR\n\nVAR\n    prevResetBtn        : BOOL;\n    tripLatchedInternal : BOOL;\n    latchedCauseMaskInt : WORD;\n    valveStuckCounter   : INT;\n    resetRising         : BOOL;\n    bit0                : BOOL;\n    bit1                : BOOL;\n    bit2                : BOOL;\n    bit3                : BOOL;\nEND_VAR\n\n(* Detect rising edge of reset button *)\nresetRising := resetBtn AND NOT prevResetBtn;\n\n(* Valve‑stuck detection – count consecutive scans meeting the criteria *)\nIF runRequest AND pressureValid AND (pressure >= 4500.0) AND (outletCmd >= 50) AND (outletFeedback <= 10) THEN\n    valveStuckCounter := valveStuckCounter + 1;\nELSE\n    valveStuckCounter := 0;\nEND_IF\n\n(* Compute cause‑bit mask *)\nIF NOT runRequest THEN\n    currentCauseMask := 0;\n    bit0 := FALSE;\n    bit1 := FALSE;\n    bit2 := FALSE;\n    bit3 := FALSE;\nELSE\n    bit0 := NOT pressureValid;\n    bit1 := (valveStuckCounter >= 3);\n    bit2 := (pressureValid AND (pressure >= 4500.0) AND (fuelFlow >= 4.0) AND (steamFlow <= 10.0));\n    bit3 := (pressureValid AND (pressure >= 4500.0) AND NOT bit0 AND NOT bit1 AND NOT bit2);\n    currentCauseMask := 0;\n    IF bit0 THEN currentCauseMask := currentCauseMask OR WORD#1; END_IF;\n    IF bit1 THEN currentCauseMask := currentCauseMask OR WORD#2; END_IF;\n    IF bit2 THEN currentCauseMask := currentCauseMask OR WORD#4; END_IF;\n    IF bit3 THEN currentCauseMask := currentCauseMask OR WORD#8; END_IF;\nEND_IF\n\n(* Trip‑latch logic *)\nIF resetRising AND NOT runRequest AND pressureValid AND (pressure <= 4200.0) THEN\n    tripLatchedInternal := FALSE;\nELSIF runRequest AND ((pressureValid AND (pressure >= 4500.0)) OR (NOT pressureValid)) THEN\n    tripLatchedInternal := TRUE;\nEND_IF\n\n(* Fuel permit *)\nfuelPermit := runRequest AND NOT tripLatchedInternal;\n\n(* Accumulate latched cause mask while the latch is active, clear on reset *)\nIF tripLatchedInternal THEN\n    latchedCauseMaskInt := latchedCauseMaskInt OR currentCauseMask;\nELSE\n    latchedCauseMaskInt := 0;\nEND_IF\n\n(* Diagnostic active flag *)\ndiagnosticActive := (currentCauseMask <> 0);\n\n(* Assign outputs *)\ntripLatched   := tripLatchedInternal;\nlatchedCauseMask := latchedCauseMaskInt;\n\n(* Update button history for edge detection *)\nprevResetBtn := resetBtn;\n\nEND_FUNCTION_BLOCK",
