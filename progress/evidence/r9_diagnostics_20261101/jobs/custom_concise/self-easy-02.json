      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    tankLevel    : REAL;\n    outletFlow   : REAL;\n    inletPermit  : BOOL;\n    resetBtn     : BOOL;\nEND_VAR\nVAR_OUTPUT\n    pumpRun         : BOOL;\n    alarmHigh       : BOOL;\n    alarmLow        : BOOL;\n    outletValveOpen : BOOL;\nEND_VAR\nVAR\n    prevResetBtn    : BOOL;\n    risingResetEdge : BOOL;\nEND_VAR\n\nrisingResetEdge := resetBtn AND NOT prevResetBtn;\nprevResetBtn := resetBtn;\n\nIF tankLevel >= 85.0 THEN\n    alarmHigh := TRUE;\nEND_IF\n\nIF tankLevel <= 15.0 THEN\n    alarmLow := TRUE;\nEND_IF\n\nIF risingResetEdge THEN\n    IF tankLevel < 85.0 AND alarmHigh THEN\n        alarmHigh := FALSE;\n    END_IF\n    IF tankLevel > 15.0 AND alarmLow THEN\n        alarmLow := FALSE;\n    END_IF\nEND_IF\n\nIF alarmHigh THEN\n    pumpRun := FALSE;\nELSIF inletPermit AND tankLevel > 15.0 AND tankLevel < 85.0 THEN\n    pumpRun := TRUE;\nELSE\n    pumpRun := FALSE;\nEND_IF\n\nIF alarmLow THEN\n    outletValveOpen := FALSE;\nELSIF tankLevel > 15.0 THEN\n    outletValveOpen := TRUE;\nELSE\n    outletValveOpen := FALSE;\nEND_IF\n\nEND_FUNCTION_BLOCK",
