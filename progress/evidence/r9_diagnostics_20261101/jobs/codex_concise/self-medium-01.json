      "code": "TYPE ST_Recipe :\nSTRUCT\n    recipeID     : INT;\n    totalRatio   : REAL;\n    temperature  : REAL;\nEND_STRUCT\nEND_TYPE\n\nFUNCTION_BLOCK FB\nVAR_INPUT\n    recipe   : ARRAY[1..8] OF ST_Recipe;\n    selSlot  : INT;\n    loadCmd  : BOOL;\n    running  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    valid    : BOOL;\n    loadedID : INT := 0;\nEND_VAR\nVAR\n    prevLoadCmd  : BOOL := FALSE;\n    prevRunning  : BOOL := FALSE;\nEND_VAR\n\nIF loadCmd AND NOT prevLoadCmd AND NOT prevRunning THEN\n    IF selSlot >= 1 AND selSlot <= 8 THEN\n        IF recipe[selSlot].recipeID <> 0 THEN\n            IF recipe[selSlot].totalRatio >= 99.0 AND recipe[selSlot].totalRatio <= 101.0 THEN\n                IF recipe[selSlot].temperature >= 30.0 AND recipe[selSlot].temperature <= 180.0 THEN\n                    valid := TRUE;\n                    loadedID := recipe[selSlot].recipeID;\n                ELSE\n                    valid := FALSE;\n                    loadedID := 0;\n                END_IF\n            ELSE\n                valid := FALSE;\n                loadedID := 0;\n            END_IF\n        ELSE\n            valid := FALSE;\n            loadedID := 0;\n        END_IF\n    ELSE\n        valid := FALSE;\n        loadedID := 0;\n    END_IF\nEND_IF\n\nprevLoadCmd := loadCmd;\nprevRunning := running;\nEND_FUNCTION_BLOCK",
