      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    tankLevel    : REAL;\n    outletFlow   : REAL;\n    inletPermit  : BOOL;\n    resetBtn     : BOOL;\nEND_VAR\nVAR_OUTPUT\n    pumpRun          : BOOL;\n    alarmHigh        : BOOL;\n    alarmLow         : BOOL;\n    outletValveOpen  : BOOL;\nEND_VAR\nVAR\n    resetBtnPrev : BOOL := FALSE;\nEND_VAR\n\n(* High level alarm: latches when level >= 85.0 *)\nIF tankLevel >= 85.0 THEN\n    alarmHigh := TRUE;\nEND_IF\n\n(* Low level alarm: latches when level <= 15.0 *)\nIF tankLevel <= 15.0 THEN\n    alarmLow := TRUE;\nEND_IF\n\n(* Rising edge detection for reset *)\nIF resetBtn AND NOT resetBtnPrev THEN\n    (* Reset only effective when alarm conditions are cleared *)\n    IF tankLevel < 85.0 AND tankLevel > 15.0 THEN\n        alarmHigh := FALSE;\n        alarmLow  := FALSE;\n    END_IF\nEND_IF\nresetBtnPrev := resetBtn;\n\n(* Output control: pump runs when permitted, no high alarm, level below threshold *)\npumpRun := inletPermit AND NOT alarmHigh AND (tankLevel < 85.0);\n\n(* Outlet valve: opens when permitted, no high alarm, no low alarm, level above low threshold *)\noutletValveOpen := inletPermit AND NOT alarmHigh AND NOT alarmLow AND (tankLevel > 15.0);\n\nEND_FUNCTION_BLOCK",
