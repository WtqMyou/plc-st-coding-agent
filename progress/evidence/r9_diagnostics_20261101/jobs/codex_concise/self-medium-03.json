      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL;\n    motorDown  : BOOL;\n    errorFlag  : BOOL;\nEND_VAR\nVAR\n    state           : INT;  // 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT\n    prevOpenBtn     : BOOL;\n    prevCloseBtn    : BOOL;\n    inFault         : BOOL;\n    faultCleared    : BOOL;\n    openRisingEdge  : BOOL;\n    closeRisingEdge : BOOL;\nEND_VAR\n\nopenRisingEdge  := openBtn AND NOT prevOpenBtn;\ncloseRisingEdge := closeBtn AND NOT prevCloseBtn;\nprevOpenBtn  := openBtn;\nprevCloseBtn := closeBtn;\n\nCASE state OF\n    0:  // IDLE\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        IF openRisingEdge AND NOT openLimit AND NOT inFault THEN\n            state := 1;\n        ELSIF closeRisingEdge AND NOT closeLimit AND NOT inFault THEN\n            state := 2;\n        END_IF\n\n    1:  // OPENING\n        motorUp   := TRUE;\n        motorDown := FALSE;\n        IF openLimit THEN\n            state := 0;\n        ELSIF obstacle THEN\n            motorUp      := FALSE;\n            inFault      := TRUE;\n            faultCleared := FALSE;\n            state        := 3;\n        END_IF\n\n    2:  // CLOSING\n        motorUp   := FALSE;\n        motorDown := NOT obstacle;\n        IF closeLimit THEN\n            state := 0;\n        ELSIF obstacle THEN\n            motorDown := FALSE;\n            state     := 1;\n        END_IF\n\n    3:  // FAULT\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        errorFlag := TRUE;\n        IF openBtn AND closeBtn THEN\n            errorFlag    := FALSE;\n            inFault      := FALSE;\n            faultCleared := TRUE;\n            state        := 0;\n        END_IF\nEND_CASE\n\nIF motorUp AND motorDown THEN\n    motorDown := FALSE;\nEND_IF\n\nEND_FUNCTION_BLOCK",
