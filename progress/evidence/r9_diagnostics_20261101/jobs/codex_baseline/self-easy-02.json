      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    tankLevel   : REAL;\n    outletFlow  : REAL;\n    inletPermit : BOOL;\n    resetBtn    : BOOL;\nEND_VAR\nVAR_OUTPUT\n    pumpRun         : BOOL;\n    alarmHigh       : BOOL;\n    alarmLow        : BOOL;\n    outletValveOpen : BOOL;\nEND_VAR\nVAR\n    resetRisingEdge : BOOL := FALSE;\n    prevResetBtn    : BOOL := FALSE;\n    highCondition   : BOOL := FALSE;\n    lowCondition    : BOOL := FALSE;\nEND_VAR\n\n    // 边沿检测：复位按钮上升沿\n    resetRisingEdge := resetBtn AND NOT prevResetBtn;\n    prevResetBtn    := resetBtn;\n\n    // 当前液位是否触发报警条件\n    highCondition := (tankLevel >= 85.0);\n    lowCondition  := (tankLevel <= 15.0);\n\n    // 报警自保持：报警条件存在时置位，条件解除后等待复位上升沿清除\n    IF highCondition THEN\n        alarmHigh := TRUE;\n    ELSIF resetRisingEdge AND NOT highCondition THEN\n        alarmHigh := FALSE;\n    END_IF\n\n    IF lowCondition THEN\n        alarmLow := TRUE;\n    ELSIF resetRisingEdge AND NOT lowCondition THEN\n        alarmLow := FALSE;\n    END_IF\n\n    // 泵控制：高液位报警时立即停止，否则在许可且液位安全时运行\n    pumpRun := NOT alarmHigh AND inletPermit AND (tankLevel > 15.0);\n\n    // 出口阀：低液位报警时关闭，无报警时开启\n    outletValveOpen := NOT alarmLow;\n\nEND_FUNCTION_BLOCK",
