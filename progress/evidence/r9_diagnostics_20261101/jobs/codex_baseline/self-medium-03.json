      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn   : BOOL;\n    closeBtn  : BOOL;\n    openLimit : BOOL;\n    closeLimit: BOOL;\n    obstacle  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp   : BOOL;\n    motorDown : BOOL;\n    errorFlag : BOOL;\nEND_VAR\nVAR\n    state       : INT;  // 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT\n    prevOpenBtn : BOOL;\n    prevCloseBtn: BOOL;\nEND_VAR\n\n// Edge detection for buttons\nVAR\n    openRising  : BOOL;\n    closeRising : BOOL;\nEND_VAR\n\nopenRising  := openBtn AND NOT prevOpenBtn;\ncloseRising := closeBtn AND NOT prevCloseBtn;\n\n// Save button states for next cycle\nprevOpenBtn  := openBtn;\nprevCloseBtn := closeBtn;\n\n// Default: motor outputs off\nmotorUp   := FALSE;\nmotorDown := FALSE;\n\n// State machine\nCASE state OF\n    // IDLE state\n    0:  // IDLE\n        IF openRising AND NOT openLimit THEN\n            state := 1;  // Enter OPENING\n        ELSIF closeRising AND NOT closeLimit THEN\n            state := 2;  // Enter CLOSING\n        END_IF\n\n    // OPENING state\n    1:  // OPENING\n        motorUp := TRUE;\n        IF openLimit THEN\n            state := 0;  // Back to IDLE\n            motorUp := FALSE;\n        ELSIF obstacle THEN\n            state := 3;  // Enter FAULT\n            motorUp := FALSE;\n        END_IF\n\n    // CLOSING state\n    2:  // CLOSING\n        motorDown := TRUE;\n        IF closeLimit THEN\n            state := 0;  // Back to IDLE\n            motorDown := FALSE;\n        ELSIF obstacle THEN\n            state := 1;  // Reverse to OPENING\n            motorDown := FALSE;\n        END_IF\n\n    // FAULT state\n    3:  // FAULT\n        errorFlag := TRUE;\n        IF openBtn AND closeBtn THEN\n            state := 0;\n            errorFlag := FALSE;\n        END_IF\n\nEND_CASE\n\nEND_FUNCTION_BLOCK",
