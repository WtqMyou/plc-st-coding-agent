      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue  : BOOL;\n    dequeue  : BOOL;\n    reset    : BOOL;\n    capacity : DINT;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT := 0;\n    status       : WORD := 16#0000;\nEND_VAR\nVAR_IN_OUT\n    item   : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\nVAR\n    head        : DINT := 1;\n    tail        : DINT := 1;\n    prevEnqueue : BOOL := FALSE;\n    prevDequeue : BOOL := FALSE;\nEND_VAR\n\n// Rising edge on reset?\nIF reset THEN\n    // Reset takes priority: empty the queue immediately\n    elementCount := 0;\n    head := 1;\n    tail := 1;\n    status := 16#0000;\n    \n    // Update edge history even on reset\n    prevEnqueue := enqueue;\n    prevDequeue := dequeue;\n    RETURN;\nEND_IF\n\n// Rising edge on enqueue?\nIF enqueue AND NOT prevEnqueue THEN\n    IF elementCount < capacity THEN\n        buffer[tail] := item;\n        \n        // Advance tail with wraparound\n        IF tail >= capacity THEN\n            tail := 1;\n        ELSE\n            tail := tail + 1;\n        END_IF\n        \n        elementCount := elementCount + 1;\n        status := 16#0000;\n    ELSE\n        // Queue full\n        status := 16#8002;\n    END_IF\nEND_IF\n\n// Rising edge on dequeue?\nIF dequeue AND NOT prevDequeue THEN\n    IF elementCount > 0 THEN\n        // Get front element\n        item := buffer[head];\n        \n        // Advance head with wraparound\n        IF head >= capacity THEN\n            head := 1;\n        ELSE\n            head := head + 1;\n        END_IF\n        \n        elementCount := elementCount - 1;\n        status := 16#0000;\n    ELSE\n        // Queue empty\n        status := 16#8001;\n    END_IF\nEND_IF\n\n// Update previous states for next scan\nprevEnqueue := enqueue;\nprevDequeue := dequeue;\nEND_FUNCTION_BLOCK",
