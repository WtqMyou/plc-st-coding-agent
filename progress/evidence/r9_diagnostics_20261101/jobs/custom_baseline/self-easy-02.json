      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    tankLevel    : REAL;\n    outletFlow   : REAL;\n    inletPermit  : BOOL;\n    resetBtn     : BOOL;\nEND_VAR\nVAR_OUTPUT\n    pumpRun          : BOOL;\n    alarmHigh        : BOOL;\n    alarmLow         : BOOL;\n    outletValveOpen  : BOOL;\nEND_VAR\nVAR\n    prevResetBtn   : BOOL := FALSE;\n    risingReset    : BOOL;\n    activeAlarmHigh : BOOL := FALSE;\n    activeAlarmLow  : BOOL := FALSE;\nEND_VAR\n\n    // 计算复位按钮上升沿\n    risingReset := resetBtn AND NOT prevResetBtn;\n\n    // 更新上一周期复位按钮状态\n    prevResetBtn := resetBtn;\n\n    // 高液位报警检测（自保持）\n    IF tankLevel >= 85.0 THEN\n        activeAlarmHigh := TRUE;\n    END_IF\n\n    // 低液位报警检测（自保持）\n    IF tankLevel <= 15.0 THEN\n        activeAlarmLow := TRUE;\n    END_IF\n\n    // 复位逻辑：仅当无报警时上升沿才生效\n    IF risingReset AND NOT activeAlarmHigh AND NOT activeAlarmLow THEN\n        activeAlarmHigh := FALSE;\n        activeAlarmLow  := FALSE;\n    END_IF\n\n    // 控制逻辑（报警优先）\n    // 高液位报警时立即停止进料泵\n    IF activeAlarmHigh THEN\n        pumpRun := FALSE;\n    ELSE\n        // 无高液位报警时：液位<85%、有进料许可、无低液位报警则启动泵\n        IF tankLevel < 85.0 AND inletPermit AND NOT activeAlarmLow THEN\n            pumpRun := TRUE;\n        ELSE\n            pumpRun := FALSE;\n        END_IF\n    END_IF\n\n    // 低液位报警时关闭出口阀\n    IF activeAlarmLow THEN\n        outletValveOpen := FALSE;\n    ELSE\n        // 无低液位报警时：液位>15%、无高液位报警则打开出口阀\n        IF tankLevel > 15.0 AND NOT activeAlarmHigh THEN\n            outletValveOpen := TRUE;\n        ELSE\n            outletValveOpen := FALSE;\n        END_IF\n    END_IF\n\n    // 输出报警状态\n    alarmHigh := activeAlarmHigh;\n    alarmLow  := activeAlarmLow;\nEND_FUNCTION_BLOCK",
