      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest      : BOOL;\n    pressure        : REAL;\n    pressureValid   : BOOL;\n    fuelFlow        : REAL;\n    steamFlow       : REAL;\n    outletCmd       : INT;\n    outletFeedback  : INT;\n    resetBtn        : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    tripLatched      : BOOL;\n    fuelPermit       : BOOL;\n    currentCauseMask : WORD;\n    latchedCauseMask : WORD;\n    diagnosticActive : BOOL;\nEND_VAR\n\nVAR\n    lastResetBtn     : BOOL;\n    consecStuckCount : INT;\n    resetRising      : BOOL;\n    tripCondition    : BOOL;\nEND_VAR\n\n(* Detect rising edge of reset button *)\nresetRising    := resetBtn AND NOT lastResetBtn;\nlastResetBtn   := resetBtn;\n\n(* Determine current diagnostic cause mask *)\nIF NOT runRequest THEN\n    currentCauseMask  := 0;\n    consecStuckCount  := 0;\nELSE\n    (* Bit0: pressure transmitter failure *)\n    IF NOT pressureValid THEN\n        currentCauseMask := WORD#1;            (* 1 << 0 *)\n    ELSE\n        currentCauseMask := WORD#0;\n    END_IF\n\n    (* Valve stuck detection (bit1) *)\n    IF runRequest AND pressureValid AND (pressure >= 4500.0)\n        AND (outletCmd >= 50) AND (outletFeedback <= 10) THEN\n        consecStuckCount := consecStuckCount + 1;\n    ELSE\n        consecStuckCount := 0;\n    END_IF\n\n    IF consecStuckCount >= 3 THEN\n        currentCauseMask := currentCauseMask OR WORD#2;   (* 1 << 1 *)\n    END_IF\n\n    (* Bit2: excess fuel (fuelFlow >= 4.0 and steamFlow <= 10.0) *)\n    IF (fuelFlow >= 4.0) AND (steamFlow <= 10.0) THEN\n        currentCauseMask := currentCauseMask OR WORD#4;   (* 1 << 2 *)\n    END_IF\n\n    (* Bit3: unidentified cause when overpressure but no other cause *)\n    IF pressureValid AND (pressure >= 4500.0) AND (currentCauseMask = WORD#0) THEN\n        currentCauseMask := currentCauseMask OR WORD#8;   (* 1 << 3 *)\n    END_IF\nEND_IF\n\n(* Trip condition: runRequest AND (pressureValid & overpressure OR pressureValid false) *)\ntripCondition := runRequest AND ( (pressureValid AND (pressure >= 4500.0)) OR (NOT pressureValid) );\n\n(* Set trip latch *)\nIF tripCondition THEN\n    tripLatched := TRUE;\nEND_IF\n\n(* Reset handling *)\nIF resetRising AND (NOT runRequest) AND pressureValid AND (pressure <= 4200.0) THEN\n    tripLatched      := FALSE;\n    latchedCauseMask := WORD#0;\n    consecStuckCount := 0;\nEND_IF\n\n(* Accumulate latched cause mask while trip is active *)\nIF tripLatched THEN\n    latchedCauseMask := latchedCauseMask OR currentCauseMask;\nEND_IF\n\n(* Fuel permit *)\nfuelPermit := runRequest AND NOT tripLatched;\n\n(* Diagnostic active flag *)\ndiagnosticActive := (currentCauseMask <> WORD#0);\nEND_FUNCTION_BLOCK",
