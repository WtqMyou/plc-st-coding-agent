      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue  : BOOL;\n    dequeue  : BOOL;\n    reset    : BOOL;\n    capacity : DINT;\nEND_VAR\n\nVAR_OUTPUT\n    elementCount : DINT;\n    status       : WORD;\nEND_VAR\n\nVAR_IN_OUT\n    item   : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\n\nVAR\n    head        : DINT := 1;\n    tail        : DINT := 1;\n    enqueueOld  : BOOL := FALSE;\n    dequeueOld  : BOOL := FALSE;\nEND_VAR\n\nVAR\n    enqueueRising : BOOL;\n    dequeueRising : BOOL;\nEND_VAR\n\n// Detect rising edges\nenqueueRising := enqueue AND NOT enqueueOld;\ndequeueRising := dequeue AND NOT dequeueOld;\n\n// Reset takes priority\nIF reset THEN\n    elementCount := 0;\n    head := 1;\n    tail := 1;\n    status := 16#0000;\n\n// Enqueue on rising edge\nELSIF enqueueRising THEN\n    IF elementCount < capacity THEN\n        buffer[tail] := item;\n        tail := (tail MOD capacity) + 1;\n        elementCount := elementCount + 1;\n        status := 16#0000;\n    ELSE\n        status := 16#8002;\n    END_IF;\n\n// Dequeue on rising edge\nELSIF dequeueRising THEN\n    IF elementCount > 0 THEN\n        item := buffer[head];\n        head := (head MOD capacity) + 1;\n        elementCount := elementCount - 1;\n        status := 16#0000;\n    ELSE\n        status := 16#8001;\n    END_IF;\n\n// Idle\nELSE\n    status := 16#0000;\nEND_IF;\n\n// Update edge detection history\nenqueueOld := enqueue;\ndequeueOld := dequeue;\n\nEND_FUNCTION_BLOCK",
