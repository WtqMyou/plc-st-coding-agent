      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn   : BOOL;\n    closeBtn  : BOOL;\n    openLimit : BOOL;\n    closeLimit: BOOL;\n    obstacle  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp   : BOOL := FALSE;\n    motorDown : BOOL := FALSE;\n    errorFlag : BOOL := FALSE;\nEND_VAR\nVAR\n    state       : INT := 0; // 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT\n    openBtnPrev : BOOL := FALSE;\n    closeBtnPrev: BOOL := FALSE;\nEND_VAR\n\n// 边沿检测\nVAR\n    openRising  : BOOL;\n    closeRising : BOOL;\nEND_VAR\nopenRising  := openBtn  AND NOT openBtnPrev;\ncloseRising := closeBtn AND NOT closeBtnPrev;\n\n// 更新历史\nopenBtnPrev  := openBtn;\ncloseBtnPrev := closeBtn;\n\n// 复位逻辑（FAULT期间需同时按下两按钮）\nIF state = 3 AND openBtn AND closeBtn THEN\n    state := 0;\n    errorFlag := FALSE;\nEND_IF\n\n// 状态机逻辑\nCASE state OF\n    0: // IDLE\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        IF openRising AND NOT openLimit THEN\n            state := 1; // → OPENING\n        ELSIF closeRising AND NOT closeLimit THEN\n            state := 2; // → CLOSING\n        END_IF\n\n    1: // OPENING\n        motorUp   := TRUE;\n        motorDown := FALSE;\n        IF openLimit THEN\n            state := 0; // 开到位，回IDLE\n        ELSIF obstacle THEN\n            motorUp   := FALSE;\n            errorFlag := TRUE;\n            state := 3; // 遇障，进入FAULT\n        END_IF\n\n    2: // CLOSING\n        motorUp   := FALSE;\n        motorDown := TRUE;\n        IF closeLimit THEN\n            state := 0; // 关到位，回IDLE\n        ELSIF obstacle THEN\n            motorDown := FALSE;\n            state := 1; // 遇障，立即反向开门\n        END_IF\n\n    3: // FAULT\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        // 锁存，不自动恢复\nEND_CASE\nEND_FUNCTION_BLOCK",
