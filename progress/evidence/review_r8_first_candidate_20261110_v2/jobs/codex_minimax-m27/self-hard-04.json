      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    demand        : INT;\n    runHours      : ARRAY[1..5] OF LINT;\n    rotated       : BOOL;\nEND_VAR\nVAR_OUTPUT\n    leadPump      : INT := 0;\n    lagPump       : INT := 0;\n    runningCount  : INT := 0;\nEND_VAR\nVAR\n    prevDemand        : INT := 0;\n    prevRunningCount  : INT := 0;\n    prevLeadPump      : INT := 0;\n    prevLagPump       : INT := 0;\n    hadValidLeadPump  : BOOL := FALSE;\n    minHours          : LINT;\n    minPumpIdx        : INT;\n    i                 : INT;\n    tempMinHours      : LINT;\n    tempMinPumpIdx    : INT;\n    needReselect      : BOOL;\nEND_VAR\n\nrunningCount := demand;\nIF demand < 0 THEN\n    runningCount := 0;\nELSIF demand > 5 THEN\n    runningCount := 5;\nEND_IF;\n\nIF runningCount = 0 THEN\n    leadPump := 0;\n    lagPump  := 0;\nELSE\n    IF (NOT hadValidLeadPump) OR (prevDemand = 0) THEN\n        minHours     := runHours[1];\n        minPumpIdx   := 1;\n        FOR i := 2 TO 5 DO\n            IF runHours[i] < minHours OR (runHours[i] = minHours AND i < minPumpIdx) THEN\n                minHours   := runHours[i];\n                minPumpIdx := i;\n            END_IF;\n        END_FOR;\n        leadPump := minPumpIdx;\n        IF runningCount >= 2 THEN\n            tempMinHours     := LINT#16#7FFFFFFFFFFFFFFF;\n            tempMinPumpIdx   := 0;\n            FOR i := 1 TO 5 DO\n                IF i <> leadPump THEN\n                    IF runHours[i] < tempMinHours OR (runHours[i] = tempMinHours AND i < tempMinPumpIdx) THEN\n                        tempMinHours   := runHours[i];\n                        tempMinPumpIdx := i;\n                    END_IF;\n                END_IF;\n            END_FOR;\n            lagPump := tempMinPumpIdx;\n        ELSE\n            lagPump := 0;\n        END_IF;\n    ELSIF rotated AND (runHours[prevLeadPump] - minHours > 50) THEN\n        leadPump := minPumpIdx;\n        IF runningCount >= 2 THEN\n            tempMinHours     := LINT#16#7FFFFFFFFFFFFFFF;\n            tempMinPumpIdx   := 0;\n            FOR i := 1 TO 5 DO\n                IF i <> leadPump THEN\n                    IF runHours[i] < tempMinHours OR (runHours[i] = tempMinHours AND i < tempMinPumpIdx) THEN\n                        tempMinHours   := runHours[i];\n                        tempMinPumpIdx := i;\n                    END_IF;\n                END_IF;\n            END_FOR;\n            lagPump := tempMinPumpIdx;\n        ELSE\n            lagPump := 0;\n        END_IF;\n    ELSE\n        IF runningCount > prevRunningCount THEN\n            needReselect := TRUE;\n        ELSE\n            needReselect := FALSE;\n        END_IF;\n        IF leadPump <> prevLeadPump THEN\n            tempMinHours     := LINT#16#7FFFFFFFFFFFFFFF;\n            tempMinPumpIdx   := 0;\n            FOR i := 1 TO 5 DO\n                IF i <> leadPump THEN\n                    IF runHours[i] < tempMinHours OR (runHours[i] = tempMinHours AND i < tempMinPumpIdx) THEN\n                        tempMinHours   := runHours[i];\n                        tempMinPumpIdx := i;\n                    END_IF;\n                END_IF;\n            END_FOR;\n            lagPump := tempMinPumpIdx;\n        ELSIF needReselect THEN\n            tempMinHours     := LINT#16#7FFFFFFFFFFFFFFF;\n            tempMinPumpIdx   := 0;\n            FOR i := 1 TO 5 DO\n                IF i <> leadPump THEN\n                    IF runHours[i] < tempMinHours OR (runHours[i] = tempMinHours AND i < tempMinPumpIdx) THEN\n                        tempMinHours   := runHours[i];\n                        tempMinPumpIdx := i;\n                    END_IF;\n                END_IF;\n            END_FOR;\n            lagPump := tempMinPumpIdx;\n        ELSE\n            lagPump := prevLagPump;\n        END_IF;\n    END_IF;\nEND_IF;\n\nIF leadPump <> 0 THEN\n    hadValidLeadPump := TRUE;\nEND_IF;\n\nprevDemand        := demand;\nprevRunningCount  := runningCount;\nprevLeadPump      := leadPump;\nprevLagPump       := lagPump;\nEND_FUNCTION_BLOCK",
