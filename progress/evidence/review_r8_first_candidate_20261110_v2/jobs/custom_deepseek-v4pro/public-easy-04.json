      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    VISCOSITY_OK : BOOL;\n    PASTE_E_STOP_NC : BOOL;\n    DebounceMs : DINT;\n    CycleMs : DINT;\nEND_VAR\nVAR_OUTPUT\n    VFD_RUN : BOOL;\n    PUMP_MAINT_DUE : BOOL;\n    PUMP_RUNTIME_ACC : LINT;\nEND_VAR\nVAR\n    valid_duration : LINT;\nEND_VAR\n\nIF PASTE_E_STOP_NC AND VISCOSITY_OK THEN\n    valid_duration := valid_duration + DINT_TO_LINT(CycleMs);\n    IF valid_duration >= DINT_TO_LINT(DebounceMs) THEN\n        VFD_RUN := TRUE;\n    ELSE\n        VFD_RUN := FALSE;\n    END_IF\nELSE\n    valid_duration := 0;\n    VFD_RUN := FALSE;\nEND_IF\n\nIF VFD_RUN THEN\n    PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + DINT_TO_LINT(CycleMs);\nEND_IF\n\nIF PUMP_RUNTIME_ACC >= 1800000000 THEN\n    PUMP_MAINT_DUE := TRUE;\nELSE\n    PUMP_MAINT_DUE := FALSE;\nEND_IF\n\nEND_FUNCTION_BLOCK",
