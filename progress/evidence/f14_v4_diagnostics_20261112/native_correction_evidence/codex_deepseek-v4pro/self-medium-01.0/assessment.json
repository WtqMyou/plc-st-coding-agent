    "code": "TYPE ST_Recipe :\nSTRUCT\n    recipeID : INT;\n    totalRatio : REAL;\n    temperature : REAL;\nEND_STRUCT\nEND_TYPE;\n\nFUNCTION_BLOCK FB\nVAR_INPUT\n    recipe : ARRAY[1..8] OF ST_Recipe;\n    selSlot : INT;\n    loadCmd : BOOL;\n    running : BOOL;\nEND_VAR\nVAR_OUTPUT\n    valid : BOOL;\n    loadedID : INT;\nEND_VAR\nVAR\n    loadCmdPrevious : BOOL;\n    loadEdge : BOOL;\n    slotInRange : BOOL;\n    ratioInRange : BOOL;\n    tempInRange : BOOL;\n    slotOccupied : BOOL;\n    latchedValid : BOOL;\n    latchedLoadedID : INT;\nEND_VAR\n\nloadEdge := loadCmd AND NOT loadCmdPrevious;\n\nIF loadEdge AND NOT running THEN\n    slotInRange := (selSlot >= 1) AND (selSlot <= 8);\n\n    IF slotInRange THEN\n        slotOccupied := (recipe[selSlot].recipeID <> 0);\n        ratioInRange := (recipe[selSlot].totalRatio >= 99.0) AND\n                        (recipe[selSlot].totalRatio <= 101.0);\n        tempInRange := (recipe[selSlot].temperature >= 30.0) AND\n                       (recipe[selSlot].temperature <= 180.0);\n\n        latchedValid := slotOccupied AND ratioInRange AND tempInRange;\n\n        IF latchedValid THEN\n            latchedLoadedID := recipe[selSlot].recipeID;\n        ELSE\n            latchedLoadedID := 0;\n        END_IF;\n    ELSE\n        latchedValid := FALSE;\n        latchedLoadedID := 0;\n    END_IF;\nEND_IF;\n\nvalid := latchedValid;\nloadedID := latchedLoadedID;\nloadCmdPrevious := loadCmd;\n\nEND_FUNCTION_BLOCK",
    "code_hash": "b737e59dda8ea8ae8bba0b23acdaee56aa1a6d70486113ab7c7daf177037a957",
