    "idx": 1,
    "code": "TYPE ST_Pump :\nSTRUCT\n    priority : INT;\n    selection : BOOL;\n    RunComd : BOOL;\nEND_STRUCT\nEND_TYPE;\n\nFUNCTION_BLOCK FB_MultiPumpControl\nVAR_INPUT\n    mode : BOOL;\n    start : BOOL;\n    stop : BOOL;\nEND_VAR\nVAR_IN_OUT\n    pumpGroup : ARRAY[1..5] OF ST_Pump;\nEND_VAR\nVAR\n    runActive : BOOL := FALSE;\n    autoSelected : ARRAY[1..5] OF BOOL;\n    i : INT;\n    j : INT;\n    rank : INT;\nEND_VAR\n\nIF stop THEN\n    runActive := FALSE;\n    FOR i := 1 TO 5 DO\n        pumpGroup[i].RunComd := FALSE;\n    END_FOR;\nELSE\n    IF start THEN\n        runActive := TRUE;\n    END_IF;\n\n    IF runActive THEN\n        IF mode THEN\n            FOR i := 1 TO 5 DO\n                rank := 0;\n                FOR j := 1 TO 5 DO\n                    IF (pumpGroup[j].priority > pumpGroup[i].priority) OR\n                       ((pumpGroup[j].priority = pumpGroup[i].priority) AND (j < i)) THEN\n                        rank := rank + 1;\n                    END_IF;\n                END_FOR;\n                autoSelected[i] := (rank < 3);\n            END_FOR;\n\n            FOR i := 1 TO 5 DO\n                pumpGroup[i].RunComd := autoSelected[i];\n            END_FOR;\n        ELSE\n            FOR i := 1 TO 5 DO\n                pumpGroup[i].RunComd := pumpGroup[i].selection;\n            END_FOR;\n        END_IF;\n    ELSE\n        FOR i := 1 TO 5 DO\n            pumpGroup[i].RunComd := FALSE;\n        END_FOR;\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
