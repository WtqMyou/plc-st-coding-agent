id\": \"PUB001\", \"text\": \"Control a weld-gap alarm with power-up monitoring inhibition, input debouncing during normal monitoring and emergency-stop priority.\"}, {\"id\": \"PUB004\", \"text\": \"3. Resume gap monitoring after initialization. Allow the alarm only after Gap_Exceeded has remained TRUE for DebounceTime. When the signal becomes FALSE, switch off the alarm and clear debounce timing.\"}, {\"id\": \"PUB002\", \"text\": \"1. Gap_Exceeded indicates that the scanner has detected a weld gap exceeding the permitted 1.5 mm value.\"}], \"candidate_timer_observations\": [{\"case\": \"weld-time-1\", \"candidate_clock_ms\": 0, \"candidate_timers\": {\"local_poweruptimer\": {\"IN\": true, \"PT\": 5000, \"Q\": false, \"ET\": 0}, \"local_debouncetimer\": {\"IN\": true, \"PT\": 750, \"Q\": false, \"ET\": 0}}}, {\"case\": \"weld-time-2\", \"candidate_clock_ms\": 999, \"candidate_timers\": {\"local_poweruptimer\": {\"IN\": true, \"PT\": 5000, \"Q\": false, \"ET\": 999}, \"local_debouncetimer\": {\"IN\": true, \"PT\": 750, \"Q\": true, \"ET\": 750}}}, {\"case\": \"weld-time-3\", \"candidate_clock_ms\": 4999, \"candidate_timers\": {\"local_poweruptimer\": {\"IN\": true, \"PT\": 5000, \"Q\": false, \"ET\": 4999}, \"local_debouncetimer\": {\"IN\": true, \"PT\": 750, \"Q\": true, \"ET\": 750}}}, {\"case\": \"weld-time-4\", \"candidate_clock_ms\": 5000, \"candidate_timers\": {\"local_poweruptimer\": {\"IN\": true, \"PT\": 5000, \"Q\": true, \"ET\": 5000}, \"local_debouncetimer\": {\"IN\": false, \"PT\": 750, \"Q\": false, \"ET\": 0}}}, {\"case\": \"weld-time-5\", \"candidate_clock_ms\": 5749, \"candidate_timers\": {\"local_poweruptimer\": {\"IN\": true, \"PT\": 5000, \"Q\": true, \"ET\": 5000}, \"local_debouncetimer\": {\"IN\": false, \"PT\": 750, \"Q\": false, \"ET\": 0}}}, {\"case\": \"weld-time-6\", \"candidate_clock_ms\": 5750, \"candidate_timers\": {\"local_poweruptimer\": {\"IN\": true, \"PT\": 5000, \"Q\": true, \"ET\": 5000}, \"local_debouncetimer\": {\"IN\": false,