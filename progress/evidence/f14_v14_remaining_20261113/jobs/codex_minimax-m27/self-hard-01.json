blic_interface_only\", \"cycles\": 1, \"scan_interval_ms\": null, \"observed_outputs_after_case\": {\"alarmAcked\": false}}, {\"case\": \"alarm-edge-2\", \"inputs\": {\"flowLow\": false, \"ackBtn\": false, \"sensorOK\": false}, \"const_inputs\": {}, \"initial_interface_values\": {}, \"private_initial_state_present\": false, \"initial_state_scope\": \"public_interface_only\", \"cycles\": 1, \"scan_interval_ms\": null, \"observed_outputs_after_case\": {\"alarmAcked\": false}}, {\"case\": \"alarm-edge-3\", \"inputs\": {\"flowLow\": false, \"ackBtn\": false, \"sensorOK\": true}, \"const_inputs\": {}, \"initial_interface_values\": {}, \"private_initial_state_present\": false, \"initial_state_scope\": \"public_interface_only\", \"cycles\": 1, \"scan_interval_ms\": null, \"observed_outputs_after_case\": {\"alarmAcked\": false}}], \"checkpoints\": [{\"case\": \"alarm-edge-2\", \"individually_mismatching_outputs\": [\"alarmAcked\"], \"allowed_output_combination_failed\": false, \"observed_outputs\": {\"alarmAcked\": false, \"alarmActive\": true, \"highHigh\": true}}, {\"case\": \"alarm-edge-3\", \"individually_mismatching_outputs\": [\"alarmAcked\"], \"allowed_output_combination_failed\": false, \"observed_outputs\": {\"alarmAcked\": false, \"alarmActive\": true, \"highHigh\": false}}], \"relevant_public_clauses\": [{\"id\": \"PUB005\", \"text\": \"1. 报警条件成立（flowLow = TRUE）→ alarmActive 置 TRUE，alarmAcked 置 FALSE；\"}, {\"id\": \"PUB006\", \"text\": \"2. 报警未被确认时，即使条件消失，alarmActive 仍保持 TRUE（报警在未确认前不得消失），同时 alarmAcked 置 TRUE 表示'已转为待确认清除'；\"}, {\"id\": \"PUB007\", \"text\": \"3. ackBtn 的**上升沿**确认报警：若此时条件已消失 → alarmActive 与 alarmAcked 一起清除；若条件仍存在 → 只置 alarmAcked，报警继续；\"}, {\"id\": \"PUB018\", \"text\": \"| alarmAcked | BOOL | OUTPUT | 报警已确认（条件消失后自动清除） |\"}, {\"id\": \"PUB024\", \"text\": \"LTL: `G(alarmActive & !alarmAcked & X(flowLow) -> X(alarmActive))`\"}]}]",
