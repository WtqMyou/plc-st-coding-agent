      "code": "TYPE ST_Pump :\nSTRUCT\n    priority  : INT;\n    selection : BOOL;\n    RunComd   : BOOL;\nEND_STRUCT\nEND_TYPE\n\nFUNCTION_BLOCK FB_MultiPumpControl\nVAR_INPUT\n    mode  : BOOL; // FALSE: Manual, TRUE: Automatic\n    start : BOOL; // Start selected pumps\n    stop  : BOOL; // Stop all pumps\nEND_VAR\nVAR_IN_OUT\n    pumpGroup : ARRAY[1..5] OF ST_Pump;\nEND_VAR\nVAR\n    runActive   : BOOL := FALSE;\n    selected    : ARRAY[1..5] OF BOOL;\n    i           : INT;\n    rank        : INT;\n    bestIndex   : INT;\n    bestPriority: INT;\nEND_VAR\n\nIF stop THEN\n    runActive := FALSE;\nELSIF start THEN\n    runActive := TRUE;\nEND_IF;\n\nFOR i := 1 TO 5 DO\n    selected[i] := FALSE;\nEND_FOR;\n\nIF runActive THEN\n    IF mode THEN\n        FOR rank := 1 TO 3 DO\n            bestIndex := 0;\n            bestPriority := 0;\n\n            FOR i := 1 TO 5 DO\n                IF NOT selected[i] THEN\n                    IF (bestIndex = 0) OR (pumpGroup[i].priority > bestPriority) THEN\n                        bestIndex := i;\n                        bestPriority := pumpGroup[i].priority;\n                    END_IF;\n                END_IF;\n            END_FOR;\n\n            IF bestIndex <> 0 THEN\n                selected[bestIndex] := TRUE;\n            END_IF;\n        END_FOR;\n    ELSE\n        FOR i := 1 TO 5 DO\n            selected[i] := pumpGroup[i].selection;\n        END_FOR;\n    END_IF;\nEND_IF;\n\nFOR i := 1 TO 5 DO\n    pumpGroup[i].RunComd := selected[i] AND runActive;\nEND_FOR;",
