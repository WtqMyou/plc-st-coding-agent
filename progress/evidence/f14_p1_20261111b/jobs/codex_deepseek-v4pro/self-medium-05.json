      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    resetBtn : BOOL;\n    scanSeconds : LREAL;\n    steamFlow : LREAL;\n    fuelFlow : LREAL;\n    steamTemp : LREAL;\n    steamPressure : LREAL;\nEND_VAR\nVAR_OUTPUT\n    qualified : BOOL;\n    dataFault : BOOL;\n    qualifiedTon : LREAL;\n    fuelTon : LREAL;\n    revenue : LREAL;\n    cost : LREAL;\n    netProfit : LREAL;\nEND_VAR\nVAR\n    resetBtnPrev : BOOL;\nEND_VAR\n\nqualified := (steamTemp >= 447.0)\n             AND (steamTemp <= 453.0)\n             AND (steamPressure >= 3750.0)\n             AND (steamPressure <= 3850.0);\n\ndataFault := (scanSeconds <= 0.0)\n             OR (scanSeconds > 10.0)\n             OR (steamFlow < 0.0)\n             OR (steamFlow > 90.0)\n             OR (fuelFlow < 0.0)\n             OR (fuelFlow > 6.0);\n\nIF resetBtn AND NOT resetBtnPrev THEN\n    qualifiedTon := 0.0;\n    fuelTon := 0.0;\nELSIF dataFault THEN\n    qualifiedTon := qualifiedTon;\n    fuelTon := fuelTon;\nELSIF enable THEN\n    fuelTon := fuelTon + fuelFlow * scanSeconds / 1000.0;\n\n    IF qualified THEN\n        qualifiedTon := qualifiedTon + steamFlow * scanSeconds / 1000.0;\n    END_IF;\nELSIF NOT enable THEN\n    qualifiedTon := qualifiedTon;\n    fuelTon := fuelTon;\nEND_IF;\n\nrevenue := qualifiedTon * 280.0;\ncost := fuelTon * 1500.0;\nnetProfit := revenue - cost;\n\nresetBtnPrev := resetBtn;",
