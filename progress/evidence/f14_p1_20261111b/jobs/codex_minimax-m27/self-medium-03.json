      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL;\n    motorDown  : BOOL;\n    errorFlag  : BOOL;\nEND_VAR\nVAR\n    prev_openBtn  : BOOL := FALSE;\n    prev_closeBtn : BOOL := FALSE;\n    prev_obstacle : BOOL := FALSE;\n    // Internal state: 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT\n    state : INT := 0;\nEND_VAR\nVAR\n    risingEdgeOpen  : BOOL;\n    risingEdgeClose : BOOL;\n    risingEdgeBoth  : BOOL;\nEND_VAR\n\n// ============================================================================\n// Edge Detection\n// ============================================================================\nrisingEdgeOpen  := openBtn  AND NOT prev_openBtn;\nrisingEdgeClose := closeBtn AND NOT prev_closeBtn;\nrisingEdgeBoth  := (openBtn AND closeBtn) AND NOT (prev_openBtn AND prev_closeBtn);\n\n// ============================================================================\n// Fault Handling (highest priority)\n// ============================================================================\nIF obstacle THEN\n    errorFlag := TRUE;\n    state := 3; // FAULT\nEND_IF;\n\n// ============================================================================\n// State Transitions & Motor Control\n// ============================================================================\nCASE state OF\n    // ---- IDLE ----\n    0: // IDLE\n        IF errorFlag THEN\n            // Already in fault, stay here\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSE\n            // Check for new open command\n            IF risingEdgeOpen AND NOT closeBtn AND NOT openLimit AND NOT obstacle THEN\n                state     := 1; // OPENING\n                motorUp   := TRUE;\n                motorDown := FALSE;\n            // Check for new close command\n            ELSIF risingEdgeClose AND NOT openBtn AND NOT closeLimit AND NOT obstacle THEN\n                state     := 2; // CLOSING\n                motorUp   := FALSE;\n                motorDown := TRUE;\n            ELSE\n                motorUp   := FALSE;\n                motorDown := FALSE;\n            END_IF;\n        END_IF;\n\n    // ---- OPENING ----\n    1: // OPENING\n        IF obstacle THEN\n            // Handled above, stay in fault\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSIF openLimit THEN\n            state     := 0; // IDLE\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSE\n            // Continue opening\n            motorUp   := TRUE;\n            motorDown := FALSE;\n        END_IF;\n\n    // ---- CLOSING ----\n    2: // CLOSING\n        IF obstacle THEN\n            // Handled above, stay in fault\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSIF closeLimit THEN\n            state     := 0; // IDLE\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSE\n            // Continue closing\n            motorUp   := FALSE;\n            motorDown := TRUE;\n        END_IF;\n\n    // ---- FAULT ----\n    3: // FAULT\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        // Reset only when no obstacle AND both buttons have new rising edge together\n        IF NOT obstacle AND risingEdgeBoth THEN\n            errorFlag := FALSE;\n            state     := 0; // IDLE\n        END_IF;\nEND_CASE;\n\n// ============================================================================\n// Update Previous States for Next Scan\n// ============================================================================\nprev_openBtn  := openBtn;\nprev_closeBtn := closeBtn;\nprev_obstacle := obstacle;\n\nEND_FUNCTION_BLOCK",
      "code_hash": "57c713db1b567544ad30f7e23c67a329f7c22939052cc60a53c7535ca21b8564",
