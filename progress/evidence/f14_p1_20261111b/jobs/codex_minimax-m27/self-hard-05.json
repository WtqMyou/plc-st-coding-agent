      "feedback": "自动测试：25/25。\nLTL 检查：bounded_pass。",
      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest : BOOL;\n    flameOK    : BOOL;\n    o2Valid    : BOOL;\n    o2PV       : REAL;\n    baseAir    : REAL;\n    resetBtn   : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    fuelPermit : BOOL;\n    trimEnable : BOOL;\n    airTrim    : REAL;\n    airCommand : REAL;\n    tripLatched: BOOL;\n    o2Fault    : BOOL;\nEND_VAR\n\nVAR\n    prevResetBtn : BOOL := FALSE;\nEND_VAR\n\n// ── 熄火跳闸（当拍置位，检测优先于复位）───────────────────────\nIF runRequest AND NOT flameOK THEN\n    tripLatched := TRUE;\nELSIF resetBtn AND NOT prevResetBtn AND NOT runRequest AND NOT flameOK THEN\n    tripLatched := FALSE;\nELSE\n    tripLatched := tripLatched;\nEND_IF\n\n// ── 燃料许可 ───────────────────────────────────────────────────\nfuelPermit := runRequest AND flameOK AND NOT tripLatched;\n\n// ── 氧量分析仪故障检测 ─────────────────────────────────────────\no2Fault := NOT o2Valid OR o2PV < 0.0 OR o2PV > 21.0;\n\n// ── 氧量修正投入 ───────────────────────────────────────────────\ntrimEnable := fuelPermit AND NOT o2Fault;\n\n// ── 氧量修正偏置（钳位 ±10，故障时归零）────────────────────────\nIF trimEnable THEN\n    airTrim := 2.0 * (2.0 - o2PV);\n    IF airTrim > 10.0 THEN\n        airTrim := 10.0;\n    ELSIF airTrim < -10.0 THEN\n        airTrim := -10.0;\n    END_IF;\nELSE\n    airTrim := 0.0;\nEND_IF;\n\n// ── 风门命令（燃料许可时叠加修正并钳位 0..100，否则归零）────────\nIF fuelPermit THEN\n    airCommand := baseAir + airTrim;\n    IF airCommand > 100.0 THEN\n        airCommand := 100.0;\n    ELSIF airCommand < 0.0 THEN\n        airCommand := 0.0;\n    END_IF;\nELSE\n    airCommand := 0.0;\nEND_IF;\n\n// ── 保存本拍复位按钮状态，供下拍边沿检测 ───────────────────────\nprevResetBtn := resetBtn;\n\nEND_FUNCTION_BLOCK",
