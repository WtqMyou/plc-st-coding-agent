      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    pushEn  : BOOL;\n    pushItem: INT;\n    popEn   : BOOL;\nEND_VAR\n\nVAR_IN_OUT\n    fifo : ARRAY[1..8] OF INT;\nEND_VAR\n\nVAR_OUTPUT\n    count : INT;\n    full  : BOOL;\n    empty : BOOL;\n    head  : INT;\nEND_VAR\n\nVAR\n    prevPushEn : BOOL := FALSE;\n    prevPopEn  : BOOL := FALSE;\n    i          : INT;\nEND_VAR\n\n// ---------------------------------------------------------------------------\n// Rising edge detection\n// ---------------------------------------------------------------------------\nVAR\n    risingPush : BOOL;\n    risingPop  : BOOL;\nEND_VAR\n\nrisingPush := pushEn AND NOT prevPushEn;\nrisingPop  := popEn  AND NOT prevPopEn;\n\n// ---------------------------------------------------------------------------\n// FIFO logic: pop first, then push\n// ---------------------------------------------------------------------------\n\n// 1) Pop on rising edge (non-empty only)\nIF risingPop AND count > 0 THEN\n    FOR i := 1 TO count - 1 DO\n        fifo[i] := fifo[i + 1];\n    END_FOR;\n    count := count - 1;\nEND_IF;\n\n// 2) Push on rising edge (only if space available)\nIF risingPush AND count < 8 THEN\n    count        := count + 1;\n    fifo[count]  := pushItem;\nEND_IF;\n\n// ---------------------------------------------------------------------------\n// Outputs\n// ---------------------------------------------------------------------------\nfull  := (count = 8);\nempty := (count = 0);\n\nIF count = 0 THEN\n    head := 0;\nELSE\n    head := fifo[1];\nEND_IF;\n\n// ---------------------------------------------------------------------------\n// Save button histories for next cycle\n// ---------------------------------------------------------------------------\nprevPushEn := pushEn;\nprevPopEn  := popEn;\n\nEND_FUNCTION_BLOCK",
