      "code": "FUNCTION_BLOCK AlarmHandler\nVAR_INPUT\n    Value       : REAL;\n    hiLevel     : REAL;\n    loLevel     : REAL;\n    hystWindow  : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    hiAlarm     : BOOL;\n    loAlarm     : BOOL;\n    error       : BOOL;\n    status      : WORD;\nEND_VAR\n\n// Error checking\nIF loLevel >= hiLevel THEN\n    error := TRUE;\n    status := 16#8001;\n    RETURN;\nEND_IF\n\nIF hystWindow >= (hiLevel - loLevel) THEN\n    error := TRUE;\n    status := 16#8002;\n    RETURN;\nEND_IF\n\n// No error\nerror := FALSE;\nstatus := 16#0000;\n\n// High alarm with hysteresis\n// Trigger: Value > hiLevel\n// Reset:   Value < hiLevel - hystWindow\nIF Value > hiLevel THEN\n    hiAlarm := TRUE;\nELSIF Value < (hiLevel - hystWindow) THEN\n    hiAlarm := FALSE;\nEND_IF\n\n// Low alarm with hysteresis\n// Trigger: Value < loLevel\n// Reset:   Value > loLevel + hystWindow\nIF Value < loLevel THEN\n    loAlarm := TRUE;\nELSIF Value > (loLevel + hystWindow) THEN\n    loAlarm := FALSE;\nEND_IF\n\nEND_FUNCTION_BLOCK",
