LSE;\n    ActivateGrip := FALSE;\n    ActivateRelease := FALSE;\n    \n    IF startRisingEdge THEN\n        // Execute step based on current step number\n        CASE step OF\n            0: // Move down\n                MoveDown := TRUE;\n                IF DownLimitSwitch THEN\n                    MoveDown := FALSE;\n                    step := 1;\n                END_IF\n                \n            1: // Grip\n                ActivateGrip := TRUE;\n                IF GripLimitSwitch THEN\n                    ActivateGrip := FALSE;\n                    gripActive := TRUE;\n                    step := 2;\n                END_IF\n                \n            2: // Move up\n                MoveUp := TRUE;\n                IF UpLimitSwitch THEN\n                    MoveUp := FALSE;\n                    step := 3;\n                END_IF\n                \n            3: // Move right\n                MoveRight := TRUE;\n                IF RightLimitSwitch THEN\n                    MoveRight := FALSE;\n                    step := 4;\n                END_IF\n                \n            4: // Move down\n                MoveDown := TRUE;\n                IF DownLimitSwitch THEN\n                    MoveDown := FALSE;\n                    step := 5;\n                END_IF\n                \n            5: // Release\n                ActivateRelease := TRUE;\n                IF ReleaseLimitSwitch THEN\n                    ActivateRelease := FALSE;\n                    releaseActive := FALSE;\n                    step := 6;\n                END_IF\n                \n            6: // Move up\n                MoveUp := TRUE;\n                IF UpLimitSwitch THEN\n                    MoveUp := FALSE;\n                    step := 7;\n                END_IF\n                \n            7: // Move left\n                MoveLeft := TRUE;\n                IF LeftLimitSwitch THEN\n                    MoveLeft := FALSE;\n                    step := 0; // Cycle back to beginning\n                END_IF\n        END_CASE\n    END_IF\n    \n    // Check if current action is completed (for non-start press cases)\n    IF NOT startRisingEdge THEN\n        CASE step OF\n            0:\n                IF DownLimitSwitch THEN\n                    MoveDown := FALSE;\n                END_IF\n                \n            1:\n                IF GripLimitSwitch THEN\n                    ActivateGrip := FALSE;\n                    gripActive := TRUE;\n                END_IF\n                \n            2:\n                IF UpLimitSwitch THEN\n                    MoveUp := FALSE;\n                END_IF\n                \n            3:\n                IF RightLimitSwitch THEN\n                    MoveRight := FALSE;\n                END_IF\n                \n            4:\n                IF DownLimitSwitch THEN\n                    MoveDown := FALSE;\n                END_IF\n                \n            5:\n                IF ReleaseLimitSwitch THEN\n                    ActivateRelease := FALSE;\n                    releaseActive := FALSE;\n                END_IF\n                \n            6:\n                IF UpLimitSwitch THEN\n                    MoveUp := FALSE;\n                END_IF\n                \n            7:\n                IF LeftLimitSwitch THEN\n                    MoveLeft := FALSE;\n                END_IF\n        END_CASE\n    END_IF\n    \nELSSEIF SingleCycleMode THEN\n    // Single Cycle Mode: Complete cycle and stop\n    MoveDown := FALSE;\n    MoveUp := FALSE;\n    MoveLeft := FALSE;\n    MoveRight := FALSE;\n    ActivateGrip := FALSE;\n    ActivateRelease := FALSE;\n    \n    // Start cycle on first start press\n    IF startRisingEdge AND step = 0 THEN\n        step := 1;\n    END_IF\n    \n    // Execute cycle steps\n    CASE step OF\n        1: // Move down\n            MoveDown := TRUE;\n            IF DownLimitSwitch THEN\n                MoveDown := FALSE;\n                step := 2;\n            END_IF\n            \n        2: // Grip\n            ActivateGrip := TRUE;\n            IF GripLimitSwitch THEN\n                ActivateGrip := FALSE;\n                gripActive := TRUE;\n                step := 3;\n            END_IF\n            \n        3: // Move up\n            MoveUp := TRUE;\n            IF UpLimitSwitch THEN\n                MoveUp := FALSE;\n                step := 4;\n            END_IF\n            \n        4: // Move right\n            MoveRight := TRUE;\n            IF RightLimitSwitch THEN\n                MoveRight := FALSE;\n                step := 5;\n            END_IF\n            \n        5: // Move down\n            MoveDown := TRUE;\n            IF DownLimitSwitch THEN\n                MoveDown := FALSE;\n                step := 6;\n            END_IF\n            \n        6: // Release\n            ActivateRelease := TRUE;\n            IF ReleaseLimitSwitch THEN\n                ActivateRelease := FALSE;\n                releaseActive := FALSE;\n                step := 7;\n            END_IF\n            \n        7: // Move up\n            MoveUp := TRUE;\n            IF UpLimitSwitch THEN\n                MoveUp := FALSE;\n                step := 8;\n            END_IF\n            \n        8: // Move left\n            MoveLeft := TRUE;\n            IF LeftLimitSwitch THEN\n                MoveLeft := FALSE;\n                step := 0; // Stop at end of cycle\n                gripActive := FALSE;\n            END_IF\n    END_CASE\n    \nELSSEIF ContinuousMode THEN\n    // Continuous Mode: Keep executing cycle\n    MoveDown := FALSE;\n    MoveUp := FALSE;\n    MoveLeft := FALSE;\n    MoveRight := FALSE;\n    ActivateGrip := FALSE;\n    ActivateRelease := FALSE;\n    \n    // Start cycle on first start press\n    IF startRisingEdge AND step = 0 THEN\n        step := 1;\n    END_IF\n    \n    // Execute cycle steps continuously\n    CASE step OF\n        1: // Move down\n            MoveDown := TRUE;\n            IF DownLimitSwitch THEN\n                MoveDown := FALSE;\n                step := 2;\n            END_IF\n            \n        2: // Grip\n            ActivateGrip := TRUE;\n            IF GripLimitSwitch THEN\n                ActivateGrip := FALSE;\n                gripActive := TRUE;\n                step := 3;\n            END_IF\n            \n        3: // Move up\n            MoveUp := TRUE;\n            IF UpLimitSwitch THEN\n                MoveUp := FALSE;\n                step := 4;\n            END_IF\n            \n        4: // Move right\n            MoveRight := TRUE;\n            IF RightLimitSwitch THEN\n                MoveRight := FALSE;\n                step := 5;\n            END_IF\n            \n        5: // Move down\n            MoveDown := TRUE;\n            IF DownLimitSwitch THEN\n                MoveDown := FALSE;\n                step := 6;\n            END_IF\n            \n        6: // Release\n            ActivateRelease := TRUE;\n            IF ReleaseLimitSwitch THEN\n                ActivateRelease := FALSE;\n                releaseActive := FALSE;\n                step := 7;\n            END_IF\n            \n        7: // Move up\n            MoveUp := TRUE;\n            IF UpLimitSwitch THEN\n                MoveUp := FALSE;\n                step := 8;\n            END_IF\n            \n        8: // Move left\n            MoveLeft := TRUE;\n            IF LeftLimitSwitch THEN\n                MoveLeft := FALSE;\n                step := 1; // Cycle back to step 1 (continuous)\n            END_IF\n    END_CASE\n    \nELSE\n    // No mode selected or invalid state\n    MoveDown := FALSE;\n    MoveUp := FALSE;\n    MoveLeft := FALSE;\n    MoveRight := FALSE;\n    ActivateGrip := FALSE;\n    ActivateRelease := FALSE;\n    step := 0;\n    gripActive := FALSE;\n    releaseActive := FALSE;\nEND_IF\n\nEND_FUNCTION_BLOCK\n"
