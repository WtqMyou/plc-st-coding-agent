      "feedback": "静态检查或接口契约失败：\n第 74 行 [E_MISSING_END_POU] FUNCTION_BLOCK FB 缺少结束关键字\n第 0 行 [E_NO_POU] 未找到可执行 POU\nLTL 检查：not_run。",
      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    abortBtn : BOOL;\n    setpoint : REAL;\n    pv : REAL;\n    maxDuration : INT;\nEND_VAR\nVAR_OUTPUT\n    elapsed : INT;\n    phase : INT;\n    timeout : BOOL;\nEND_VAR\nVAR\n    lastStartBtn : BOOL := FALSE;   // 上一拍 startBtn 状态，用于上升沿检测\n    prev_phase : INT;               // 上一拍阶段号\n    prev_elapsed : INT;             // 上一拍累计拍数\n    prev_timeout : BOOL;            // 上一拍超时标志\n    rising : BOOL;                  // 本拍 startBtn 上升沿\nEND_VAR\n\n// ----- 保存上一拍输出 -----\nprev_phase := phase;\nprev_elapsed := elapsed;\nprev_timeout := timeout;\n\n// ----- 检测启动上升沿（包括中止当拍）-----\nrising := startBtn AND NOT lastStartBtn;\n\n// ----- 优先级处理：中止 > 新启动沿 > 运行计数 -----\nIF abortBtn THEN\n    // 中止：立即进入中止态，elapsed 与 timeout 保持上一拍值\n    phase := 9;\n    // elapsed 不赋值，保持 prev_elapsed\n    // timeout 不赋值，保持 prev_timeout\nELSIF rising THEN\n    // 新启动沿且未中止：开始新批次，启动拍不计数\n    phase := 1;\n    elapsed := 0;\n    timeout := FALSE;\nELSE\n    // 无中止、无新启动沿：运行计数或状态保持\n    IF (prev_phase = 1) OR (prev_phase = 2) THEN\n        // 上一拍为运行态：累计拍数加 1\n        elapsed := prev_elapsed + 1;\n        // 判断本拍是否超时（达到或超过 maxDuration）\n        IF elapsed >= maxDuration THEN\n            // 超时优先于升温达标\n            timeout := TRUE;\n            phase := 3;\n        ELSE\n            // 未超时：保持超时标志为 FALSE，处理升温/保温转换\n            timeout := FALSE;\n            IF prev_phase = 2 THEN\n                // 保温阶段维持\n                phase := 2;\n            ELSIF (prev_phase = 1) AND (pv >= setpoint) THEN\n                // 升温达标，进入保温\n                phase := 2;\n            ELSE\n                // 升温且未达标，继续升温\n                phase := 1;\n            END_IF;\n        END_IF;\n    ELSE\n        // 上一拍非运行态（0,3,9）：完整保持原状态\n        phase := prev_phase;\n        elapsed := prev_elapsed;\n        timeout := prev_timeout;\n    END_IF;\nEND_IF;\n\n// ----- 消耗启动沿：更新 lastStartBtn 为当前 startBtn -----\nlastStartBtn := startBtn;",
