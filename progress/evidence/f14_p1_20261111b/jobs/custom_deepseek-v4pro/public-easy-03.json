      "idx": 0,
      "code": "FUNCTION_BLOCK AlarmHandling\nVAR_INPUT\n    Value : REAL;\n    hiLevel : REAL;\n    loLevel : REAL;\n    hystWindow : REAL;\nEND_VAR\nVAR_OUTPUT\n    hiAlarm : BOOL;\n    loAlarm : BOOL;\n    error : BOOL;\n    status : WORD;\nEND_VAR\nVAR\n    hiActive : BOOL := FALSE;\n    loActive : BOOL := FALSE;\nEND_VAR\n\nerror := FALSE;\nstatus := WORD#0;\n\n// Error condition: invalid limit configuration\nIF loLevel >= hiLevel THEN\n    error := TRUE;\n    status := WORD#16#8001;\n    hiActive := FALSE;\n    loActive := FALSE;\n    hiAlarm := FALSE;\n    loAlarm := FALSE;\n    RETURN;\nEND_IF;\n\n// Error condition: hysteresis window too large\nIF hystWindow >= (hiLevel - loLevel) THEN\n    error := TRUE;\n    status := WORD#16#8002;\n    hiActive := FALSE;\n    loActive := FALSE;\n    hiAlarm := FALSE;\n    loAlarm := FALSE;\n    RETURN;\nEND_IF;\n\n// High alarm with hysteresis\nIF (Value > hiLevel) THEN\n    hiActive := TRUE;\nELSIF (Value < (hiLevel - hystWindow)) THEN\n    hiActive := FALSE;\nEND_IF;\n\n// Low alarm with hysteresis\nIF (Value < loLevel) THEN\n    loActive := TRUE;\nELSIF (Value > (loLevel + hystWindow)) THEN\n    loActive := FALSE;\nEND_IF;\n\n// Assign outputs\nhiAlarm := hiActive;\nloAlarm := loActive;\n\nEND_FUNCTION_BLOCK",
      "code_hash": "5714412426225d5f7d8b411fea184a6371d1e31563b80b7e7841c692a7751bde",
