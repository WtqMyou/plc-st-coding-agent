      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    demand : INT;\n    runHours : ARRAY[1..5] OF LINT;\n    rotated : BOOL;\nEND_VAR\nVAR_OUTPUT\n    leadPump : INT;\n    lagPump : INT;\n    runningCount : INT;\nEND_VAR\nVAR\n    prevLead : INT := 0;\n    prevLag : INT := 0;\n    prevRunCount : INT := 0;\n    clipped : INT;\n    newLead : INT;\n    newLag : INT;\n    newRunningCount : INT;\n    minP : INT;\n    minH : LINT;\n    i : INT;\nEND_VAR\n\n(* 裁剪需求到 0..5 *)\nIF demand < 0 THEN\n    clipped := 0;\nELSIF demand > 5 THEN\n    clipped := 5;\nELSE\n    clipped := demand;\nEND_IF;\n\nnewRunningCount := clipped;\n\nIF clipped <= 0 THEN\n    newLead := 0;\n    newLag := 0;\nELSE\n    (* 主泵选择 *)\n    IF prevLead = 0 THEN\n        (* 初选：全场（工时，泵号）最小 *)\n        minP := 1;\n        minH := runHours[1];\n        FOR i := 2 TO 5 DO\n            IF (runHours[i] < minH) OR ((runHours[i] = minH) AND (i < minP)) THEN\n                minP := i;\n                minH := runHours[i];\n            END_IF;\n        END_FOR;\n        newLead := minP;\n    ELSE\n        (* 正需求期间按迟滞逻辑 *)\n        IF rotated THEN\n            minP := 1;\n            minH := runHours[1];\n            FOR i := 2 TO 5 DO\n                IF (runHours[i] < minH) OR ((runHours[i] = minH) AND (i < minP)) THEN\n                    minP := i;\n                    minH := runHours[i];\n                END_IF;\n            END_FOR;\n            IF (runHours[prevLead] - runHours[minP] > 50) THEN\n                newLead := minP;\n            ELSE\n                newLead := prevLead;\n            END_IF;\n        ELSE\n            newLead := prevLead;\n        END_IF;\n    END_IF;\n\n    (* 备泵选择 *)\n    IF clipped < 2 THEN\n        newLag := 0;\n    ELSE\n        (* 初选/换主或需求台数上升时重选 *)\n        IF (newLead <> prevLead) OR (newRunningCount > prevRunCount) THEN\n            minP := 0;\n            minH := 0;\n            FOR i := 1 TO 5 DO\n                IF i <> newLead THEN\n                    IF minP = 0 THEN\n                        minP := i;\n                        minH := runHours[i];\n                    ELSE\n                        IF (runHours[i] < minH) OR ((runHours[i] = minH) AND (i < minP)) THEN\n                            minP := i;\n                            minH := runHours[i];\n                        END_IF;\n                    END_IF;\n                END_IF;\n            END_FOR;\n            newLag := minP;\n        ELSE\n            newLag := prevLag;\n        END_IF;\n    END_IF;\nEND_IF;\n\nleadPump := newLead;\nlagPump := newLag;\nrunningCount := newRunningCount;\n\nprevLead := newLead;\nprevLag := newLag;\nprevRunCount := newRunningCount;\n\nEND_FUNCTION_BLOCK",
