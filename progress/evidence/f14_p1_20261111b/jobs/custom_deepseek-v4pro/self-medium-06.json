      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    resetBtn : BOOL;\n    sensorValid : BOOL;\n    setpoint : REAL;\n    temperature : REAL;\n    scanSeconds : REAL;\n    bias : REAL;\nEND_VAR\nVAR_OUTPUT\n    power : REAL;\n    correction : REAL;\n    fault : BOOL;\nEND_VAR\nVAR\n    ePrev : REAL;\n    histValid : BOOL;\n    lastResetBtn : BOOL;\nEND_VAR\nVAR_TEMP\n    e : REAL;\n    de : REAL;\n    x : REAL;\n    y : REAL;\n    resetRising : BOOL;\nEND_VAR\n\nBEGIN\n    -- 计算误差\n    e := setpoint - temperature;\n    \n    -- 计算故障\n    fault := NOT sensorValid OR (scanSeconds <= 0.0) OR (scanSeconds > 10.0);\n    \n    -- 检测复位上升沿\n    resetRising := resetBtn AND NOT lastResetBtn;\n    \n    IF (NOT enable OR fault OR resetRising) THEN\n        -- 故障、停用或复位上升沿：输出归零，清除历史\n        power := 0.0;\n        correction := 0.0;\n        ePrev := 0.0;\n        histValid := FALSE;\n    ELSE\n        -- 正常模糊计算\n        IF histValid THEN\n            de := (e - ePrev) / scanSeconds;\n        ELSE\n            de := 0.0;  -- 首拍或历史被清除后恢复首拍\n        END_IF;\n        \n        x := LIMIT(-1.0, e / 10.0, 1.0);\n        y := LIMIT(-1.0, de / 2.0, 1.0);\n        \n        -- 九规则重心法等价于 20*x + 10*y\n        correction := 20.0 * x + 10.0 * y;\n        \n        power := LIMIT(0.0, bias + correction, 100.0);\n        \n        ePrev := e;\n        histValid := TRUE;\n    END_IF;\n    \n    -- 更新上一周期复位按钮状态\n    lastResetBtn := resetBtn;\nEND_FUNCTION_BLOCK",
      "code_hash": "49076587a662b58aa310d7d534ebe6ee2f13667d6f9c182381b69447469271ff",
