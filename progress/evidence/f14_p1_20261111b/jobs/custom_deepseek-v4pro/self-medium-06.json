      "idx": 1,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    resetBtn : BOOL;\n    sensorValid : BOOL;\n    setpoint : REAL;\n    temperature : REAL;\n    scanSeconds : REAL;\n    bias : REAL;\nEND_VAR\nVAR_OUTPUT\n    power : REAL;\n    correction : REAL;\n    fault : BOOL;\nEND_VAR\nVAR\n    ePrev : REAL;\n    histValid : BOOL;\n    lastResetBtn : BOOL;\nEND_VAR\nVAR_TEMP\n    e : REAL;\n    de : REAL;\n    x : REAL;\n    y : REAL;\n    resetRising : BOOL;\n    tempPower : REAL;\nEND_VAR\n\nBEGIN\n    -- Compute error\n    e := setpoint - temperature;\n    \n    -- Compute fault status\n    fault := NOT sensorValid OR (scanSeconds <= 0.0) OR (scanSeconds > 10.0);\n    \n    -- Detect rising edge of reset button\n    resetRising := resetBtn AND NOT lastResetBtn;\n    \n    IF (NOT enable OR fault OR resetRising) THEN\n        -- Fault, disabled, or reset rising edge:\n        -- Output zero and clear history\n        power := 0.0;\n        correction := 0.0;\n        ePrev := 0.0;\n        histValid := FALSE;\n    ELSE\n        -- Normal fuzzy calculation\n        IF histValid THEN\n            de := (e - ePrev) / scanSeconds;\n        ELSE\n            de := 0.0;  -- First cycle after start/reset/fault recovery\n        END_IF;\n        \n        -- Clamp x to [-1, 1]\n        x := e / 10.0;\n        IF x < -1.0 THEN\n            x := -1.0;\n        ELSIF x > 1.0 THEN\n            x := 1.0;\n        END_IF;\n        \n        -- Clamp y to [-1, 1]\n        y := de / 2.0;\n        IF y < -1.0 THEN\n            y := -1.0;\n        ELSIF y > 1.0 THEN\n            y := 1.0;\n        END_IF;\n        \n        -- Nine-rule centroid equivalent: 20*x + 10*y\n        correction := 20.0 * x + 10.0 * y;\n        \n        -- Clamp power to [0, 100]\n        tempPower := bias + correction;\n        IF tempPower < 0.0 THEN\n            power := 0.0;\n        ELSIF tempPower > 100.0 THEN\n            power := 100.0;\n        ELSE\n            power := tempPower;\n        END_IF;\n        \n        -- Update history\n        ePrev := e;\n        histValid := TRUE;\n    END_IF;\n    \n    -- Store current reset button state for next cycle edge detection\n    lastResetBtn := resetBtn;\nEND_FUNCTION_BLOCK",
