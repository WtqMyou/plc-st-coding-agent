      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue : BOOL;\n    dequeue : BOOL;\n    reset : BOOL;\n    capacity : DINT;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT;\n    status : WORD;\nEND_VAR\nVAR_IN_OUT\n    item : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\nVAR\n    head_pos : DINT := 1;\n    enqueue_prev : BOOL := FALSE;\n    dequeue_prev : BOOL := FALSE;\nEND_VAR\n\n    // Reset takes priority\n    IF reset THEN\n        elementCount := 0;\n        status := 16#0000;\n        head_pos := 1;\n    ELSIF enqueue AND NOT enqueue_prev THEN\n        // Rising edge on enqueue\n        IF elementCount < capacity THEN\n            buffer[((head_pos + elementCount - 1) MOD capacity) + 1] := item;\n            elementCount := elementCount + 1;\n            status := 16#0000;\n        ELSE\n            status := 16#8002;\n        END_IF;\n    ELSIF dequeue AND NOT dequeue_prev THEN\n        // Rising edge on dequeue\n        IF elementCount > 0 THEN\n            item := buffer[head_pos];\n            head_pos := (head_pos MOD capacity) + 1;\n            elementCount := elementCount - 1;\n            status := 16#0000;\n        ELSE\n            status := 16#8001;\n        END_IF;\n    ELSE\n        status := 16#0000;\n    END_IF;\n\n    enqueue_prev := enqueue;\n    dequeue_prev := dequeue;\n\nEND_FUNCTION_BLOCK",
