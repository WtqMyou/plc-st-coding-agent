      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL := FALSE;\n    motorDown  : BOOL := FALSE;\n    errorFlag  : BOOL := FALSE;\nEND_VAR\nVAR\n    curState      : INT := 0;\n    prevOpenBtn   : BOOL := FALSE;\n    prevCloseBtn  : BOOL := FALSE;\n    openBtnRise   : BOOL := FALSE;\n    closeBtnRise  : BOOL := FALSE;\nEND_VAR\n\n// 检测边沿\nopenBtnRise  := openBtn AND NOT prevOpenBtn;\ncloseBtnRise := closeBtn AND NOT prevCloseBtn;\n\n// 状态机\nCASE curState OF\n    3: // FAULT\n        IF openBtn AND closeBtn THEN\n            curState   := 0;\n            errorFlag  := FALSE;\n            openBtnRise  := FALSE;\n            closeBtnRise := FALSE;\n        END_IF\n        \n    1: // OPENING\n        IF obstacle THEN\n            curState  := 3;\n            errorFlag := TRUE;\n            motorUp   := FALSE;\n        ELSIF openLimit THEN\n            curState  := 0;\n            motorUp   := FALSE;\n        END_IF\n        \n    2: // CLOSING\n        IF obstacle THEN\n            curState  := 1;\n            motorDown := FALSE;\n            motorUp   := TRUE;\n        ELSIF closeLimit THEN\n            curState   := 0;\n            motorDown  := FALSE;\n        END_IF\n        \n    0: // IDLE\n        IF openBtnRise AND NOT openLimit THEN\n            curState  := 1;\n            motorUp   := TRUE;\n            motorDown := FALSE;\n        ELSIF closeBtnRise AND NOT closeLimit THEN\n            curState  := 2;\n            motorDown := TRUE;\n            motorUp   := FALSE;\n        END_IF;\nEND_CASE\n\n// 清除边沿标志\nopenBtnRise  := FALSE;\ncloseBtnRise := FALSE;\n\n// 更新历史\nprevOpenBtn  := openBtn;\nprevCloseBtn := closeBtn;\nEND_FUNCTION_BLOCK",
