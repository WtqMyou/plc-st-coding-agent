      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue  : BOOL;\n    dequeue  : BOOL;\n    reset    : BOOL;\n    capacity : DINT;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT;\n    status       : WORD;\nEND_VAR\nVAR_IN_OUT\n    item   : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\nVAR\n    head      : DINT := 1;\n    tail      : DINT := 1;\n    isFull    : BOOL := FALSE;\n    prevEnq   : BOOL := FALSE;\n    prevDeq   : BOOL := FALSE;\n    prevReset : BOOL := FALSE;\nEND_VAR\n\nstatus := 16#0000;\n\nIF reset AND NOT prevReset THEN\n    head      := 1;\n    tail      := 1;\n    isFull    := FALSE;\n    elementCount := 0;\n    prevEnq   := enqueue;\n    prevDeq   := dequeue;\n    prevReset := reset;\n    RETURN;\nEND_IF;\n\nIF enqueue AND NOT prevEnq THEN\n    IF isFull THEN\n        status := 16#8002;\n    ELSE\n        buffer[DINT_TO_INT(tail)] := item;\n        IF tail >= capacity THEN\n            tail := 1;\n        ELSE\n            tail := tail + 1;\n        END_IF;\n        IF tail = head THEN\n            isFull := TRUE;\n        END_IF;\n        elementCount := elementCount + 1;\n    END_IF;\nEND_IF;\n\nIF dequeue AND NOT prevDeq THEN\n    IF elementCount = 0 THEN\n        status := 16#8001;\n    ELSE\n        item := buffer[DINT_TO_INT(head)];\n        IF head >= capacity THEN\n            head := 1;\n        ELSE\n            head := head + 1;\n        END_IF;\n        isFull := FALSE;\n        elementCount := elementCount - 1;\n    END_IF;\nEND_IF;\n\nprevEnq   := enqueue;\nprevDeq   := dequeue;\nprevReset := reset;\nEND_FUNCTION_BLOCK",
