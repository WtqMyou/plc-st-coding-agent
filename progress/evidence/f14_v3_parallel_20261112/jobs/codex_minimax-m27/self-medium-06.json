      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    resetBtn : BOOL;\n    sensorValid : BOOL;\n    setpoint : REAL;\n    temperature : REAL;\n    scanSeconds : REAL;\n    bias : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    power : REAL := 0.0;\n    correction : REAL := 0.0;\n    fault : BOOL := FALSE;\nEND_VAR\n\nVAR\n    ePrev : REAL := 0.0;\n    hasHistory : BOOL := FALSE;\n    prevEnableAndNoFault : BOOL := FALSE;\n    prevResetBtn : BOOL := FALSE;\nEND_VAR\n\nVAR\n    risingReset : BOOL;\n    e : REAL;\n    de : REAL;\n    x : REAL;\n    y : REAL;\n    muNx : REAL;\n    muZx : REAL;\n    muPx : REAL;\n    muNy : REAL;\n    muZy : REAL;\n    muPy : REAL;\n    w1 : REAL;\n    w2 : REAL;\n    w3 : REAL;\n    w4 : REAL;\n    w5 : REAL;\n    w6 : REAL;\n    w7 : REAL;\n    w8 : REAL;\n    w9 : REAL;\n    sumW : REAL;\n    sumWc : REAL;\nEND_VAR\n\nrisingReset := resetBtn AND NOT prevResetBtn;\nfault := NOT sensorValid OR scanSeconds <= 0.0 OR scanSeconds > 10.0;\n\nIF fault OR risingReset OR NOT enable THEN\n    ePrev := 0.0;\n    hasHistory := FALSE;\nEND_IF;\n\nIF scanSeconds <= 0.0 OR scanSeconds > 10.0 OR NOT sensorValid THEN\n    power := 0.0;\n    correction := 0.0;\n    prevEnableAndNoFault := enable AND NOT fault;\n    prevResetBtn := resetBtn;\n    RETURN;\nEND_IF;\n\ne := setpoint - temperature;\n\nIF NOT hasHistory THEN\n    de := 0.0;\nELSE\n    de := (e - ePrev) / scanSeconds;\nEND_IF;\n\nx := LIMIT(-1.0, e / 10.0, 1.0);\ny := LIMIT(-1.0, de / 2.0, 1.0);\n\nmuNx := MAX(-x, 0.0);\nmuZx := 1.0 - ABS(x);\nmuPx := MAX(x, 0.0);\n\nmuNy := MAX(-y, 0.0);\nmuZy := 1.0 - ABS(y);\nmuPy := MAX(y, 0.0);\n\nw1 := muNx * muNy;\nw2 := muNx * muZy;\nw3 := muNx * muPy;\nw4 := muZx * muNy;\nw5 := muZx * muZy;\nw6 := muZx * muPy;\nw7 := muPx * muNy;\nw8 := muPx * muZy;\nw9 := muPx * muPy;\n\nsumW := w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8 + w9;\nsumWc := w1 * (-30.0) + w2 * (-20.0) + w3 * (-10.0) + w4 * (-10.0) + w5 * 0.0 + w6 * 10.0 + w7 * 10.0 + w8 * 20.0 + w9 * 30.0;\n\nIF sumW > 0.0 THEN\n    correction := sumWc / sumW;\nELSE\n    correction := 0.0;\nEND_IF;\n\npower := LIMIT(0.0, bias + correction, 100.0);\n\nhasHistory := TRUE;\nePrev := e;\nprevEnableAndNoFault := enable AND NOT fault;\nprevResetBtn := resetBtn;\nEND_FUNCTION_BLOCK",
