      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn    : BOOL;\n    resetBtn    : BOOL;\n    doneSensor  : BOOL;\n    targetVol   : REAL;\n    flowVol     : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen   : BOOL := FALSE;\n    fillsToday  : INT := 0;\nEND_VAR\nVAR\n    prevStartBtn   : BOOL := FALSE;\n    prevResetBtn   : BOOL := FALSE;\n    prevValveOpen  : BOOL := FALSE;\n    prevFillsToday : INT := 0;\n    pending        : BOOL := FALSE;\n    accumVol       : REAL := 0.0;\nEND_VAR\n\nVAR\n    risingStartBtn : BOOL;\n    risingResetBtn : BOOL;\nEND_VAR\n\nrisingStartBtn := startBtn AND NOT prevStartBtn;\nrisingResetBtn := resetBtn AND NOT prevResetBtn;\nprevValveOpen  := valveOpen;\nprevFillsToday := fillsToday;\n\nIF risingResetBtn THEN\n    fillsToday := 0;\n    pending    := FALSE;\n    valveOpen  := FALSE;\n    accumVol   := 0.0;\n    prevFillsToday := 0;\n    prevValveOpen  := FALSE;\nELSIF risingStartBtn THEN\n    IF pending THEN\n        pending := FALSE;\n    END_IF;\n    IF prevValveOpen THEN\n        accumVol := accumVol + flowVol;\n    ELSE\n        accumVol := flowVol;\n    END_IF;\n    IF accumVol >= targetVol THEN\n        valveOpen := FALSE;\n        pending   := TRUE;\n    ELSE\n        valveOpen := TRUE;\n    END_IF;\nELSIF valveOpen THEN\n    accumVol := accumVol + flowVol;\n    IF accumVol >= targetVol THEN\n        valveOpen := FALSE;\n        pending   := TRUE;\n    END_IF;\nEND_IF;\n\nIF pending THEN\n    IF doneSensor THEN\n        IF prevFillsToday < 32767 THEN\n            fillsToday := prevFillsToday + 1;\n        ELSE\n            fillsToday := 32767;\n        END_IF;\n        pending := FALSE;\n    END_IF;\nEND_IF;\n\nprevStartBtn  := startBtn;\nprevResetBtn  := resetBtn;\nEND_FUNCTION_BLOCK",
