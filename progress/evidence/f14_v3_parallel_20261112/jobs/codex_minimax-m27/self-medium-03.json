      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL := FALSE;\n    motorDown  : BOOL := FALSE;\n    errorFlag  : BOOL := FALSE;\nEND_VAR\nVAR\n    state        : UINT := 0;\n    prevOpenBtn  : BOOL := FALSE;\n    prevCloseBtn : BOOL := FALSE;\n    openBtnRising  : BOOL;\n    closeBtnRising : BOOL;\n    bothBtnRising  : BOOL;\nEND_VAR\n\nopenBtnRising  := openBtn  AND NOT prevOpenBtn;\ncloseBtnRising := closeBtn AND NOT prevCloseBtn;\nbothBtnRising  := (openBtn AND closeBtn) AND (prevOpenBtn OR prevCloseBtn);\n\nIF obstacle THEN\n    state := 3;\n    errorFlag := TRUE;\n    motorUp   := FALSE;\n    motorDown := FALSE;\nELSE\n    CASE state OF\n        0:  // IDLE\n            motorUp   := FALSE;\n            motorDown := FALSE;\n            IF openBtnRising AND NOT closeBtn AND NOT openLimit THEN\n                state := 1;\n                motorUp := TRUE;\n            ELSIF closeBtnRising AND NOT openBtn AND NOT closeLimit THEN\n                state := 2;\n                motorDown := TRUE;\n            END_IF;\n\n        1:  // OPENING\n            motorUp   := TRUE;\n            motorDown := FALSE;\n            IF openLimit THEN\n                state := 0;\n                motorUp := FALSE;\n            END_IF;\n\n        2:  // CLOSING\n            motorUp   := FALSE;\n            motorDown := TRUE;\n            IF closeLimit THEN\n                state := 0;\n                motorDown := FALSE;\n            END_IF;\n\n        3:  // FAULT\n            motorUp   := FALSE;\n            motorDown := FALSE;\n            IF bothBtnRising THEN\n                state := 0;\n            END_IF;\n    END_CASE;\nEND_IF;\n\nerrorFlag := (state = 3);\nprevOpenBtn  := openBtn;\nprevCloseBtn := closeBtn;\n\nEND_FUNCTION_BLOCK",
