      "code": "FUNCTION_BLOCK FB_MovingAverage\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    average : LREAL := 0.0;\n    windowSizeReached : BOOL := FALSE;\n    error : BOOL := FALSE;\n    status : WORD := 16#0000;\nEND_VAR\n\nVAR\n    buffer : ARRAY[1..100] OF LREAL;\n    index : INT := 1;\n    count : INT := 0;\n    sum : LREAL := 0.0;\n    prevCyclic : BOOL := FALSE;\n    prevTrigger : BOOL := FALSE;\n    prevReset : BOOL := FALSE;\nEND_VAR\n\n// Reset on rising edge\nIF reset AND NOT prevReset THEN\n    index := 1;\n    count := 0;\n    sum := 0.0;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    error := FALSE;\n    status := 16#0000;\nEND_IF;\n\n// Validate window size\nIF windowSize < 1 OR windowSize > 100 THEN\n    error := TRUE;\n    status := 16#8200;\n    RETURN;\nEND_IF;\n\nerror := FALSE;\nstatus := 16#0000;\n\n// Process cyclic execution on rising edge\nIF cyclicExecution AND NOT prevCyclic THEN\n    // Add value\n    sum := sum + value;\n    buffer[index] := value;\n    IF count < windowSize THEN\n        count := count + 1;\n        windowSizeReached := FALSE;\n    ELSE\n        sum := sum - buffer[index];\n    END_IF;\n    average := sum / INT_TO_LREAL(count);\n    index := (index MOD windowSize) + 1;\nEND_IF;\n\n// Process trigger on rising edge (only when cyclicExecution is FALSE)\nIF (NOT cyclicExecution) AND trigger AND NOT prevTrigger THEN\n    // Add value\n    sum := sum + value;\n    buffer[index] := value;\n    IF count < windowSize THEN\n        count := count + 1;\n        windowSizeReached := FALSE;\n    ELSE\n        sum := sum - buffer[index];\n    END_IF;\n    average := sum / INT_TO_LREAL(count);\n    index := (index MOD windowSize) + 1;\nEND_IF;\n\n// Update previous states\nprevCyclic := cyclicExecution;\nprevTrigger := trigger;\nprevReset := reset;\nEND_FUNCTION_BLOCK",
