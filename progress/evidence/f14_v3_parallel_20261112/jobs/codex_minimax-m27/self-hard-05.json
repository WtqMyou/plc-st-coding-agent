      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest  : BOOL;\n    flameOK     : BOOL;\n    o2Valid     : BOOL;\n    o2PV        : REAL;\n    baseAir     : REAL;\n    resetBtn    : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    fuelPermit  : BOOL;\n    trimEnable  : BOOL;\n    airTrim     : REAL;\n    airCommand  : REAL;\n    tripLatched : BOOL;\n    o2Fault     : BOOL;\nEND_VAR\n\nVAR\n    prevResetBtn : BOOL := FALSE;\n    tripInternal : BOOL := FALSE;\nEND_VAR\n\n// 氧量故障判定\no2Fault := NOT o2Valid OR o2PV < 0.0 OR o2PV > 21.0;\n\n// 熄火跳闸逻辑：运行中失去火焰当拍置位；安全停机态下复位上升沿清除\nIF runRequest AND NOT flameOK THEN\n    tripInternal := TRUE;\nELSIF NOT runRequest AND NOT flameOK AND resetBtn AND NOT prevResetBtn THEN\n    tripInternal := FALSE;\nEND_IF;\n\n// 燃料许可：运行请求、火焰正常、未跳闸三者同时成立\nfuelPermit := runRequest AND flameOK AND NOT tripInternal;\n\n// 氧量修正：投入需燃料许可且分析仪无故障\ntrimEnable := fuelPermit AND NOT o2Fault;\nairTrim := 2.0 * (2.0 - o2PV);\nairTrim := LIMIT(-10.0, airTrim, 10.0);\nairTrim := SEL(trimEnable, 0.0, airTrim);\n\n// 风门命令：基础开度叠加修正，偏置切除时自动归零\nairCommand := baseAir + airTrim;\nairCommand := LIMIT(0.0, airCommand, 100.0);\nairCommand := SEL(fuelPermit, 0.0, airCommand);\n\n// 输出跳闸状态\ntripLatched := tripInternal;\n\n// 边沿检测：保存复位按钮上一拍状态\nprevResetBtn := resetBtn;\n\nEND_FUNCTION_BLOCK",
