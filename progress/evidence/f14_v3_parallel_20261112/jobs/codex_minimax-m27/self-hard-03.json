      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    pushEn: BOOL;\n    pushItem: INT;\n    popEn: BOOL;\nEND_VAR\n\nVAR_IN_OUT\n    fifo: ARRAY[1..8] OF INT;\nEND_VAR\n\nVAR_OUTPUT\n    count: INT := 0;\n    full: BOOL := FALSE;\n    empty: BOOL := TRUE;\n    head: INT := 0;\nEND_VAR\n\nVAR\n    prevPushEn: BOOL := FALSE;\n    prevPopEn: BOOL := FALSE;\nEND_VAR\n\nVAR\n    risingPush: BOOL;\n    risingPop: BOOL;\n    i: INT;\nEND_VAR\n\n// Detect rising edges\nrisingPush := pushEn AND NOT prevPushEn;\nrisingPop := popEn AND NOT prevPopEn;\n\n// Process in order: pop first, then push\n// POP: only if queue not empty\nIF risingPop AND count > 0 THEN\n    // Shift left if more than one element\n    IF count > 1 THEN\n        FOR i := 1 TO count - 1 DO\n            fifo[i] := fifo[i + 1];\n        END_FOR;\n    END_IF;\n    // Decrement count\n    count := count - 1;\nEND_IF;\n\n// PUSH: only if queue not full\nIF risingPush AND count < 8 THEN\n    count := count + 1;\n    fifo[count] := pushItem;\nEND_IF;\n\n// Update outputs\nfull := (count = 8);\nempty := (count = 0);\nIF count > 0 THEN\n    head := fifo[1];\nELSE\n    head := 0;\nEND_IF;\n\n// Save current state for next cycle\nprevPushEn := pushEn;\nprevPopEn := popEn;\n\nEND_FUNCTION_BLOCK",
