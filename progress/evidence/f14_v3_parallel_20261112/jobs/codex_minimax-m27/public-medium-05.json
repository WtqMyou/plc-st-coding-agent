      "code": "FUNCTION_BLOCK ProductionLineControl\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorA : BOOL;\n    SensorB : BOOL;\n    SensorC : BOOL;\n    ButtonA : BOOL;\n    ButtonB : BOOL;\n    ButtonC : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    MotorForward : BOOL := FALSE;\n    MotorReverse : BOOL := FALSE;\n    CompletionLight : BOOL := FALSE;\nEND_VAR\n\nVAR\n    State : INT := 0;\n    PrevButtonA : BOOL := FALSE;\n    PrevButtonB : BOOL := FALSE;\n    PrevButtonC : BOOL := FALSE;\nEND_VAR\n\nIF Mode = FALSE THEN\n    MotorForward := ForwardButton AND NOT ReverseButton;\n    MotorReverse := ReverseButton AND NOT ForwardButton;\nELSE\n    MotorForward := FALSE;\n    MotorReverse := FALSE;\n    \n    CASE State OF\n        0:\n            IF SensorA THEN\n                State := 1;\n            END_IF;\n            \n        1:\n            IF ButtonA AND NOT PrevButtonA THEN\n                MotorForward := TRUE;\n                State := 2;\n            END_IF;\n            \n        2:\n            IF SensorB THEN\n                MotorForward := FALSE;\n                State := 3;\n            END_IF;\n            \n        3:\n            IF ButtonB AND NOT PrevButtonB THEN\n                MotorForward := TRUE;\n                State := 4;\n            END_IF;\n            \n        4:\n            IF SensorC THEN\n                MotorForward := FALSE;\n                State := 5;\n            END_IF;\n            \n        5:\n            IF ButtonC AND NOT PrevButtonC THEN\n                CompletionLight := TRUE;\n                State := 6;\n            END_IF;\n            \n        6:\n            IF NOT SensorC THEN\n                CompletionLight := FALSE;\n                State := 0;\n            END_IF;\n    END_CASE;\n    \n    PrevButtonA := ButtonA;\n    PrevButtonB := ButtonB;\n    PrevButtonC := ButtonC;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
