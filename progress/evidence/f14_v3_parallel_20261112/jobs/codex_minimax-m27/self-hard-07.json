      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    mode            : INT;\n    resetBtn        : BOOL;\n    scanSeconds     : REAL;\n    tempSP          : REAL;\n    tempPV          : REAL;\n    flowPV          : REAL;\n    manualFlowSP    : REAL;\n    manualValve     : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    flowSP          : REAL;\n    valveCommand    : REAL;\n    fault           : BOOL;\n    normalMode      : BOOL;\nEND_VAR\n\nVAR\n    prevMode        : INT;\n    prevResetBtn    : BOOL;\n    prevFlowSP      : REAL;\n    prevValveCmd    : REAL;\n    accT            : REAL;\n    accF            : REAL;\n    firstScan       : BOOL;\n    modeChanged     : BOOL;\nEND_VAR\n\n    modeChanged := (mode <> prevMode);\n    fault := (mode < 0) OR (mode > 2) OR (scanSeconds <= 0.0) OR (scanSeconds > 10.0);\n\n    IF firstScan THEN\n        flowSP := manualFlowSP;\n        valveCommand := manualValve;\n        accT := 0.0;\n        accF := 0.0;\n        normalMode := FALSE;\n        firstScan := FALSE;\n        prevMode := mode;\n        prevResetBtn := resetBtn;\n        prevFlowSP := flowSP;\n        prevValveCmd := valveCommand;\n        RETURN;\n    END_IF;\n\n    IF resetBtn AND NOT prevResetBtn THEN\n        flowSP := manualFlowSP;\n        valveCommand := manualValve;\n        accT := 0.0;\n        accF := 0.0;\n        normalMode := FALSE;\n        prevMode := mode;\n        prevResetBtn := resetBtn;\n        prevFlowSP := flowSP;\n        prevValveCmd := valveCommand;\n        RETURN;\n    END_IF;\n\n    IF fault THEN\n        flowSP := manualFlowSP;\n        valveCommand := manualValve;\n        accT := 0.0;\n        accF := 0.0;\n        normalMode := FALSE;\n        prevMode := mode;\n        prevResetBtn := resetBtn;\n        prevFlowSP := flowSP;\n        prevValveCmd := valveCommand;\n        RETURN;\n    END_IF;\n\n    IF modeChanged THEN\n        IF mode = 2 THEN\n            flowSP := prevFlowSP;\n            valveCommand := prevValveCmd;\n        ELSIF mode = 0 THEN\n            flowSP := manualFlowSP;\n            valveCommand := manualValve;\n        ELSE\n            flowSP := manualFlowSP;\n            valveCommand := prevValveCmd;\n        END_IF;\n        normalMode := FALSE;\n        prevMode := mode;\n        prevResetBtn := resetBtn;\n        prevFlowSP := flowSP;\n        prevValveCmd := valveCommand;\n        RETURN;\n    END_IF;\n\n    normalMode := TRUE;\n\n    IF mode = 2 THEN\n        accT := accT + 0.2 * (tempSP - tempPV) * scanSeconds;\n        flowSP := 1.0 * (tempSP - tempPV) + accT;\n        flowSP := LIMIT(0.0, flowSP, 50.0);\n        accT := flowSP - 1.0 * (tempSP - tempPV);\n        accF := accF + 0.5 * (flowSP - flowPV) * scanSeconds;\n        valveCommand := 2.0 * (flowSP - flowPV) + accF;\n        valveCommand := LIMIT(0.0, valveCommand, 100.0);\n        accF := valveCommand - 2.0 * (flowSP - flowPV);\n    ELSIF mode = 1 THEN\n        flowSP := manualFlowSP;\n        accF := accF + 0.5 * (flowSP - flowPV) * scanSeconds;\n        valveCommand := 2.0 * (flowSP - flowPV) + accF;\n        valveCommand := LIMIT(0.0, valveCommand, 100.0);\n        accF := valveCommand - 2.0 * (flowSP - flowPV);\n    ELSE\n        flowSP := manualFlowSP;\n        valveCommand := manualValve;\n    END_IF;\n\n    prevMode := mode;\n    prevResetBtn := resetBtn;\n    prevFlowSP := flowSP;\n    prevValveCmd := valveCommand;\n\nEND_FUNCTION_BLOCK",
