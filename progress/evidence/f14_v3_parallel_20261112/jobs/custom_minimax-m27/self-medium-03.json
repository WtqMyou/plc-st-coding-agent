      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL;\n    motorDown  : BOOL;\n    errorFlag  : BOOL;\nEND_VAR\nVAR\n    state        : INT;\n    prevOpenBtn  : BOOL;\n    prevCloseBtn : BOOL;\n    prevObstacle : BOOL;\n    prevMotorUp  : BOOL;\n    prevMotorDown: BOOL;\n    prevErrorFlag: BOOL;\nEND_VAR\nVAR_CONSTANT\n    IDLE    : INT := 0;\n    OPENING : INT := 1;\n    CLOSING : INT := 2;\n    FAULT   : INT := 3;\nEND_VAR\n\n    // Rising edge detection\n    VAR\n        openRising   : BOOL;\n        closeRising  : BOOL;\n        doubleRising : BOOL;\n    END_VAR\n    openRising   := openBtn AND NOT prevOpenBtn;\n    closeRising  := closeBtn AND NOT prevCloseBtn;\n    doubleRising := (openBtn AND closeBtn) AND NOT (prevOpenBtn AND prevCloseBtn);\n\n    // State transitions\n    CASE state OF\n    IDLE:\n        // Clear fault on double-button rising edge when no obstacle\n        IF doubleRising AND NOT obstacle THEN\n            errorFlag := FALSE;\n        END_IF;\n\n        // Start opening: new rising edge on openBtn, closeBtn not held, no open limit\n        IF openRising AND NOT closeBtn AND NOT openLimit AND NOT errorFlag THEN\n            state    := OPENING;\n            motorUp  := TRUE;\n            motorDown:= FALSE;\n        // Start closing: new rising edge on closeBtn, openBtn not held, no close limit\n        ELSIF closeRising AND NOT openBtn AND NOT closeLimit AND NOT errorFlag THEN\n            state    := CLOSING;\n            motorUp  := FALSE;\n            motorDown:= TRUE;\n        ELSE\n            motorUp  := FALSE;\n            motorDown:= FALSE;\n        END_IF;\n\n    OPENING:\n        // Obstacle detected: enter FAULT immediately\n        IF obstacle THEN\n            state     := FAULT;\n            errorFlag := TRUE;\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        // Open limit reached: stop and return to IDLE\n        ELSIF openLimit THEN\n            state     := IDLE;\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSE\n            motorUp   := TRUE;\n            motorDown := FALSE;\n        END_IF;\n\n    CLOSING:\n        // Obstacle detected: enter FAULT immediately\n        IF obstacle THEN\n            state     := FAULT;\n            errorFlag := TRUE;\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        // Close limit reached: stop and return to IDLE\n        ELSIF closeLimit THEN\n            state     := IDLE;\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSE\n            motorUp   := FALSE;\n            motorDown := TRUE;\n        END_IF;\n\n    FAULT:\n        // Latched: stay in FAULT unless double-button rising edge appears with no obstacle\n        IF prevErrorFlag AND NOT obstacle AND doubleRising THEN\n            state     := IDLE;\n            errorFlag := FALSE;\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        ELSE\n            errorFlag := TRUE;\n            motorUp   := FALSE;\n            motorDown := FALSE;\n        END_IF;\n    END_CASE;\n\n    // Latch error flag once set (overrides any later state logic)\n    IF errorFlag THEN\n        motorUp   := FALSE;\n        motorDown := FALSE;\n    END_IF;\n\n    // Update previous-cycle state for next scan\n    prevOpenBtn   := openBtn;\n    prevCloseBtn  := closeBtn;\n    prevObstacle  := obstacle;\n    prevMotorUp   := motorUp;\n    prevMotorDown := motorDown;\n    prevErrorFlag := errorFlag;\nEND_FUNCTION_BLOCK",
