      "idx": 1,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn   : BOOL;\n    closeBtn  : BOOL;\n    openLimit : BOOL;\n    closeLimit: BOOL;\n    obstacle  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp   : BOOL;\n    motorDown : BOOL;\n    errorFlag : BOOL;\nEND_VAR\nVAR\n    state        : INT;\n    prevOpenBtn  : BOOL;\n    prevCloseBtn : BOOL;\n    prevObstacle : BOOL;\n    prevErrorFlag: BOOL;\nEND_VAR\n\n    // Sample inputs\n    VAR\n        openRising  : BOOL;\n        closeRising : BOOL;\n        bothRising  : BOOL;\n    END_VAR\n    openRising  := openBtn AND NOT prevOpenBtn;\n    closeRising := closeBtn AND NOT prevCloseBtn;\n    bothRising  := (openBtn AND closeBtn) AND NOT (prevOpenBtn AND prevCloseBtn);\n\n    // Initialize outputs to off\n    motorUp   := FALSE;\n    motorDown := FALSE;\n\n    // Obstacle handling has highest priority in all states\n    IF obstacle THEN\n        state     := 3; // FAULT\n        errorFlag := TRUE;\n        motorUp   := FALSE;\n        motorDown := FALSE;\n    ELSE\n        CASE state OF\n        0: // IDLE\n            // Reset fault with dual-button rising edge while obstacle clear\n            IF prevErrorFlag AND bothRising THEN\n                errorFlag := FALSE;\n                state    := 0;\n            ELSE\n                errorFlag := FALSE;\n            END_IF;\n            // Start opening: rising edge on openBtn, closeBtn not pressed, not at open limit\n            IF openRising AND NOT closeBtn AND NOT openLimit THEN\n                state    := 1; // OPENING\n                motorUp  := TRUE;\n            // Start closing: rising edge on closeBtn, openBtn not pressed, not at close limit\n            ELSIF closeRising AND NOT openBtn AND NOT closeLimit THEN\n                state    := 2; // CLOSING\n                motorDown:= TRUE;\n            END_IF;\n\n        1: // OPENING\n            // Stop when open limit reached\n            IF openLimit THEN\n                state  := 0;\n            ELSE\n                motorUp := TRUE;\n            END_IF;\n\n        2: // CLOSING\n            // Stop when close limit reached\n            IF closeLimit THEN\n                state    := 0;\n            ELSE\n                motorDown := TRUE;\n            END_IF;\n\n        3: // FAULT\n            errorFlag := TRUE;\n            // Clear fault only when no obstacle and dual-button rising edge appears\n            IF prevErrorFlag AND bothRising THEN\n                state    := 0;\n                errorFlag := FALSE;\n            END_IF;\n        END_CASE;\n    END_IF;\n\n    // Update previous-cycle samples\n    prevOpenBtn   := openBtn;\n    prevCloseBtn  := closeBtn;\n    prevObstacle  := obstacle;\n    prevErrorFlag := errorFlag;\nEND_FUNCTION_BLOCK",
