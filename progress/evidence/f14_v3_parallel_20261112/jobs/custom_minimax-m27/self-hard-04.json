      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    demand   : INT;\n    runHours : ARRAY[1..5] OF LINT;\n    rotated  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    leadPump     : INT := 0;\n    lagPump      : INT := 0;\n    runningCount : INT := 0;\nEND_VAR\nVAR\n    prevDemand     : INT  := -1;\n    prevLead       : INT  := 0;\n    prevLag        : INT  := 0;\n    prevRunning    : INT  := 0;\n    firstPositive  : BOOL := FALSE;\nEND_VAR\nVAR_TEMP\n    i           : INT;\n    minHours    : LINT;\n    minIdx      : INT;\n    minHours2   : LINT;\n    minIdx2     : INT;\n    adjDemand   : INT;\n    leadChanged : BOOL;\n    runInc      : BOOL;\nEND_VAR\n\n// ── 裁剪需求台数 ──────────────────────────────────────────────────\nIF demand < 0 THEN\n    adjDemand := 0;\nELSIF demand > 5 THEN\n    adjDemand := 5;\nELSE\n    adjDemand := demand;\nEND_IF;\n\n// ── 首次调用：初始化 prevDemand ──────────────────────────────────\nIF prevDemand = -1 THEN\n    prevDemand := adjDemand;\nEND_IF;\n\n// ── 需求为 0：清空主备 ───────────────────────────────────────────\nIF adjDemand = 0 THEN\n    leadPump     := 0;\n    lagPump      := 0;\n    runningCount := 0;\n    prevLead     := 0;\n    prevLag      := 0;\n    prevRunning  := 0;\n    firstPositive := FALSE;\n    prevDemand    := 0;\n    RETURN;\nEND_IF;\n\n// ── 主泵选择 ──────────────────────────────────────────────────────\n// 初始选择：首次正需求\nIF firstPositive THEN\n    minHours := runHours[1];\n    minIdx   := 1;\n    FOR i := 2 TO 5 DO\n        IF runHours[i] < minHours OR (runHours[i] = minHours AND i < minIdx) THEN\n            minHours := runHours[i];\n            minIdx   := i;\n        END_IF;\n    END_FOR;\n    leadPump := minIdx;\n// 迟滞换主：轮换请求有效 且 原主泵工时比全场最短严格多 50h 以上\nELSIF rotated AND prevLead <> 0 THEN\n    minHours := runHours[1];\n    minIdx   := 1;\n    FOR i := 2 TO 5 DO\n        IF runHours[i] < minHours OR (runHours[i] = minHours AND i < minIdx) THEN\n            minHours := runHours[i];\n            minIdx   := i;\n        END_IF;\n    END_FOR;\n    IF runHours[prevLead] - minHours > 50 THEN\n        leadPump := minIdx;\n    ELSE\n        leadPump := prevLead;\n    END_IF;\nELSE\n    leadPump := prevLead;\nEND_IF;\n\n// ── 辅助标记 ──────────────────────────────────────────────────────\nleadChanged := (leadPump <> prevLead);\nrunInc      := (adjDemand > prevRunning);\n\n// ── 备泵选择（仅「初选、换主、运行台数上升」时重选）──────────────\nIF adjDemand >= 2 THEN\n    IF lagPump = 0 OR leadChanged OR runInc THEN\n        minHours2 := LINT#16#7FFFFFFFFFFFFFFF;\n        minIdx2   := 0;\n        FOR i := 1 TO 5 DO\n            IF i <> leadPump THEN\n                IF runHours[i] < minHours2 OR (runHours[i] = minHours2 AND i < minIdx2) THEN\n                    minHours2 := runHours[i];\n                    minIdx2   := i;\n                END_IF;\n            END_IF;\n        END_FOR;\n        lagPump := minIdx2;\n    ELSE\n        lagPump := prevLag;\n    END_IF;\nELSE\n    lagPump := 0;\nEND_IF;\n\n// ── 运行台数 & 状态快照 ──────────────────────────────────────────\nrunningCount  := adjDemand;\nfirstPositive := FALSE;\nprevLead      := leadPump;\nprevLag       := lagPump;\nprevRunning   := runningCount;\nprevDemand    := adjDemand;\nEND_FUNCTION_BLOCK",
