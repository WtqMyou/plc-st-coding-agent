      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    demand     : INT;\n    runHours   : ARRAY[1..5] OF LINT;\n    rotated    : BOOL;\nEND_VAR\nVAR_OUTPUT\n    leadPump     : INT := 0;\n    lagPump      : INT := 0;\n    runningCount : INT := 0;\nEND_VAR\nVAR\n    prevDemand   : INT  := 0;\n    prevLead     : INT  := 0;\n    prevLag      : INT  := 0;\n    prevRunning  : INT  := 0;\nEND_VAR\n\nVAR_TEMP\n    i            : INT;\n    minHours     : LINT;\n    minIdx       : INT;\n    minHours2    : LINT;\n    minIdx2      : INT;\n    adjDemand    : INT;\n    leadChanged  : BOOL;\n    runInc       : BOOL;\nEND_VAR\n\n// ── 1. 裁剪需求台数 ──────────────────────────────────────────────\nIF demand < 0 THEN\n    adjDemand := 0;\nELSIF demand > 5 THEN\n    adjDemand := 5;\nELSE\n    adjDemand := demand;\nEND_IF;\n\n// ── 2. 需求归零 → 立即清除主备 ───────────────────────────────────\nIF adjDemand = 0 THEN\n    leadPump     := 0;\n    lagPump      := 0;\n    runningCount := 0;\n    prevDemand   := 0;\n    prevLead     := 0;\n    prevLag      := 0;\n    prevRunning  := 0;\n    RETURN;\nEND_IF;\n\n// ── 3. 主泵选择 ──────────────────────────────────────────────────\n// 初选：上次主泵为空（需求从 0 恢复）\nIF prevLead = 0 THEN\n    minHours := runHours[1];\n    minIdx   := 1;\n    FOR i := 2 TO 5 DO\n        IF runHours[i] < minHours OR (runHours[i] = minHours AND i < minIdx) THEN\n            minHours := runHours[i];\n            minIdx   := i;\n        END_IF;\n    END_FOR;\n    leadPump := minIdx;\n// 轮换请求有效且迟滞条件满足时换主\nELSIF rotated THEN\n    // 找全场（工时，泵号）最小者\n    minHours := runHours[1];\n    minIdx   := 1;\n    FOR i := 2 TO 5 DO\n        IF runHours[i] < minHours OR (runHours[i] = minHours AND i < minIdx) THEN\n            minHours := runHours[i];\n            minIdx   := i;\n        END_IF;\n    END_FOR;\n    // 迟滞：本拍主泵工时比最短工时严格多 50h 以上\n    IF runHours[prevLead] - minHours > 50 THEN\n        leadPump := minIdx;\n    ELSE\n        leadPump := prevLead;\n    END_IF;\nELSE\n    // 无请求且有主泵 → 保持\n    leadPump := prevLead;\nEND_IF;\n\n// ── 4. 辅助标记 ──────────────────────────────────────────────────\nleadChanged := (leadPump <> prevLead);\nrunInc      := (adjDemand > prevRunning);\n\n// ── 5. 备泵选择（仅在「初选、换主、运行台数上升」时重选）─────────\nIF adjDemand >= 2 THEN\n    // 初选：lagPump 仍为 0\n    // 换主或台数上升：lagPump 需要刷新\n    IF lagPump = 0 OR leadChanged OR runInc THEN\n        // 找除主泵外（工时，泵号）最小者\n        minHours2 := LINT#16#7FFFFFFFFFFFFFFF;  // 最大值\n        minIdx2   := 0;\n        FOR i := 1 TO 5 DO\n            IF i <> leadPump THEN\n                IF runHours[i] < minHours2 OR (runHours[i] = minHours2 AND i < minIdx2) THEN\n                    minHours2 := runHours[i];\n                    minIdx2   := i;\n                END_IF;\n            END_IF;\n        END_FOR;\n        lagPump := minIdx2;\n    ELSE\n        // 主泵未变且台数未升 → 保持原备泵（S9 约束）\n        lagPump := prevLag;\n    END_IF;\nELSE\n    // 需求 1 台 → 无备泵\n    lagPump := 0;\nEND_IF;\n\n// ── 6. 运行台数 & 状态快照 ───────────────────────────────────────\nrunningCount := adjDemand;\nprevDemand   := adjDemand;\nprevLead     := leadPump;\nprevLag      := lagPump;\nprevRunning  := runningCount;\nEND_FUNCTION_BLOCK",
