      "code": "FUNCTION_BLOCK FB_MovingAverage\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    average : LREAL;\n    windowSizeReached : BOOL;\n    error : BOOL;\n    status : WORD;\nEND_VAR\n\nVAR\n    dataBuffer : ARRAY[1..100] OF LREAL;\n    sum : LREAL;\n    count : INT;\n    writeIndex : INT;\n    lastTrigger : BOOL;\n    lastReset : BOOL;\n    initValid : BOOL;\nEND_VAR\n\n// Reset handling\nIF reset AND NOT lastReset THEN\n    sum := 0.0;\n    count := 0;\n    writeIndex := 0;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    error := FALSE;\n    status := 16#0000;\n    initValid := FALSE;\nEND_IF;\nlastReset := reset;\n\n// Validate window size on first execution or when reset was just released\nIF NOT initValid THEN\n    IF windowSize < 1 OR windowSize > 100 THEN\n        error := TRUE;\n        status := 16#8200;\n        RETURN;\n    ELSE\n        error := FALSE;\n        status := 16#0000;\n        initValid := TRUE;\n    END_IF;\nEND_IF;\n\n// Check for cyclic execution mode\nIF cyclicExecution THEN\n    // Validate window size on each cycle\n    IF windowSize < 1 OR windowSize > 100 THEN\n        error := TRUE;\n        status := 16#8200;\n        RETURN;\n    ELSE\n        error := FALSE;\n        status := 16#0000;\n    END_IF;\n    \n    // Process new value\n    IF count >= windowSize THEN\n        sum := sum - dataBuffer[writeIndex + 1];\n    ELSE\n        count := count + 1;\n    END_IF;\n    \n    writeIndex := (writeIndex MOD windowSize) + 1;\n    dataBuffer[writeIndex] := value;\n    sum := sum + value;\n    \n    IF count >= windowSize THEN\n        windowSizeReached := TRUE;\n    ELSE\n        windowSizeReached := FALSE;\n    END_IF;\n    \n    average := sum / INT_TO_LREAL(count);\n    lastTrigger := FALSE;\n    RETURN;\nEND_IF;\n\n// Check for rising edge on trigger\nIF trigger AND NOT lastTrigger THEN\n    // Validate window size\n    IF windowSize < 1 OR windowSize > 100 THEN\n        error := TRUE;\n        status := 16#8200;\n        lastTrigger := trigger;\n        RETURN;\n    ELSE\n        error := FALSE;\n        status := 16#0000;\n    END_IF;\n    \n    // Process new value\n    IF count >= windowSize THEN\n        sum := sum - dataBuffer[writeIndex + 1];\n    ELSE\n        count := count + 1;\n    END_IF;\n    \n    writeIndex := (writeIndex MOD windowSize) + 1;\n    dataBuffer[writeIndex] := value;\n    sum := sum + value;\n    \n    IF count >= windowSize THEN\n        windowSizeReached := TRUE;\n    ELSE\n        windowSizeReached := FALSE;\n    END_IF;\n    \n    average := sum / INT_TO_LREAL(count);\nEND_IF;\n\nlastTrigger := trigger;\nEND_FUNCTION_BLOCK",
