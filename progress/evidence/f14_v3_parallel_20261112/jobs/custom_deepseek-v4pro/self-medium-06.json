      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    resetBtn : BOOL;\n    sensorValid : BOOL;\n    setpoint : REAL;\n    temperature : REAL;\n    scanSeconds : REAL;\n    bias : REAL;\nEND_VAR\nVAR_OUTPUT\n    power : REAL;\n    correction : REAL;\n    fault : BOOL;\nEND_VAR\nVAR\n    ePrev : REAL := 0.0;\n    historyValid : BOOL := FALSE;\n    prevResetBtn : BOOL := FALSE;\n    e : REAL;\n    de : REAL;\n    x : REAL;\n    y : REAL;\n    muN_x : REAL;\n    muZ_x : REAL;\n    muP_x : REAL;\n    muN_y : REAL;\n    muZ_y : REAL;\n    muP_y : REAL;\n    sumW : REAL;\n    sumWC : REAL;\n    risingReset : BOOL;\nEND_VAR\n\nfault := NOT sensorValid OR (scanSeconds <= 0.0) OR (scanSeconds > 10.0);\nrisingReset := resetBtn AND NOT prevResetBtn;\ne := setpoint - temperature;\n\nIF (NOT enable) OR fault OR risingReset THEN\n    power := 0.0;\n    correction := 0.0;\n    ePrev := 0.0;\n    historyValid := FALSE;\nELSE\n    IF historyValid THEN\n        de := (e - ePrev) / scanSeconds;\n    ELSE\n        de := 0.0;\n    END_IF;\n\n    x := e / 10.0;\n    IF x < -1.0 THEN\n        x := -1.0;\n    ELSIF x > 1.0 THEN\n        x := 1.0;\n    END_IF;\n\n    y := de / 2.0;\n    IF y < -1.0 THEN\n        y := -1.0;\n    ELSIF y > 1.0 THEN\n        y := 1.0;\n    END_IF;\n\n    muN_x := MAX(-x, 0.0);\n    muZ_x := 1.0 - ABS(x);\n    muP_x := MAX(x, 0.0);\n\n    muN_y := MAX(-y, 0.0);\n    muZ_y := 1.0 - ABS(y);\n    muP_y := MAX(y, 0.0);\n\n    sumW := (muN_x * muN_y) + (muN_x * muZ_y) + (muN_x * muP_y)\n          + (muZ_x * muN_y) + (muZ_x * muZ_y) + (muZ_x * muP_y)\n          + (muP_x * muN_y) + (muP_x * muZ_y) + (muP_x * muP_y);\n\n    sumWC := (muN_x * muN_y * (-30.0)) + (muN_x * muZ_y * (-20.0)) + (muN_x * muP_y * (-10.0))\n           + (muZ_x * muN_y * (-10.0)) + (muZ_x * muZ_y * 0.0) + (muZ_x * muP_y * 10.0)\n           + (muP_x * muN_y * 10.0) + (muP_x * muZ_y * 20.0) + (muP_x * muP_y * 30.0);\n\n    IF sumW = 0.0 THEN\n        correction := 0.0;\n    ELSE\n        correction := sumWC / sumW;\n    END_IF;\n\n    power := LIMIT(0.0, bias + correction, 100.0);\n\n    ePrev := e;\n    historyValid := TRUE;\nEND_IF;\n\nprevResetBtn := resetBtn;\n\nEND_FUNCTION_BLOCK",
