      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    abortBtn : BOOL;\n    setpoint : REAL;\n    pv : REAL;\n    maxDuration : INT;\nEND_VAR\nVAR_OUTPUT\n    elapsed : INT := 0;\n    phase : INT := 0;\n    timeout : BOOL := FALSE;\nEND_VAR\nVAR\n    lastStartBtn : BOOL := FALSE;\n    prevPhase : INT := 0;\n    prevElapsed : INT := 0;\n    prevTimeout : BOOL := FALSE;\n    risingStart : BOOL;\nEND_VAR\n\n// 捕获上一拍输出值\nprevPhase := phase;\nprevElapsed := elapsed;\nprevTimeout := timeout;\n\n// 检测启动上升沿（基于上一拍 lastStartBtn）\nrisingStart := startBtn AND NOT lastStartBtn;\n\n// 优先级：中止 > 新启动沿 > 运行计数/保持\nIF abortBtn THEN\n    // 中止：进入9，冻结计数与超时标志\n    phase := 9;\n    elapsed := prevElapsed;\n    timeout := prevTimeout;\nELSIF risingStart THEN\n    // 有效新启动：启动拍不计数\n    phase := 1;\n    elapsed := 0;\n    timeout := FALSE;\nELSE\n    // 无中止、无新启动沿\n    IF (prevPhase = 1) OR (prevPhase = 2) THEN\n        // 上一拍运行态，先计数一拍\n        elapsed := prevElapsed + 1;\n\n        IF elapsed >= maxDuration THEN\n            // 达到超时门槛：完成态3\n            timeout := TRUE;\n            phase := 3;\n        ELSE\n            // 未超时，处理升温/保温\n            timeout := FALSE;\n\n            IF prevPhase = 1 THEN\n                IF pv >= setpoint THEN\n                    phase := 2; // 升温达标转保温\n                ELSE\n                    phase := 1; // 继续升温\n                END_IF;\n            ELSE\n                // prevPhase = 2，保持保温\n                phase := 2;\n            END_IF;\n        END_IF;\n    ELSE\n        // 上一拍非运行态（0、3、9），保持原状态\n        phase := prevPhase;\n        elapsed := prevElapsed;\n        timeout := prevTimeout;\n    END_IF;\nEND_IF;\n\n// 更新上一拍启动按钮状态\nlastStartBtn := startBtn;\n\nEND_FUNCTION_BLOCK",
