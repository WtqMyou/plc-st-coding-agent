      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    demand : INT;\n    runHours : ARRAY[1..5] OF LINT;\n    rotated : BOOL;\nEND_VAR\nVAR_OUTPUT\n    leadPump : INT;\n    lagPump : INT;\n    runningCount : INT;\nEND_VAR\nVAR\n    prevLeadPump : INT := 0;\n    prevLagPump : INT := 0;\n    prevRunningCount : INT := 0;\n    clampedDemand : INT;\n    minPump : INT;\n    i : INT;\nEND_VAR\n\n// 裁剪需求\nIF demand < 0 THEN\n    clampedDemand := 0;\nELSIF demand > 5 THEN\n    clampedDemand := 5;\nELSE\n    clampedDemand := demand;\nEND_IF;\n\nrunningCount := clampedDemand;\n\n// 计算全场最短工时泵（工时，泵号）最小\nminPump := 1;\nFOR i := 2 TO 5 DO\n    IF (runHours[i] < runHours[minPump]) OR (runHours[i] = runHours[minPump] AND i < minPump) THEN\n        minPump := i;\n    END_IF;\nEND_FOR;\n\n// 主泵选择\nIF clampedDemand = 0 THEN\n    leadPump := 0;\n    lagPump := 0;\nELSE\n    // 需求 > 0\n    IF prevLeadPump = 0 THEN\n        // 初选\n        leadPump := minPump;\n    ELSE\n        // 已有主泵\n        IF rotated AND (runHours[prevLeadPump] - runHours[minPump] > 50) THEN\n            leadPump := minPump;\n        ELSE\n            leadPump := prevLeadPump;\n        END_IF;\n    END_IF;\n\n    // 备泵选择\n    IF clampedDemand < 2 THEN\n        lagPump := 0;\n    ELSE\n        // 需求 >= 2\n        IF (leadPump <> prevLeadPump) OR (clampedDemand > prevRunningCount) THEN\n            // 重新选择备泵（排除当前主泵）\n            lagPump := 0;\n            FOR i := 1 TO 5 DO\n                IF i <> leadPump THEN\n                    IF lagPump = 0 THEN\n                        lagPump := i;\n                    ELSE\n                        IF (runHours[i] < runHours[lagPump]) OR (runHours[i] = runHours[lagPump] AND i < lagPump) THEN\n                            lagPump := i;\n                        END_IF;\n                    END_IF;\n                END_IF;\n            END_FOR;\n        ELSE\n            lagPump := prevLagPump;\n        END_IF;\n    END_IF;\nEND_IF;\n\n// 更新上一拍状态\nprevLeadPump := leadPump;\nprevLagPump := lagPump;\nprevRunningCount := runningCount;\n\nEND_FUNCTION_BLOCK",
