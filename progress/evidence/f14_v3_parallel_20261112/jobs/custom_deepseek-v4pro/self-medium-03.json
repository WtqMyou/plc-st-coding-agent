      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn : BOOL;\n    closeBtn : BOOL;\n    openLimit : BOOL;\n    closeLimit : BOOL;\n    obstacle : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp : BOOL;\n    motorDown : BOOL;\n    errorFlag : BOOL;\nEND_VAR\nVAR\n    state : INT := 0; (* 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT *)\n    preOpenBtn : BOOL := FALSE;\n    preCloseBtn : BOOL := FALSE;\n    risingOpen : BOOL;\n    risingClose : BOOL;\n    combo : BOOL;\n    preCombo : BOOL;\n    risingCombo : BOOL;\nEND_VAR\n\n(* 计算上升沿 *)\nrisingOpen := openBtn AND NOT preOpenBtn;\nrisingClose := closeBtn AND NOT preCloseBtn;\ncombo := openBtn AND closeBtn;\npreCombo := preOpenBtn AND preCloseBtn;\nrisingCombo := combo AND NOT preCombo;\n\nIF obstacle THEN\n    (* 障碍优先：任何状态立即停机并置故障 *)\n    state := 3;\n    motorUp := FALSE;\n    motorDown := FALSE;\n    errorFlag := TRUE;\nELSE\n    IF state = 3 THEN\n        (* 无障碍时的故障处理 *)\n        IF risingCombo THEN\n            (* 双键组合新上升沿：人工复位 *)\n            state := 0;\n            motorUp := FALSE;\n            motorDown := FALSE;\n            errorFlag := FALSE;\n        ELSE\n            (* 保持故障锁存 *)\n            motorUp := FALSE;\n            motorDown := FALSE;\n            errorFlag := TRUE;\n        END_IF;\n    ELSE\n        (* 非故障状态 *)\n        IF (state = 1 AND openLimit) OR (state = 2 AND closeLimit) THEN\n            (* 到达本方向限位：停机回IDLE *)\n            state := 0;\n            motorUp := FALSE;\n            motorDown := FALSE;\n            errorFlag := FALSE;\n        ELSE\n            IF state = 1 THEN\n                (* 开门运行中 *)\n                motorUp := TRUE;\n                motorDown := FALSE;\n                errorFlag := FALSE;\n                (* state 保持 1 *)\n            ELSIF state = 2 THEN\n                (* 关门运行中 *)\n                motorUp := FALSE;\n                motorDown := TRUE;\n                errorFlag := FALSE;\n                (* state 保持 2 *)\n            ELSE\n                (* IDLE状态 *)\n                IF risingOpen AND NOT closeBtn AND NOT openLimit THEN\n                    state := 1;\n                    motorUp := TRUE;\n                    motorDown := FALSE;\n                    errorFlag := FALSE;\n                ELSIF risingClose AND NOT openBtn AND NOT closeLimit THEN\n                    state := 2;\n                    motorUp := FALSE;\n                    motorDown := TRUE;\n                    errorFlag := FALSE;\n                ELSE\n                    motorUp := FALSE;\n                    motorDown := FALSE;\n                    errorFlag := FALSE;\n                    state := 0; (* 保持IDLE *)\n                END_IF;\n            END_IF;\n        END_IF;\n    END_IF;\nEND_IF;\n\n(* 更新上一拍按钮状态 *)\npreOpenBtn := openBtn;\npreCloseBtn := closeBtn;\n\nEND_FUNCTION_BLOCK",
      "code_hash": "61a3bc11e92a1f413a6948b8af3c3fb439c5784fd003731094bb023b6cfd2cce",
