      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    resetBtn : BOOL;\n    doneSensor : BOOL;\n    targetVol : REAL;\n    flowVol : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen : BOOL;\n    fillsToday : INT;\nEND_VAR\nVAR\n    prevStart : BOOL := FALSE;\n    prevReset : BOOL := FALSE;\n    pendingConfirm : BOOL := FALSE;\n    accVol : REAL := 0.0;\n    startRising : BOOL;\n    resetRising : BOOL;\nEND_VAR\n\n// 上升沿检测\nstartRising := startBtn AND NOT prevStart;\nresetRising := resetBtn AND NOT prevReset;\n\nIF resetRising THEN\n    // 复位优先：清零计数和累计，关阀并清除待确认\n    fillsToday := 0;\n    accVol := 0.0;\n    valveOpen := FALSE;\n    pendingConfirm := FALSE;\nELSE\n    // 启动处理（空闲或等待确认时）\n    IF startRising AND NOT valveOpen THEN\n        accVol := 0.0;\n        valveOpen := TRUE;\n        pendingConfirm := FALSE; // 取消上一瓶待确认\n    END_IF;\n\n    // 灌装累加与达标关阀\n    IF valveOpen THEN\n        accVol := accVol + flowVol;\n        IF accVol >= targetVol THEN\n            valveOpen := FALSE;\n            pendingConfirm := TRUE;\n        END_IF;\n    END_IF;\n\n    // 确认计数（去抖与饱和处理）\n    IF pendingConfirm AND doneSensor THEN\n        IF fillsToday < 32767 THEN\n            fillsToday := fillsToday + 1;\n        END_IF;\n        pendingConfirm := FALSE; // 立即清除待确认\n    END_IF;\nEND_IF;\n\n// 更新边沿记忆\nprevStart := startBtn;\nprevReset := resetBtn;\n\nEND_FUNCTION_BLOCK",
