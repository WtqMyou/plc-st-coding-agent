      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    pushEn : BOOL;\n    pushItem : INT;\n    popEn : BOOL;\nEND_VAR\nVAR_IN_OUT\n    fifo : ARRAY[1..8] OF INT;\nEND_VAR\nVAR_OUTPUT\n    count : INT;\n    full : BOOL;\n    empty : BOOL;\n    head : INT;\nEND_VAR\nVAR\n    prevPush : BOOL := FALSE;\n    prevPop : BOOL := FALSE;\n    prevCount : INT := 0;\n    oldF : ARRAY[1..8] OF INT;\n    newArr : ARRAY[1..8] OF INT;\n    risingPush : BOOL;\n    risingPop : BOOL;\n    popAct : BOOL;\n    pushAct : BOOL;\n    afterPopCount : INT;\n    newCount : INT;\n    i : INT;\nEND_VAR\n\nrisingPush := pushEn AND NOT prevPush;\nrisingPop := popEn AND NOT prevPop;\n\nFOR i := 1 TO 8 DO\n    oldF[i] := fifo[i];\nEND_FOR;\n\npopAct := risingPop AND (prevCount > 0);\n\nIF popAct THEN\n    afterPopCount := prevCount - 1;\nELSE\n    afterPopCount := prevCount;\nEND_IF;\n\npushAct := risingPush AND (afterPopCount < 8);\n\nIF pushAct THEN\n    newCount := afterPopCount + 1;\nELSE\n    newCount := afterPopCount;\nEND_IF;\n\nFOR i := 1 TO 8 DO\n    newArr[i] := 0;\nEND_FOR;\n\nIF popAct THEN\n    IF pushAct THEN\n        FOR i := 1 TO prevCount - 1 DO\n            newArr[i] := oldF[i + 1];\n        END_FOR;\n        newArr[prevCount] := pushItem;\n    ELSE\n        FOR i := 1 TO prevCount - 1 DO\n            newArr[i] := oldF[i + 1];\n        END_FOR;\n    END_IF;\nELSE\n    IF pushAct THEN\n        FOR i := 1 TO prevCount DO\n            newArr[i] := oldF[i];\n        END_FOR;\n        newArr[prevCount + 1] := pushItem;\n    ELSE\n        FOR i := 1 TO prevCount DO\n            newArr[i] := oldF[i];\n        END_FOR;\n    END_IF;\nEND_IF;\n\nFOR i := 1 TO 8 DO\n    fifo[i] := newArr[i];\nEND_FOR;\n\nIF newCount > 0 THEN\n    head := newArr[1];\nELSE\n    head := 0;\nEND_IF;\n\ncount := newCount;\nfull := (newCount = 8);\nempty := (newCount = 0);\n\nprevPush := pushEn;\nprevPop := popEn;\nprevCount := newCount;\nEND_FUNCTION_BLOCK",
