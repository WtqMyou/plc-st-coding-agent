      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest : BOOL;\n    flameOK : BOOL;\n    o2Valid : BOOL;\n    o2PV : REAL;\n    baseAir : REAL;\n    resetBtn : BOOL;\nEND_VAR\nVAR_OUTPUT\n    fuelPermit : BOOL;\n    trimEnable : BOOL;\n    airTrim : REAL;\n    airCommand : REAL;\n    tripLatched : BOOL;\n    o2Fault : BOOL;\nEND_VAR\nVAR\n    prevReset : BOOL;\n    tripMem : BOOL;\n    risingReset : BOOL;\n    rawTrim : REAL;\n    cmdRaw : REAL;\nEND_VAR\n\nrisingReset := resetBtn AND NOT prevReset;\n\nIF (runRequest AND NOT flameOK) OR (tripMem AND NOT (risingReset AND NOT runRequest AND NOT flameOK)) THEN\n    tripLatched := TRUE;\n    tripMem := TRUE;\nELSE\n    tripLatched := FALSE;\n    tripMem := FALSE;\nEND_IF;\n\nfuelPermit := runRequest AND flameOK AND NOT tripLatched;\n\no2Fault := (NOT o2Valid) OR (o2PV < 0.0) OR (o2PV > 21.0);\n\ntrimEnable := fuelPermit AND NOT o2Fault;\n\nIF NOT trimEnable THEN\n    airTrim := 0.0;\nELSE\n    rawTrim := 2.0 * (2.0 - o2PV);\n    IF rawTrim < -10.0 THEN\n        airTrim := -10.0;\n    ELSIF rawTrim > 10.0 THEN\n        airTrim := 10.0;\n    ELSE\n        airTrim := rawTrim;\n    END_IF;\nEND_IF;\n\nIF NOT fuelPermit THEN\n    airCommand := 0.0;\nELSE\n    cmdRaw := baseAir + airTrim;\n    IF cmdRaw < 0.0 THEN\n        airCommand := 0.0;\n    ELSIF cmdRaw > 100.0 THEN\n        airCommand := 100.0;\n    ELSE\n        airCommand := cmdRaw;\n    END_IF;\nEND_IF;\n\nprevReset := resetBtn;\n\nEND_FUNCTION_BLOCK",
