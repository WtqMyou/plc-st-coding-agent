      "idx": 0,
      "code": "TYPE AutoState : (IDLE, MOVING_TO_B, WAIT_B, MOVING_TO_C, WAIT_C);\nEND_TYPE;\n\nFUNCTION_BLOCK ProductionLineControl\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorA : BOOL;\n    SensorB : BOOL;\n    SensorC : BOOL;\n    ButtonA : BOOL;\n    ButtonB : BOOL;\n    ButtonC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    CompletionLight : BOOL;\nEND_VAR\nVAR\n    State : AutoState := IDLE;\n    CompletionLatched : BOOL := FALSE;\nEND_VAR\n\nMotorForward := FALSE;\nMotorReverse := FALSE;\nCompletionLight := FALSE;\n\nIF NOT Mode THEN\n    State := IDLE;\n    CompletionLatched := FALSE;\n\n    IF ForwardButton AND NOT ReverseButton THEN\n        MotorForward := TRUE;\n    ELSIF ReverseButton AND NOT ForwardButton THEN\n        MotorReverse := TRUE;\n    END_IF;\nELSE\n    CASE State OF\n        IDLE:\n            IF SensorA AND ButtonA THEN\n                State := MOVING_TO_B;\n            ELSIF SensorB THEN\n                State := WAIT_B;\n            ELSIF SensorC THEN\n                State := WAIT_C;\n            END_IF;\n\n        MOVING_TO_B:\n            IF SensorB THEN\n                State := WAIT_B;\n            END_IF;\n\n        WAIT_B:\n            IF NOT SensorB THEN\n                State := IDLE;\n            ELSIF ButtonB THEN\n                State := MOVING_TO_C;\n            END_IF;\n\n        MOVING_TO_C:\n            IF SensorC THEN\n                State := WAIT_C;\n            END_IF;\n\n        WAIT_C:\n            IF SensorC AND ButtonC THEN\n                CompletionLatched := TRUE;\n            END_IF;\n\n            IF NOT SensorC THEN\n                State := IDLE;\n                CompletionLatched := FALSE;\n            END_IF;\n    END_CASE;\n\n    MotorForward := (State = MOVING_TO_B) OR (State = MOVING_TO_C);\n    CompletionLight := CompletionLatched AND SensorC;\nEND_IF;\nEND_FUNCTION_BLOCK",
      "code_hash": "e964347f3baa78fedc342b9bd9c401bd3b55c2c35347e2157b61d316022d9598",
