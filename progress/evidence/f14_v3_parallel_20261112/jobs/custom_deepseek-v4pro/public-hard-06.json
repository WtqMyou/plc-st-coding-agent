      "idx": 1,
      "code": "TYPE T_PRODUCTION_STATE :\n(\n    IDLE,\n    MOVING_FEED_TO_WASH,\n    AT_WASH,\n    MOVING_WASH_TO_WEIGHT,\n    AT_WEIGHT_WAIT,\n    AT_WEIGHT_REJECT,\n    MOVING_WEIGHT_TO_FIRING,\n    AT_FIRING,\n    MOVING_FIRING_TO_OUTPUT,\n    AT_OUTPUT\n);\nEND_TYPE;\n\nFUNCTION_BLOCK ProductionControl\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorFeed : BOOL;\n    SensorWash : BOOL;\n    SensorWeight : BOOL;\n    SensorFiring : BOOL;\n    SensorOutput : BOOL;\n    washComplete : BOOL;\n    weightComplete : BOOL;\n    weight : REAL;\n    firingComplete : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    kick : BOOL;\n    CompletionLight : BOOL;\n    firingTemp : REAL;\nEND_VAR\nVAR\n    currentState : T_PRODUCTION_STATE := IDLE;\nEND_VAR\n\nIF Mode = FALSE THEN\n    // Manual mode\n    IF ForwardButton AND NOT ReverseButton THEN\n        MotorForward := TRUE;\n        MotorReverse := FALSE;\n    ELSIF ReverseButton AND NOT ForwardButton THEN\n        MotorForward := FALSE;\n        MotorReverse := TRUE;\n    ELSE\n        MotorForward := FALSE;\n        MotorReverse := FALSE;\n    END_IF;\n    // Reset all automatic outputs and state\n    kick := FALSE;\n    CompletionLight := FALSE;\n    firingTemp := 0.0;\n    currentState := IDLE;\nELSE\n    // Automatic mode\n    // Set default outputs for this scan\n    MotorReverse := FALSE;\n    MotorForward := FALSE;\n    kick := FALSE;\n    CompletionLight := FALSE;\n    // firingTemp retains its last calculated value unless updated in qualified weighing\n\n    CASE currentState OF\n        IDLE:\n            IF SensorFeed THEN\n                currentState := MOVING_FEED_TO_WASH;\n                MotorForward := TRUE;\n            END_IF;\n\n        MOVING_FEED_TO_WASH:\n            MotorForward := TRUE;\n            IF SensorWash THEN\n                MotorForward := FALSE;\n                currentState := AT_WASH;\n            END_IF;\n\n        AT_WASH:\n            IF washComplete THEN\n                MotorForward := TRUE;\n                currentState := MOVING_WASH_TO_WEIGHT;\n            END_IF;\n\n        MOVING_WASH_TO_WEIGHT:\n            MotorForward := TRUE;\n            IF SensorWeight THEN\n                MotorForward := FALSE;\n                currentState := AT_WEIGHT_WAIT;\n            END_IF;\n\n        AT_WEIGHT_WAIT:\n            IF weightComplete THEN\n                IF (weight >= 100.0) AND (weight <= 200.0) THEN\n                    // Qualified material\n                    firingTemp := 500.0 + (weight - 100.0) * 0.5;\n                    MotorForward := TRUE;\n                    currentState := MOVING_WEIGHT_TO_FIRING;\n                ELSE\n                    // Unqualified material\n                    kick := TRUE;\n                    currentState := AT_WEIGHT_REJECT;\n                END_IF;\n            END_IF;\n\n        AT_WEIGHT_REJECT:\n            kick := TRUE;\n            IF NOT SensorWeight THEN\n                kick := FALSE;\n                currentState := IDLE;\n            END_IF;\n\n        MOVING_WEIGHT_TO_FIRING:\n            MotorForward := TRUE;\n            IF SensorFiring THEN\n                MotorForward := FALSE;\n                currentState := AT_FIRING;\n            END_IF;\n\n        AT_FIRING:\n            IF firingComplete THEN\n                MotorForward := TRUE;\n                currentState := MOVING_FIRING_TO_OUTPUT;\n            END_IF;\n\n        MOVING_FIRING_TO_OUTPUT:\n            MotorForward := TRUE;\n            IF SensorOutput THEN\n                MotorForward := FALSE;\n                currentState := AT_OUTPUT;\n            END_IF;\n\n        AT_OUTPUT:\n            CompletionLight := TRUE;\n            IF NOT SensorOutput THEN\n                CompletionLight := FALSE;\n                currentState := IDLE;\n            END_IF;\n    END_CASE;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
