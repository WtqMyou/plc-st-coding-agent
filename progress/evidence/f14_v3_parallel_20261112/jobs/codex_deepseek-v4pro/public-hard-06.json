      "code": "FUNCTION_BLOCK ProductionControl\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorFeed : BOOL;\n    SensorWash : BOOL;\n    SensorWeight : BOOL;\n    SensorFiring : BOOL;\n    SensorOutput : BOOL;\n    washComplete : BOOL;\n    weightComplete : BOOL;\n    weight : REAL;\n    firingComplete : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    kick : BOOL;\n    CompletionLight : BOOL;\n    firingTemp : REAL;\nEND_VAR\nVAR CONSTANT\n    ST_IDLE : INT := 0;\n    ST_MOVE_WASH : INT := 1;\n    ST_AT_WASH : INT := 2;\n    ST_MOVE_WEIGHT : INT := 3;\n    ST_AT_WEIGHT : INT := 4;\n    ST_REJECTED : INT := 5;\n    ST_MOVE_FIRING : INT := 6;\n    ST_AT_FIRING : INT := 7;\n    ST_MOVE_OUTPUT : INT := 8;\n    ST_AT_OUTPUT : INT := 9;\nEND_VAR\nVAR\n    state : INT := 0;\nEND_VAR\n\nMotorForward := FALSE;\nMotorReverse := FALSE;\nkick := FALSE;\nCompletionLight := FALSE;\n\nIF NOT Mode THEN\n    IF ForwardButton AND NOT ReverseButton THEN\n        MotorForward := TRUE;\n    ELSIF ReverseButton AND NOT ForwardButton THEN\n        MotorReverse := TRUE;\n    END_IF;\n    firingTemp := 0.0;\nELSE\n    CASE state OF\n        ST_IDLE:\n            IF SensorFeed THEN\n                MotorForward := TRUE;\n                state := ST_MOVE_WASH;\n            END_IF;\n\n        ST_MOVE_WASH:\n            MotorForward := TRUE;\n            IF SensorWash THEN\n                MotorForward := FALSE;\n                state := ST_AT_WASH;\n            END_IF;\n\n        ST_AT_WASH:\n            IF washComplete THEN\n                MotorForward := TRUE;\n                state := ST_MOVE_WEIGHT;\n            END_IF;\n\n        ST_MOVE_WEIGHT:\n            MotorForward := TRUE;\n            IF SensorWeight THEN\n                MotorForward := FALSE;\n                state := ST_AT_WEIGHT;\n            END_IF;\n\n        ST_AT_WEIGHT:\n            IF weightComplete THEN\n                IF (weight >= 100.0) AND (weight <= 200.0) THEN\n                    firingTemp := 500.0 + ((weight - 100.0) * 50.0) / 100.0;\n                    MotorForward := TRUE;\n                    state := ST_MOVE_FIRING;\n                ELSE\n                    kick := TRUE;\n                    state := ST_REJECTED;\n                END_IF;\n            END_IF;\n\n        ST_REJECTED:\n            kick := TRUE;\n            IF NOT SensorWeight THEN\n                kick := FALSE;\n                state := ST_IDLE;\n            END_IF;\n\n        ST_MOVE_FIRING:\n            MotorForward := TRUE;\n            IF SensorFiring THEN\n                MotorForward := FALSE;\n                state := ST_AT_FIRING;\n            END_IF;\n\n        ST_AT_FIRING:\n            IF firingComplete THEN\n                MotorForward := TRUE;\n                state := ST_MOVE_OUTPUT;\n            END_IF;\n\n        ST_MOVE_OUTPUT:\n            MotorForward := TRUE;\n            IF SensorOutput THEN\n                MotorForward := FALSE;\n                CompletionLight := TRUE;\n                state := ST_AT_OUTPUT;\n            END_IF;\n\n        ST_AT_OUTPUT:\n            CompletionLight := TRUE;\n            IF NOT SensorOutput THEN\n                CompletionLight := FALSE;\n                state := ST_IDLE;\n            END_IF;\n    END_CASE;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
