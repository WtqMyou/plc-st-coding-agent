FUNCTION_BLOCK AerationBlowerDelayedStart
VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR
VAR_OUTPUT
    BLOWER_RUN : BOOL;
    AERATION_BLOWER_CYCLE_COUNT : UINT;
END_VAR
VAR
    StartTimer : TON;
    LastBlowerRun : BOOL := FALSE;
END_VAR

StartTimer(IN := (DO_LOW AND AERATION_E_STOP_NC), PT := T#5S);

BLOWER_RUN := StartTimer.Q;

IF BLOWER_RUN AND NOT LastBlowerRun THEN
    AERATION_BLOWER_CYCLE_COUNT := TO_UINT(AERATION_BLOWER_CYCLE_COUNT + 1);
END_IF;

LastBlowerRun := BLOWER_RUN;

END_FUNCTION_BLOCK