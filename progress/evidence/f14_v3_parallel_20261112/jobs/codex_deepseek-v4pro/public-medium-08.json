      "code": "FUNCTION_BLOCK IPv4Parser\nVAR_INPUT\n    ipText : STRING(254);\nEND_VAR\nVAR_OUTPUT\n    ipValue : UDINT;\nEND_VAR\nVAR\n    bValid : BOOL;\n    iPos : INT;\n    iLength : INT;\n    iCharCode : INT;\n    uiCurrentValue : UDINT;\n    uiDigitCount : UDINT;\n    uiCompletedSegments : UDINT;\n    uiAddress : UDINT;\nEND_VAR\n\nipValue := 0;\nuiAddress := 0;\nuiCurrentValue := 0;\nuiDigitCount := 0;\nuiCompletedSegments := 0;\nbValid := TRUE;\niLength := LEN(ipText);\n\nIF (iLength > 0) AND (iLength <= 15) THEN\n    FOR iPos := 1 TO iLength BY 1 DO\n        iCharCode := BYTE_TO_INT(ipText[iPos]);\n\n        IF (iCharCode >= 48) AND (iCharCode <= 57) THEN\n            uiCurrentValue := uiCurrentValue * 10 + INT_TO_UDINT(iCharCode - 48);\n            uiDigitCount := uiDigitCount + 1;\n\n            IF uiCurrentValue > 255 THEN\n                bValid := FALSE;\n                EXIT;\n            END_IF;\n\n        ELSIF iCharCode = 46 THEN\n            IF (uiDigitCount = 0) OR (uiCompletedSegments >= 3) THEN\n                bValid := FALSE;\n                EXIT;\n            END_IF;\n\n            uiAddress := uiAddress * 256 + uiCurrentValue;\n            uiCompletedSegments := uiCompletedSegments + 1;\n            uiCurrentValue := 0;\n            uiDigitCount := 0;\n\n        ELSE\n            bValid := FALSE;\n            EXIT;\n        END_IF;\n    END_FOR;\nELSE\n    bValid := FALSE;\nEND_IF;\n\nIF bValid THEN\n    IF (uiDigitCount = 0) OR (uiCompletedSegments <> 3) THEN\n        bValid := FALSE;\n    ELSE\n        uiAddress := uiAddress * 256 + uiCurrentValue;\n        ipValue := uiAddress;\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
