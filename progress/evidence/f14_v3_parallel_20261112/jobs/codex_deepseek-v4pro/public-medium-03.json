      "code": "FUNCTION_BLOCK FB_MovingAverage\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    average : LREAL;\n    windowSizeReached : BOOL;\n    error : BOOL;\n    status : WORD;\nEND_VAR\nVAR\n    history : ARRAY[0..99] OF LREAL;\n    historyCount : INT;\n    historyIndex : INT;\n    activeCount : INT;\n    total : LREAL;\n    startIndex : INT;\n    i : INT;\n    triggerPrevious : BOOL;\nEND_VAR\n\nerror := FALSE;\nstatus := 16#0000;\n\nIF (windowSize < 1) OR (windowSize > 100) THEN\n    error := TRUE;\n    status := 16#8200;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    historyCount := 0;\n    historyIndex := 0;\nELSIF reset THEN\n    historyCount := 0;\n    historyIndex := 0;\n    activeCount := 0;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    error := FALSE;\n    status := 16#0000;\nELSIF cyclicExecution OR (trigger AND NOT triggerPrevious) THEN\n    history[historyIndex] := value;\n    historyIndex := historyIndex + 1;\n    IF historyIndex >= 100 THEN\n        historyIndex := 0;\n    END_IF;\n\n    IF historyCount < 100 THEN\n        historyCount := historyCount + 1;\n    END_IF;\n\n    activeCount := historyCount;\n    IF activeCount > windowSize THEN\n        activeCount := windowSize;\n    END_IF;\n\n    IF activeCount > 0 THEN\n        startIndex := (historyIndex - activeCount + 100) MOD 100;\n        total := 0.0;\n\n        FOR i := 0 TO activeCount - 1 DO\n            total := total + history[startIndex];\n            startIndex := startIndex + 1;\n            IF startIndex >= 100 THEN\n                startIndex := 0;\n            END_IF;\n        END_FOR;\n\n        average := total / INT_TO_LREAL(activeCount);\n    ELSE\n        average := 0.0;\n    END_IF;\n\n    windowSizeReached := historyCount >= windowSize;\nEND_IF;\n\ntriggerPrevious := trigger;\n\nEND_FUNCTION_BLOCK",
