      "code": "FUNCTION_BLOCK FB_MovingAverage\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    average : LREAL;\n    windowSizeReached : BOOL;\n    error : BOOL;\n    status : WORD;\nEND_VAR\nVAR\n    buffer : ARRAY[0..99] OF LREAL;\n    sampleCount : INT;\n    writePosition : INT;\n    bufferSum : LREAL;\n    triggerPrevious : BOOL;\nEND_VAR\n\nerror := FALSE;\nstatus := 16#0000;\n\nIF (windowSize < 1) OR (windowSize > 100) THEN\n    error := TRUE;\n    status := 16#8200;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    sampleCount := 0;\n    writePosition := 0;\n    bufferSum := 0.0;\nELSIF reset THEN\n    sampleCount := 0;\n    writePosition := 0;\n    bufferSum := 0.0;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    error := FALSE;\n    status := 16#0000;\nELSIF cyclicExecution OR (trigger AND NOT triggerPrevious) THEN\n    IF sampleCount < windowSize THEN\n        buffer[sampleCount] := value;\n        sampleCount := sampleCount + 1;\n    ELSE\n        bufferSum := bufferSum - buffer[writePosition];\n        buffer[writePosition] := value;\n        writePosition := writePosition + 1;\n        IF writePosition >= windowSize THEN\n            writePosition := 0;\n        END_IF;\n    END_IF;\n\n    bufferSum := bufferSum + value;\n    windowSizeReached := sampleCount >= windowSize;\n\n    IF sampleCount > 0 THEN\n        average := bufferSum / INT_TO_LREAL(sampleCount);\n    ELSE\n        average := 0.0;\n    END_IF;\nEND_IF;\n\ntriggerPrevious := trigger;\n\nEND_FUNCTION_BLOCK",
