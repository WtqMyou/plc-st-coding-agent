45,PUB046,PUB047,PUB048]\n*)\nVAR\n    tmpRisingStart : BOOL;\n    tmpPrevPhase   : INT;\nEND_VAR\n\ntmpRisingStart := startBtn AND NOT prevStartBtn;\ntmpPrevPhase   := phase;\n\nIF abortBtn THEN\n    phase   := 9;\n    elapsed := elapsed;\n    timeout := timeout;\nELSIF tmpRisingStart THEN\n    elapsed := 0;\n    timeout := FALSE;\n    phase   := 1;\nELSE\n    IF (tmpPrevPhase = 1) OR (tmpPrevPhase = 2) THEN\n        elapsed := elapsed + 1;\n        IF elapsed >= maxDuration THEN\n            timeout := TRUE;\n            phase   := 3;\n        ELSIF tmpPrevPhase = 1 THEN\n            IF pv >= setpoint THEN\n                phase := 2;\n            ELSE\n                phase := 1;\n            END_IF;\n        ELSE\n            phase := 2;\n        END_IF;\n    ELSE\n        phase := tmpPrevPhase;\n    END_IF;\nEND_IF;\n\nprevStartBtn := startBtn;\nEND_FUNCTION_BLOCK\n(* CONTRACT_RULES [] *)",
