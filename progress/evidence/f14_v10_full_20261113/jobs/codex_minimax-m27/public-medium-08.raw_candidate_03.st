  --patch "*** Begin Patch\n*** Update File: E:\\PLC_Dev\\evidence\\real_experiments\\f14_v10_full_20261113\\cli_private\\ee35760ddffe45d99850d3a9dd357ba5\\IPv4_Parse.st\n@@ \n (* ENGINEERING_CONTRACT\n   PUB001: Parse dotted-decimal IPv4, validate 4 numeric segments 0-255\n   PUB002: Network byte order assembly (MSB=first segment)\n   PUB003: Invalid input → ipValue=0 (malformed, nondigit, wrong count, OOR)\n   PUB004: Valid 0.0.0.0 also produces 0 (by assembly)\n   \n   State retention: None (stateless function block)\n   Reset behavior: None (no reset input specified)\n   First scan: Same as subsequent (no edge memory)\n*)\n\n(* CONTRACT_RULES [] *)\n\nFUNCTION_BLOCK IPv4_Parse\nVAR_INPUT\n    ipText : STRING(254);\nEND_VAR\nVAR_OUTPUT\n    ipValue : UDINT := 0;\nEND_VAR\nVAR\n    tmp_pos : UDINT;\n    tmp_seg_idx : UDINT;\n    tmp_char : BYTE;\n    tmp_seg_val : UDINT;\n    tmp_result : UDINT;\n    tmp_prev_was_sep : BOOL;\n    tmp_digit_accumulated : BOOL;\nEND_VAR\n\ntmp_pos := 0;\ntmp_seg_idx := 0;\ntmp_result := 0;\ntmp_seg_val := 0;\ntmp_prev_was_sep := FALSE;\ntmp_digit_accumulated := FALSE;\n\nWHILE tmp_pos < LEN(ipText) DO\n    tmp_char := ipText[tmp_pos];\n    \n    IF tmp_char >= 48 AND tmp_char <= 57 THEN\n        tmp_seg_val := tmp_seg_val * 10 + TO_UDINT(tmp_char - 48);\n        \n        IF tmp_seg_val > 255 THEN\n            ipValue := 0;\n            RETURN;\n        END_IF;\n        \n        tmp_digit_accumulated := TRUE;\n        tmp_prev_was_sep := FALSE;\n        tmp_pos := tmp_pos + 1;\n        \n    ELSIF tmp_char = 46 THEN\n        // Separator: reject if leading, trailing, or consecutive\n        IF tmp_prev_was_sep OR NOT tmp_digit_accumulated THEN\n            ipValue := 0;\n            RETURN;\n        END_IF;\n        \n        IF tmp_seg_idx >= 3 THEN\n            ipValue := 0;\n            RETURN;\n        END_IF;\n        \n        CASE tmp_seg_idx OF\n            0: tmp_result := SHL(tmp_seg_val, 24);\n            1: tmp_result := tmp_result OR SHL(tmp_seg_val, 16);\n            2: tmp_result := tmp_result OR SHL(tmp_seg_val, 8);\n            3: tmp_result := tmp_result OR tmp_seg_val;\n        END_CASE;\n        \n        tmp_seg_idx := tmp_seg_idx + 1;\n        tmp_seg_val := 0;\n        tmp_prev_was_sep := TRUE;\n        tmp_digit_accumulated := FALSE;\n        tmp_pos := tmp_pos + 1;\n        \n    ELSE\n        ipValue := 0;\n        RETURN;\n    END_IF;\nEND_WHILE;\n\n// Reject trailing separator\nIF tmp_prev_was_sep OR NOT tmp_digit_accumulated THEN\n    ipValue := 0;\n    RETURN;\nEND_IF;\n\nIF tmp_seg_idx <> 3 THEN\n    ipValue := 0;\nELSE\n    tmp_result := tmp_result OR tmp_seg_val;\n    ipValue := tmp_result;\nEND_IF;\n\nEND_FUNCTION_BLOCK"
