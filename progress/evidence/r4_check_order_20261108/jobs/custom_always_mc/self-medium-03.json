      "idx": 1,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn    : BOOL;\n    closeBtn   : BOOL;\n    openLimit  : BOOL;\n    closeLimit : BOOL;\n    obstacle   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    motorUp    : BOOL;\n    motorDown  : BOOL;\n    errorFlag  : BOOL;\nEND_VAR\nVAR\n    state        : INT;\n    prevOpenBtn  : BOOL;\n    prevCloseBtn : BOOL;\n    openRising   : BOOL;\n    closeRising  : BOOL;\nEND_VAR\n\n// Detect rising edges\nopenRising  := openBtn AND NOT prevOpenBtn;\ncloseRising := closeBtn AND NOT prevCloseBtn;\nprevOpenBtn  := openBtn;\nprevCloseBtn := closeBtn;\n\nCASE state OF\n    0: // IDLE\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        errorFlag := FALSE;\n\n        // Accept commands only when not in fault\n        IF NOT errorFlag THEN\n            IF openRising AND NOT openLimit THEN\n                state   := 1;        // OPENING\n                motorUp := TRUE;\n            ELSIF closeRising AND NOT closeLimit THEN\n                state      := 2;     // CLOSING\n                motorDown  := TRUE;\n            END_IF\n        END_IF\n\n    1: // OPENING\n        IF obstacle THEN\n            // Immediate stop and enter fault\n            motorUp   := FALSE;\n            motorDown := FALSE;\n            errorFlag := TRUE;\n            state     := 3;          // FAULT\n        ELSIF openLimit THEN\n            motorUp   := FALSE;\n            motorDown := FALSE;\n            errorFlag := FALSE;\n            state     := 0;          // IDLE\n        ELSE\n            motorUp   := TRUE;\n            motorDown := FALSE;\n            errorFlag := FALSE;\n        END_IF\n\n    2: // CLOSING\n        IF obstacle THEN\n            // Reverse direction immediately\n            motorUp   := TRUE;\n            motorDown := FALSE;\n            errorFlag := FALSE;\n            state     := 1;          // OPENING\n        ELSIF closeLimit THEN\n            motorDown := FALSE;\n            motorUp   := FALSE;\n            errorFlag := FALSE;\n            state     := 0;          // IDLE\n        ELSE\n            motorUp   := FALSE;\n            motorDown := TRUE;\n            errorFlag := FALSE;\n        END_IF\n\n    3: // FAULT\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        // Manual reset only when both buttons are pressed simultaneously\n        IF openBtn AND closeBtn THEN\n            errorFlag := FALSE;\n            state     := 0;          // IDLE\n        ELSE\n            errorFlag := TRUE;\n        END_IF\n\nELSE\n        // Invalid state – go to safe idle\n        state     := 0;\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        errorFlag := FALSE;\nEND_CASE\n\nEND_FUNCTION_BLOCK",
      "compiles": true,
