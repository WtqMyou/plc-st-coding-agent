      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    openBtn   : BOOL;\n    closeBtn  : BOOL;\n    openLimit : BOOL;\n    closeLimit: BOOL;\n    obstacle  : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    motorUp   : BOOL := FALSE;\n    motorDown : BOOL := FALSE;\n    errorFlag : BOOL := FALSE;\nEND_VAR\n\nVAR\n    state         : INT := 0;  // 0=IDLE, 1=OPENING, 2=CLOSING, 3=FAULT\n    prevOpenBtn   : BOOL := FALSE;\n    prevCloseBtn  : BOOL := FALSE;\n    obstacleSeen  : BOOL := FALSE;  // Latch: obstacle detected since last valid command\nEND_VAR\n\nVAR\n    openBtnRising  : BOOL;\n    closeBtnRising : BOOL;\nEND_VAR\n\n// Rising edge detection\nopenBtnRising  := openBtn AND NOT prevOpenBtn;\ncloseBtnRising := closeBtn AND NOT prevCloseBtn;\n\n// Update button history for next scan\nprevOpenBtn  := openBtn;\nprevCloseBtn := closeBtn;\n\n// State machine\nCASE state OF\n    0:  // IDLE\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        \n        // Clear obstacle latch when valid command starts\n        IF openBtnRising THEN\n            obstacleSeen := FALSE;\n        END_IF\n        IF closeBtnRising THEN\n            obstacleSeen := FALSE;\n        END_IF\n        \n        // Transitions: only if no obstacle seen since last valid command\n        IF openBtnRising AND NOT openLimit AND NOT obstacleSeen THEN\n            state := 1;  // -> OPENING\n        ELSIF closeBtnRising AND NOT closeLimit AND NOT obstacleSeen THEN\n            state := 2;  // -> CLOSING\n        END_IF\n        \n    1:  // OPENING\n        motorUp   := TRUE;\n        motorDown := FALSE;\n        \n        // Latch obstacle detection\n        IF obstacle THEN\n            obstacleSeen := TRUE;\n        END_IF\n        \n        // Check for openLimit OR obstacle\n        IF openLimit THEN\n            motorUp := FALSE;\n            state := 0;  // -> IDLE\n        ELSIF obstacle THEN\n            motorUp := FALSE;\n            errorFlag := TRUE;\n            state := 3;  // -> FAULT\n        END_IF\n        \n    2:  // CLOSING\n        motorUp   := FALSE;\n        motorDown := TRUE;\n        \n        // Check for obstacle\n        IF obstacle THEN\n            motorDown := FALSE;\n            state := 1;  // -> OPENING (reverse)\n        ELSIF closeLimit THEN\n            motorDown := FALSE;\n            state := 0;  // -> IDLE\n        END_IF\n        \n    3:  // FAULT\n        motorUp   := FALSE;\n        motorDown := FALSE;\n        // errorFlag remains latched\n        \n        // Manual reset: both buttons pressed simultaneously\n        IF openBtnRising AND closeBtnRising THEN\n            obstacleSeen := FALSE;\n            errorFlag := FALSE;\n            state := 0;  // -> IDLE\n        END_IF\nEND_CASE\nEND_FUNCTION_BLOCK",
      "compiles": true,
