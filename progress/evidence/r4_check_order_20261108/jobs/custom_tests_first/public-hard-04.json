      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue  : BOOL;\n    dequeue  : BOOL;\n    reset    : BOOL;\n    capacity : DINT;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT;\n    status       : WORD;\nEND_VAR\nVAR_IN_OUT\n    item   : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\nVAR\n    head        : DINT := 1;\n    tail        : DINT := 1;\n    count       : DINT := 0;\n    prevEnqueue : BOOL := FALSE;\n    prevDequeue : BOOL := FALSE;\nEND_VAR\n\n(* Reset takes priority *)\nIF reset THEN\n    count        := 0;\n    head         := 1;\n    tail         := 1;\n    elementCount := 0;\n    status       := 16#0000;\nELSE\n    (* Enqueue on rising edge *)\n    IF enqueue AND NOT prevEnqueue THEN\n        IF count < capacity THEN\n            buffer[tail] := item;\n            tail := tail + 1;\n            IF tail > capacity THEN\n                tail := 1;\n            END_IF;\n            count := count + 1;\n            status := 16#0000;\n        ELSE\n            status := 16#8002;\n        END_IF;\n    END_IF;\n\n    (* Dequeue on rising edge *)\n    IF dequeue AND NOT prevDequeue THEN\n        IF count > 0 THEN\n            item := buffer[head];\n            head := head + 1;\n            IF head > capacity THEN\n                head := 1;\n            END_IF;\n            count := count - 1;\n            status := 16#0000;\n        ELSE\n            status := 16#8001;\n        END_IF;\n    END_IF;\n\n    elementCount := count;\nEND_IF;\n\n(* Update edge detection history *)\nprevEnqueue := enqueue;\nprevDequeue := dequeue;\n\nEND_FUNCTION_BLOCK",
