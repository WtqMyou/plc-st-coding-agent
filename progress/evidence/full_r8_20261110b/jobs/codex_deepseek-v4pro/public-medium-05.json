      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorA : BOOL;\n    SensorB : BOOL;\n    SensorC : BOOL;\n    ButtonA : BOOL;\n    ButtonB : BOOL;\n    ButtonC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    CompletionLight : BOOL;\nEND_VAR\nVAR\n    AutoState : INT := 0;\n    AutoForward : BOOL;\n    ManualForward : BOOL;\n    ManualReverse : BOOL;\n    PrevMode : BOOL;\n    PrevMotorForward : BOOL;\n    PrevCompletionLight : BOOL;\nEND_VAR\n\nIF Mode THEN\n    ManualForward := FALSE;\n    ManualReverse := FALSE;\n\n    CASE AutoState OF\n        0:\n            IF SensorA AND ButtonA THEN\n                AutoState := 1;\n                AutoForward := TRUE;\n            ELSE\n                AutoForward := FALSE;\n            END_IF\n\n        1:\n            AutoForward := TRUE;\n            IF SensorB THEN\n                AutoState := 2;\n                AutoForward := FALSE;\n            END_IF\n\n        2:\n            AutoForward := FALSE;\n            IF SensorB AND ButtonB THEN\n                AutoState := 3;\n                AutoForward := TRUE;\n            END_IF\n\n        3:\n            AutoForward := TRUE;\n            IF SensorC THEN\n                AutoState := 4;\n                AutoForward := FALSE;\n            END_IF\n\n        4:\n            AutoForward := FALSE;\n    END_CASE\nELSE\n    AutoState := 0;\n    AutoForward := FALSE;\n    ManualForward := ForwardButton AND NOT ReverseButton;\n    ManualReverse := ReverseButton AND NOT ForwardButton;\nEND_IF\n\nMotorForward := AutoForward OR ManualForward;\nMotorReverse := ManualReverse AND NOT Mode AND NOT MotorForward;\n\nCompletionLight := Mode AND SensorC AND (PrevCompletionLight OR ButtonC);\n\nPrevMode := Mode;\nPrevMotorForward := MotorForward;\nPrevCompletionLight := CompletionLight;\n\nEND_FUNCTION_BLOCK",
