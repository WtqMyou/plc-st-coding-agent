      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger         : BOOL;\n    value           : LREAL;\n    windowSize      : INT;\n    reset           : BOOL;\nEND_VAR\nVAR_OUTPUT\n    average           : LREAL;\n    windowSizeReached : BOOL;\n    error             : BOOL;\n    status            : WORD;\nEND_VAR\nVAR\n    history      : ARRAY [0..99] OF LREAL;\n    head         : INT := 0;\n    storedCount  : INT := 0;\n    lastTrigger  : BOOL;\n    sampleNow    : BOOL;\n    sampleCount  : INT;\n    loopIndex    : INT;\n    ringIndex    : INT;\n    sum          : LREAL;\n    validWindow  : BOOL;\nEND_VAR\n\nsampleNow := cyclicExecution OR (trigger AND NOT lastTrigger);\nlastTrigger := trigger;\nvalidWindow := windowSize >= 1 AND windowSize <= 100;\n\nIF reset THEN\n    average := 0.0;\n    windowSizeReached := FALSE;\n    storedCount := 0;\n    head := 0;\n\n    IF validWindow THEN\n        error := FALSE;\n        status := 16#0000;\n    ELSE\n        error := TRUE;\n        status := 16#8200;\n    END_IF\n\nELSIF NOT validWindow THEN\n    error := TRUE;\n    status := 16#8200;\n\nELSE\n    error := FALSE;\n    status := 16#0000;\n\n    IF sampleNow THEN\n        IF head >= 99 THEN\n            head := 0;\n        ELSE\n            head := head + 1;\n        END_IF\n\n        history[head] := value;\n\n        IF storedCount < 100 THEN\n            storedCount := storedCount + 1;\n        END_IF\n    END_IF\n\n    windowSizeReached := storedCount >= windowSize;\n\n    IF storedCount < windowSize THEN\n        sampleCount := storedCount;\n    ELSE\n        sampleCount := windowSize;\n    END_IF\n\n    IF storedCount > 0 THEN\n        sum := 0.0;\n\n        FOR loopIndex := 0 TO sampleCount - 1 DO\n            ringIndex := head - loopIndex;\n\n            IF ringIndex < 0 THEN\n                ringIndex := ringIndex + 100;\n            END_IF\n\n            sum := sum + history[ringIndex];\n        END_FOR\n\n        average := sum / INT_TO_LREAL(sampleCount);\n    ELSE\n        average := 0.0;\n    END_IF\nEND_IF\nEND_FUNCTION_BLOCK",
