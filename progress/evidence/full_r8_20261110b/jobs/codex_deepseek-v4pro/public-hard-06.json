      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorFeed : BOOL;\n    SensorWash : BOOL;\n    SensorWeight : BOOL;\n    SensorFiring : BOOL;\n    SensorOutput : BOOL;\n    washComplete : BOOL;\n    weightComplete : BOOL;\n    weight : REAL;\n    firingComplete : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    kick : BOOL;\n    CompletionLight : BOOL;\n    firingTemp : REAL;\nEND_VAR\nVAR\n    state : INT := 0;\n    nextState : INT := 0;\n    autoForwardCmd : BOOL := FALSE;\n    manualForwardCmd : BOOL := FALSE;\n    manualReverseCmd : BOOL := FALSE;\n    tempValue : REAL := 0.0;\nEND_VAR\n\nkick := FALSE;\nCompletionLight := FALSE;\nautoForwardCmd := FALSE;\nmanualForwardCmd := FALSE;\nmanualReverseCmd := FALSE;\nnextState := state;\n\nIF Mode THEN\n    CASE state OF\n        0:\n            IF SensorFeed THEN\n                autoForwardCmd := TRUE;\n                nextState := 1;\n            END_IF;\n        1:\n            IF SensorWash THEN\n                nextState := 2;\n            ELSE\n                autoForwardCmd := TRUE;\n            END_IF;\n        2:\n            IF washComplete THEN\n                autoForwardCmd := TRUE;\n                nextState := 3;\n            END_IF;\n        3:\n            IF SensorWeight THEN\n                nextState := 4;\n            ELSE\n                autoForwardCmd := TRUE;\n            END_IF;\n        4:\n            IF weightComplete THEN\n                IF (weight >= 100.0) AND (weight <= 200.0) THEN\n                    tempValue := 500.0 + (weight - 100.0) * 0.5;\n                    autoForwardCmd := TRUE;\n                    nextState := 5;\n                ELSE\n                    kick := TRUE;\n                    nextState := 0;\n                END_IF;\n            END_IF;\n        5:\n            IF SensorFiring THEN\n                nextState := 6;\n            ELSE\n                autoForwardCmd := TRUE;\n            END_IF;\n        6:\n            IF firingComplete THEN\n                autoForwardCmd := TRUE;\n                nextState := 7;\n            END_IF;\n        7:\n            IF SensorOutput THEN\n                CompletionLight := TRUE;\n                nextState := 8;\n            ELSE\n                autoForwardCmd := TRUE;\n            END_IF;\n        8:\n            IF SensorOutput THEN\n                CompletionLight := TRUE;\n            ELSE\n                nextState := 0;\n            END_IF;\n    END_CASE;\n    state := nextState;\nELSE\n    manualForwardCmd := ForwardButton AND NOT ReverseButton;\n    manualReverseCmd := ReverseButton AND NOT ForwardButton;\nEND_IF;\n\nMotorForward := autoForwardCmd OR manualForwardCmd;\nMotorReverse := manualReverseCmd;\nfiringTemp := tempValue;\n\nEND_FUNCTION_BLOCK",
