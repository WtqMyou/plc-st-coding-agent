      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    processLength : USINT;\n    sensor1 : BOOL;\n    sensor2 : BOOL;\n    sensor3 : BOOL;\n    sensor4 : BOOL;\n    sensor5 : BOOL;\n    station1Start : BOOL;\n    station2Complete : BOOL;\n    station3Complete : BOOL;\n    station4Complete : BOOL;\n    processSequence : ARRAY[1..8] OF USINT;\nEND_VAR\nVAR_OUTPUT\n    conveyorLeft : BOOL;\n    conveyorRight : BOOL;\nEND_VAR\nVAR\n    idx : USINT := 0;\n    currentStation : USINT := 1;\n    running : BOOL := FALSE;\n    waiting : BOOL := FALSE;\n    target : USINT := 0;\n    tgtSensor : BOOL := FALSE;\n    completionEdge : BOOL := FALSE;\n    lastComp2 : BOOL := FALSE;\n    lastComp3 : BOOL := FALSE;\n    lastComp4 : BOOL := FALSE;\n    validLength : BOOL := FALSE;\nEND_VAR\n\nvalidLength := (processLength >= 1) AND (processLength <= 8);\n\nIF NOT validLength THEN\n    conveyorLeft := FALSE;\n    conveyorRight := FALSE;\n    running := FALSE;\n    waiting := FALSE;\nELSE\n    IF NOT running THEN\n        waiting := FALSE;\n        IF sensor1 AND station1Start THEN\n            idx := 1;\n            currentStation := 1;\n            running := TRUE;\n        END_IF\n    ELSE\n        IF waiting THEN\n            completionEdge := FALSE;\n            IF target = 2 THEN\n                completionEdge := station2Complete AND NOT lastComp2;\n            ELSIF target = 3 THEN\n                completionEdge := station3Complete AND NOT lastComp3;\n            ELSIF target = 4 THEN\n                completionEdge := station4Complete AND NOT lastComp4;\n            END_IF\n            IF completionEdge THEN\n                waiting := FALSE;\n                idx := idx + 1;\n                IF idx > processLength THEN\n                    running := FALSE;\n                    idx := 0;\n                    currentStation := 5;\n                END_IF\n            END_IF\n        ELSE\n            target := processSequence[idx];\n            tgtSensor := FALSE;\n            IF target = 2 THEN\n                tgtSensor := sensor2;\n            ELSIF target = 3 THEN\n                tgtSensor := sensor3;\n            ELSIF target = 4 THEN\n                tgtSensor := sensor4;\n            ELSIF target = 5 THEN\n                tgtSensor := sensor5;\n            END_IF\n            IF tgtSensor THEN\n                currentStation := target;\n                IF target = 5 THEN\n                    running := FALSE;\n                    idx := 0;\n                    waiting := FALSE;\n                ELSE\n                    waiting := TRUE;\n                END_IF\n            END_IF\n        END_IF\n    END_IF\n\n    conveyorLeft := FALSE;\n    conveyorRight := FALSE;\n    IF running AND NOT waiting THEN\n        target := processSequence[idx];\n        IF target > currentStation THEN\n            conveyorRight := TRUE;\n        ELSIF target < currentStation THEN\n            conveyorLeft := TRUE;\n        END_IF\n    END_IF\nEND_IF\n\nlastComp2 := station2Complete;\nlastComp3 := station3Complete;\nlastComp4 := station4Complete;\n\nEND_FUNCTION_BLOCK",
