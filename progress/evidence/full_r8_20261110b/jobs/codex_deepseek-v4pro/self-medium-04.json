      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    resetBtn : BOOL;\n    doneSensor : BOOL;\n    targetVol : REAL;\n    flowVol : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen : BOOL;\n    fillsToday : INT;\nEND_VAR\nVAR\n    accVol : REAL;\n    pendingConfirm : BOOL;\n    startPrev : BOOL;\n    resetPrev : BOOL;\n    startRising : BOOL;\n    resetRising : BOOL;\n    valveWasOpen : BOOL;\nEND_VAR\n\nstartRising := startBtn AND NOT startPrev;\nresetRising := resetBtn AND NOT resetPrev;\nvalveWasOpen := valveOpen;\n\nIF resetRising THEN\n    valveOpen := FALSE;\n    fillsToday := 0;\n    accVol := 0.0;\n    pendingConfirm := FALSE;\n\nELSIF startRising AND NOT valveWasOpen THEN\n    accVol := flowVol;\n    valveOpen := accVol < targetVol;\n    pendingConfirm := NOT valveOpen;\n\nELSIF valveWasOpen THEN\n    accVol := accVol + flowVol;\n    IF accVol < targetVol THEN\n        valveOpen := TRUE;\n        pendingConfirm := FALSE;\n    ELSE\n        valveOpen := FALSE;\n        pendingConfirm := TRUE;\n    END_IF\n\nELSIF pendingConfirm THEN\n    valveOpen := FALSE;\n    IF doneSensor THEN\n        IF fillsToday < 32767 THEN\n            fillsToday := fillsToday + 1;\n        END_IF\n        pendingConfirm := FALSE;\n        accVol := 0.0;\n    END_IF\n\nELSE\n    valveOpen := FALSE;\n    pendingConfirm := FALSE;\n    accVol := 0.0;\nEND_IF\n\nstartPrev := startBtn;\nresetPrev := resetBtn;\n\nEND_FUNCTION_BLOCK",
