      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest : BOOL;\n    flameOK    : BOOL;\n    o2Valid    : BOOL;\n    o2PV       : REAL;\n    baseAir    : REAL;\n    resetBtn   : BOOL;\nEND_VAR\nVAR_OUTPUT\n    fuelPermit  : BOOL;\n    trimEnable  : BOOL;\n    airTrim     : REAL;\n    airCommand  : REAL;\n    tripLatched : BOOL;\n    o2Fault     : BOOL;\nEND_VAR\nVAR\n    resetPrev   : BOOL;\n    resetRising : BOOL;\n    rawTrim     : REAL;\n    rawCommand  : REAL;\nEND_VAR\n\nresetRising := resetBtn AND NOT resetPrev;\n\nIF runRequest AND NOT flameOK THEN\n    tripLatched := TRUE;\nELSIF tripLatched AND resetRising AND NOT runRequest AND NOT flameOK THEN\n    tripLatched := FALSE;\nELSE\n    tripLatched := tripLatched;\nEND_IF\n\nfuelPermit := runRequest AND flameOK AND NOT tripLatched;\n\no2Fault := (NOT o2Valid) OR (o2PV < 0.0) OR (o2PV > 21.0);\n\ntrimEnable := fuelPermit AND NOT o2Fault;\n\nIF trimEnable THEN\n    rawTrim := 2.0 * (2.0 - o2PV);\n    IF rawTrim < -10.0 THEN\n        airTrim := -10.0;\n    ELSIF rawTrim > 10.0 THEN\n        airTrim := 10.0;\n    ELSE\n        airTrim := rawTrim;\n    END_IF\nELSE\n    airTrim := 0.0;\nEND_IF\n\nIF fuelPermit THEN\n    rawCommand := baseAir + airTrim;\n    IF rawCommand < 0.0 THEN\n        airCommand := 0.0;\n    ELSIF rawCommand > 100.0 THEN\n        airCommand := 100.0;\n    ELSE\n        airCommand := rawCommand;\n    END_IF\nELSE\n    airCommand := 0.0;\nEND_IF\n\nresetPrev := resetBtn;\n\nEND_FUNCTION_BLOCK",
