      "code": "TYPE E_FB_State : (IDLE, MOVING, WAIT_PROCESS, DONE) END_TYPE\nEND_TYPE\n\nFUNCTION_BLOCK FB\nVAR_INPUT\n    processLength : USINT;\n    sensor1 : BOOL;\n    sensor2 : BOOL;\n    sensor3 : BOOL;\n    sensor4 : BOOL;\n    sensor5 : BOOL;\n    station1Start : BOOL;\n    station2Complete : BOOL;\n    station3Complete : BOOL;\n    station4Complete : BOOL;\n    processSequence : ARRAY[1..8] OF USINT;\nEND_VAR\nVAR_OUTPUT\n    conveyorLeft : BOOL;\n    conveyorRight : BOOL;\nEND_VAR\nVAR\n    state : E_FB_State := IDLE;\n    currentStation : USINT := 1;\n    seqIndex : USINT := 1;\n    targetStation : USINT := 5;\n    lastStation1Start : BOOL := FALSE;\n    lastComplete2 : BOOL := FALSE;\n    lastComplete3 : BOOL := FALSE;\n    lastComplete4 : BOOL := FALSE;\nEND_VAR\n\n(* 默认输出 *)\nconveyorLeft := FALSE;\nconveyorRight := FALSE;\n\n(* 检查 processLength 有效性 *)\nIF (processLength < 1) OR (processLength > 8) THEN\n    state := IDLE;\n    currentStation := 1;\n    seqIndex := 1;\n    (* 输出保持 FALSE *)\nELSE\n    (* 状态转移 *)\n    IF (state = IDLE) OR (state = DONE) THEN\n        (* 检测启动上升沿，需 sensor1 有料 *)\n        IF (NOT lastStation1Start AND station1Start AND sensor1) THEN\n            seqIndex := 1;\n            currentStation := 1;\n            targetStation := processSequence[1];\n            state := MOVING;\n        END_IF\n    ELSIF state = MOVING THEN\n        (* 检测是否到达目标站 *)\n        CASE targetStation OF\n            2: IF sensor2 THEN\n                   currentStation := targetStation;\n                   IF targetStation = 5 THEN\n                       state := DONE;\n                   ELSE\n                       state := WAIT_PROCESS;\n                   END_IF\n               END_IF\n            3: IF sensor3 THEN\n                   currentStation := targetStation;\n                   IF targetStation = 5 THEN\n                       state := DONE;\n                   ELSE\n                       state := WAIT_PROCESS;\n                   END_IF\n               END_IF\n            4: IF sensor4 THEN\n                   currentStation := targetStation;\n                   IF targetStation = 5 THEN\n                       state := DONE;\n                   ELSE\n                       state := WAIT_PROCESS;\n                   END_IF\n               END_IF\n            5: IF sensor5 THEN\n                   currentStation := targetStation;\n                   state := DONE;\n               END_IF\n        END_CASE\n    ELSIF state = WAIT_PROCESS THEN\n        (* 检测加工完成上升沿 *)\n        IF (currentStation = 2 AND (NOT lastComplete2 AND station2Complete)) OR\n           (currentStation = 3 AND (NOT lastComplete3 AND station3Complete)) OR\n           (currentStation = 4 AND (NOT lastComplete4 AND station4Complete)) THEN\n            seqIndex := seqIndex + 1;\n            IF seqIndex <= processLength THEN\n                targetStation := processSequence[seqIndex];\n                state := MOVING;\n            ELSE\n                state := DONE;\n            END_IF\n        END_IF\n    END_IF\n\n    (* 根据最终状态设置输出 *)\n    IF state = MOVING THEN\n        IF targetStation > currentStation THEN\n            conveyorLeft := FALSE;\n            conveyorRight := TRUE;\n        ELSIF targetStation < currentStation THEN\n            conveyorLeft := TRUE;\n            conveyorRight := FALSE;\n        ELSE\n            conveyorLeft := FALSE;\n            conveyorRight := FALSE;\n        END_IF\n    ELSE\n        conveyorLeft := FALSE;\n        conveyorRight := FALSE;\n    END_IF\nEND_IF\n\n(* 更新边沿历史 *)\nlastStation1Start := station1Start;\nlastComplete2 := station2Complete;\nlastComplete3 := station3Complete;\nlastComplete4 := station4Complete;\n\nEND_FUNCTION_BLOCK",
