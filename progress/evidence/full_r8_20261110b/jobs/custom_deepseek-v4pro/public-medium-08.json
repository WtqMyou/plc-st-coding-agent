      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    ipText : STRING(254);\nEND_VAR\nVAR_OUTPUT\n    ipValue : UDINT;\nEND_VAR\nVAR\n    txtLen : INT;\n    idx : INT;\n    ch : STRING(1);\n    segCount : INT;\n    segValue : UDINT;\n    segDigits : INT;\n    valid : BOOL;\n    addrBytes : ARRAY[0..3] OF UDINT;\n    digitVal : INT;\n    segHasLeadingZero : BOOL;\nEND_VAR\n\nipValue := 0;\ntxtLen := LEN(ipText);\nIF txtLen < 7 OR txtLen > 15 THEN\n    RETURN;\nEND_IF;\n\nsegCount := 0;\nsegValue := 0;\nsegDigits := 0;\nvalid := TRUE;\nsegHasLeadingZero := FALSE;\naddrBytes[0] := 0;\naddrBytes[1] := 0;\naddrBytes[2] := 0;\naddrBytes[3] := 0;\n\nFOR idx := 1 TO txtLen DO\n    ch := MID(ipText, 1, idx);\n    IF ch = '.' THEN\n        IF (segDigits = 0) OR (segCount >= 3) THEN\n            valid := FALSE;\n            EXIT;\n        END_IF;\n        addrBytes[segCount] := segValue;\n        segCount := segCount + 1;\n        segValue := 0;\n        segDigits := 0;\n        segHasLeadingZero := FALSE;\n    ELSE\n        IF ch = '0' THEN\n            digitVal := 0;\n        ELSIF ch = '1' THEN\n            digitVal := 1;\n        ELSIF ch = '2' THEN\n            digitVal := 2;\n        ELSIF ch = '3' THEN\n            digitVal := 3;\n        ELSIF ch = '4' THEN\n            digitVal := 4;\n        ELSIF ch = '5' THEN\n            digitVal := 5;\n        ELSIF ch = '6' THEN\n            digitVal := 6;\n        ELSIF ch = '7' THEN\n            digitVal := 7;\n        ELSIF ch = '8' THEN\n            digitVal := 8;\n        ELSIF ch = '9' THEN\n            digitVal := 9;\n        ELSE\n            valid := FALSE;\n            EXIT;\n        END_IF;\n\n        IF segDigits = 0 THEN\n            IF digitVal = 0 THEN\n                segHasLeadingZero := TRUE;\n            ELSE\n                segHasLeadingZero := FALSE;\n            END_IF;\n        ELSE\n            IF segHasLeadingZero THEN\n                valid := FALSE;\n                EXIT;\n            END_IF;\n        END_IF;\n\n        segValue := segValue * 10 + digitVal;\n        IF segValue > 255 THEN\n            valid := FALSE;\n            EXIT;\n        END_IF;\n\n        segDigits := segDigits + 1;\n        IF segDigits > 3 THEN\n            valid := FALSE;\n            EXIT;\n        END_IF;\n    END_IF;\nEND_FOR;\n\nIF valid THEN\n    IF segDigits = 0 THEN\n        valid := FALSE;\n    ELSE\n        addrBytes[segCount] := segValue;\n        segCount := segCount + 1;\n    END_IF;\nEND_IF;\n\nIF valid AND (segCount = 4) THEN\n    ipValue := SHL(addrBytes[0], 24) OR SHL(addrBytes[1], 16) OR SHL(addrBytes[2], 8) OR addrBytes[3];\nELSE\n    ipValue := 0;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
