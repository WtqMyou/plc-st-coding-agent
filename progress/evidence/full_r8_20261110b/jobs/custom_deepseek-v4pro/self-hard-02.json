      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    abortBtn : BOOL;\n    setpoint : REAL;\n    pv : REAL;\n    maxDuration : INT;\nEND_VAR\nVAR_OUTPUT\n    elapsed : INT;\n    phase : INT;\n    timeout : BOOL;\nEND_VAR\nVAR\n    prev_start : BOOL := FALSE;\n    prev_phase : INT := 0;\n    prev_elapsed : INT := 0;\n    prev_timeout : BOOL := FALSE;\n    start_rising : BOOL;\nEND_VAR\n\nstart_rising := startBtn AND NOT prev_start;\n\nIF abortBtn THEN\n    phase := 9;\n    elapsed := prev_elapsed;\n    timeout := prev_timeout;\n    prev_start := startBtn;\n    prev_phase := phase;\n    prev_elapsed := elapsed;\n    prev_timeout := timeout;\nELSIF start_rising THEN\n    phase := 1;\n    elapsed := 0;\n    timeout := FALSE;\n    prev_start := startBtn;\n    prev_phase := phase;\n    prev_elapsed := elapsed;\n    prev_timeout := timeout;\nELSE\n    IF (prev_phase = 1) OR (prev_phase = 2) THEN\n        elapsed := prev_elapsed + 1;\n        IF maxDuration <= elapsed THEN\n            timeout := TRUE;\n            phase := 3;\n        ELSE\n            timeout := FALSE;\n            IF (prev_phase = 2) OR (pv >= setpoint) THEN\n                phase := 2;\n            ELSE\n                phase := 1;\n            END_IF;\n        END_IF;\n    ELSE\n        phase := prev_phase;\n        elapsed := prev_elapsed;\n        timeout := prev_timeout;\n    END_IF;\n    prev_start := startBtn;\n    prev_phase := phase;\n    prev_elapsed := elapsed;\n    prev_timeout := timeout;\nEND_IF;\nEND_FUNCTION_BLOCK",
