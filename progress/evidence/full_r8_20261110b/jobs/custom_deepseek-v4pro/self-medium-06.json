    {
      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable : BOOL;\n    resetBtn : BOOL;\n    sensorValid : BOOL;\n    setpoint : REAL;\n    temperature : REAL;\n    scanSeconds : REAL;\n    bias : REAL;\nEND_VAR\nVAR_OUTPUT\n    power : REAL;\n    correction : REAL;\n    fault : BOOL;\nEND_VAR\nVAR\n    lastReset : BOOL;\n    histValid : BOOL;\n    ePrev : REAL;\n    e : REAL;\n    de : REAL;\n    x : REAL;\n    y : REAL;\n    uxN : REAL;\n    uxZ : REAL;\n    uxP : REAL;\n    uyN : REAL;\n    uyZ : REAL;\n    uyP : REAL;\n    wSum : REAL;\n    wcSum : REAL;\n    resetRising : BOOL;\n    forceZero : BOOL;\nEND_VAR\n\n    fault := (NOT sensorValid) OR (scanSeconds <= 0.0) OR (scanSeconds > 10.0);\n    resetRising := resetBtn AND (NOT lastReset);\n    forceZero := (NOT enable) OR fault OR resetRising;\n\n    IF forceZero THEN\n        power := 0.0;\n        correction := 0.0;\n        histValid := FALSE;\n        ePrev := 0.0;\n    ELSE\n        e := setpoint - temperature;\n        IF histValid THEN\n            de := (e - ePrev) / scanSeconds;\n        ELSE\n            de := 0.0;\n        END_IF\n\n        x := LIMIT(-1.0, e / 10.0, 1.0);\n        y := LIMIT(-1.0, de / 2.0, 1.0);\n\n        uxN := MAX(-x, 0.0);\n        uxZ := 1.0 - ABS(x);\n        uxP := MAX(x, 0.0);\n        uyN := MAX(-y, 0.0);\n        uyZ := 1.0 - ABS(y);\n        uyP := MAX(y, 0.0);\n\n        wSum := uxN * uyN + uxN * uyZ + uxN * uyP\n              + uxZ * uyN + uxZ * uyZ + uxZ * uyP\n              + uxP * uyN + uxP * uyZ + uxP * uyP;\n        wcSum := uxN * uyN * (-30.0)\n               + uxN * uyZ * (-20.0)\n               + uxN * uyP * (-10.0)\n               + uxZ * uyN * (-10.0)\n               + uxZ * uyZ * 0.0\n               + uxZ * uyP * 10.0\n               + uxP * uyN * 10.0\n               + uxP * uyZ * 20.0\n               + uxP * uyP * 30.0;\n\n        IF wSum > 0.0 THEN\n            correction := wcSum / wSum;\n        ELSE\n            correction := 0.0;\n        END_IF\n\n        power := LIMIT(0.0, bias + correction, 100.0);\n\n        ePrev := e;\n        histValid := TRUE;\n    END_IF\n\n    lastReset := resetBtn;\n\nEND_FUNCTION_BLOCK",
