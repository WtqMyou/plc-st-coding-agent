      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn : BOOL;\n    resetBtn : BOOL;\n    doneSensor : BOOL;\n    targetVol : REAL;\n    flowVol : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen : BOOL;\n    fillsToday : INT;\nEND_VAR\nVAR\n    startBtn_prev : BOOL;\n    resetBtn_prev : BOOL;\n    is_filling : BOOL;\n    accumulated_volume : REAL;\n    waiting_for_done : BOOL;\n    start_rising : BOOL;\n    reset_rising : BOOL;\nEND_VAR\n\nstart_rising := startBtn AND NOT startBtn_prev;\nreset_rising := resetBtn AND NOT resetBtn_prev;\n\nIF reset_rising THEN\n    fillsToday := 0;\n    valveOpen := FALSE;\n    accumulated_volume := 0.0;\n    waiting_for_done := FALSE;\n    is_filling := FALSE;\nELSE\n    IF start_rising AND NOT is_filling THEN\n        waiting_for_done := FALSE;\n        is_filling := TRUE;\n        accumulated_volume := 0.0;\n    END_IF;\n\n    IF is_filling THEN\n        accumulated_volume := accumulated_volume + flowVol;\n        IF accumulated_volume >= targetVol THEN\n            valveOpen := FALSE;\n            is_filling := FALSE;\n            waiting_for_done := TRUE;\n        ELSE\n            valveOpen := TRUE;\n        END_IF;\n    ELSE\n        valveOpen := FALSE;\n        IF waiting_for_done AND doneSensor THEN\n            IF fillsToday < 32767 THEN\n                fillsToday := fillsToday + 1;\n            END_IF;\n            waiting_for_done := FALSE;\n        END_IF;\n    END_IF;\nEND_IF;\n\nstartBtn_prev := startBtn;\nresetBtn_prev := resetBtn;\n\nEND_FUNCTION_BLOCK",
