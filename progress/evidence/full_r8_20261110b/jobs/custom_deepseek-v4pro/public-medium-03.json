      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    average : LREAL;\n    windowSizeReached : BOOL;\n    error : BOOL;\n    status : WORD;\nEND_VAR\nVAR\n    buffer : ARRAY [0..99] OF LREAL;\n    count : INT := 0;\n    writeIndex : INT := 0;\n    lastTrigger : BOOL := FALSE;\n    rising : BOOL;\n    sum : LREAL;\n    i : INT;\n    startIndex : INT;\n    validRead : BOOL;\n    firstScan : BOOL := TRUE;\nEND_VAR\n\n// 首次扫描初始化\nIF firstScan THEN\n    count := 0;\n    writeIndex := 0;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    firstScan := FALSE;\nEND_IF\n\n// 计算 trigger 上升沿\nrising := trigger AND NOT lastTrigger;\n\n// 设置错误状态与状态码\nIF (windowSize < 1) OR (windowSize > 100) THEN\n    error := TRUE;\n    status := 16#8200;\nELSE\n    error := FALSE;\n    status := 16#0000;\nEND_IF\n\n// 复位处理（优先级高于读取）\nIF reset THEN\n    count := 0;\n    writeIndex := 0;\n    average := 0.0;\n    windowSizeReached := FALSE;\n    lastTrigger := trigger;  // 防止复位解除后当前高电平被误判为上升沿\nELSE\n    // 判断是否有读取请求\n    IF cyclicExecution THEN\n        validRead := TRUE;\n    ELSE\n        validRead := rising;\n    END_IF\n\n    IF validRead THEN\n        // 仅在窗口合法时更新\n        IF NOT error THEN\n            // 窗口缩小可能使 count 大于 windowSize，截断至窗口大小\n            IF count > windowSize THEN\n                count := windowSize;\n            END_IF\n\n            // 写入新样本（环形缓冲区）\n            buffer[writeIndex] := value;\n            writeIndex := (writeIndex + 1) MOD 100;\n            IF count < windowSize THEN\n                count := count + 1;\n            END_IF\n\n            // 计算移动平均\n            IF count > 0 THEN\n                sum := 0.0;\n                startIndex := (writeIndex - count + 100) MOD 100;\n                FOR i := 0 TO count - 1 DO\n                    sum := sum + buffer[(startIndex + i) MOD 100];\n                END_FOR\n                average := sum / INT_TO_LREAL(count);\n            ELSE\n                average := 0.0;\n            END_IF\n\n            // 设置窗口满标志\n            IF count >= windowSize THEN\n                windowSizeReached := TRUE;\n            ELSE\n                windowSizeReached := FALSE;\n            END_IF\n        END_IF\n    END_IF\nEND_IF\n\n// 更新 lastTrigger（对所有情况执行，复位分支已设置相同值，此处保持一致性）\nlastTrigger := trigger;\n\nEND_FUNCTION_BLOCK",
