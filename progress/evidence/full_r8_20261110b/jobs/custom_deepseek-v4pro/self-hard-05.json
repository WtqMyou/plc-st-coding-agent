      "idx": 0,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    runRequest : BOOL;\n    flameOK : BOOL;\n    o2Valid : BOOL;\n    o2PV : REAL;\n    baseAir : REAL;\n    resetBtn : BOOL;\nEND_VAR\nVAR_OUTPUT\n    fuelPermit : BOOL;\n    trimEnable : BOOL;\n    airTrim : REAL;\n    airCommand : REAL;\n    tripLatched : BOOL;\n    o2Fault : BOOL;\nEND_VAR\nVAR\n    prevResetBtn : BOOL;\n    resetRising : BOOL;\n    rawTrim : REAL;\n    clampedTrim : REAL;\n    rawCommand : REAL;\n    clampedCommand : REAL;\nEND_VAR\n\n// Reset button rising edge\nresetRising := resetBtn AND NOT prevResetBtn;\n\n// Trip latch logic\nIF (runRequest AND NOT flameOK) THEN\n    tripLatched := TRUE;\nELSIF (resetRising AND NOT runRequest AND NOT flameOK) THEN\n    tripLatched := FALSE;\nEND_IF;\n\n// Fuel permit\nfuelPermit := runRequest AND flameOK AND NOT tripLatched;\n\n// O2 fault\no2Fault := (NOT o2Valid) OR (o2PV < 0.0) OR (o2PV > 21.0);\n\n// Trim enable\ntrimEnable := fuelPermit AND NOT o2Fault;\n\n// Air trim calculation\nrawTrim := 2.0 * (2.0 - o2PV);\nIF rawTrim > 10.0 THEN\n    clampedTrim := 10.0;\nELSIF rawTrim < -10.0 THEN\n    clampedTrim := -10.0;\nELSE\n    clampedTrim := rawTrim;\nEND_IF;\n\nIF trimEnable THEN\n    airTrim := clampedTrim;\nELSE\n    airTrim := 0.0;\nEND_IF;\n\n// Air command calculation\nrawCommand := baseAir + airTrim;\nIF rawCommand > 100.0 THEN\n    clampedCommand := 100.0;\nELSIF rawCommand < 0.0 THEN\n    clampedCommand := 0.0;\nELSE\n    clampedCommand := rawCommand;\nEND_IF;\n\nIF fuelPermit THEN\n    airCommand := clampedCommand;\nELSE\n    airCommand := 0.0;\nEND_IF;\n\n// Update previous reset button state\nprevResetBtn := resetBtn;\n\nEND_FUNCTION_BLOCK",
