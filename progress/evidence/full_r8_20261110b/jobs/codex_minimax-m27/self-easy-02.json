      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    tankLevel : REAL;\n    outletFlow : REAL;\n    inletPermit : BOOL;\n    resetBtn : BOOL;\nEND_VAR\nVAR_OUTPUT\n    pumpRun : BOOL;\n    alarmHigh : BOOL;\n    alarmLow : BOOL;\n    outletValveOpen : BOOL;\nEND_VAR\nVAR\n    prevResetBtn : BOOL := FALSE;\nEND_VAR\n\n// Rising edge detection\nrisingReset := resetBtn AND NOT prevResetBtn;\n\n// High level alarm: latch on danger, clear only when safe + reset edge\nalarmHigh := alarmHigh OR (tankLevel >= 85.0);\nIF risingReset AND tankLevel < 85.0 THEN\n    alarmHigh := FALSE;\nEND_IF\n\n// Low level alarm: latch on danger, clear only when safe + reset edge\nalarmLow := alarmLow OR (tankLevel <= 15.0);\nIF risingReset AND tankLevel > 15.0 THEN\n    alarmLow := FALSE;\nEND_IF\n\n// Pump runs only when permitted and no alarms active\npumpRun := inletPermit AND NOT alarmHigh AND NOT alarmLow;\n\n// Outlet valve closed only when low alarm is latched\noutletValveOpen := NOT alarmLow;\n\n// Update button history for next scan\nprevResetBtn := resetBtn;\nEND_FUNCTION_BLOCK",
