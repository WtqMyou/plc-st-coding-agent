      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn   : BOOL;\n    resetBtn   : BOOL;\n    doneSensor : BOOL;\n    targetVol  : REAL;\n    flowVol    : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen  : BOOL;\n    fillsToday : INT;\nEND_VAR\nVAR\n    prevStartBtn  : BOOL := FALSE;\n    prevResetBtn  : BOOL := FALSE;\n    prevValveOpen : BOOL := FALSE;\n    prevTargetVol : REAL := 0.0;\n    accumulated   : REAL := 0.0;\n    fillingDone   : BOOL := FALSE;\n    state         : INT := 0; // 0=IDLE, 1=FILLING, 2=WAIT\nEND_VAR\n\nVAR\n    startBtnR  : BOOL;\n    resetBtnR  : BOOL;\n    valveCloseR: BOOL;\nEND_VAR\n\n// Rising edge detection\nstartBtnR  := startBtn  AND NOT prevStartBtn;\nresetBtnR  := resetBtn  AND NOT prevResetBtn;\nvalveCloseR:= prevValveOpen AND NOT valveOpen;\n\n// Reset has highest priority\nIF resetBtnR THEN\n    valveOpen   := FALSE;\n    fillsToday  := 0;\n    accumulated := 0.0;\n    fillingDone := FALSE;\n    state       := 0;\nELSE\n    CASE state OF\n        0: // IDLE\n            fillsToday := fillsToday; // hold\n            accumulated := 0.0;\n            fillingDone := FALSE;\n            IF startBtnR THEN\n                valveOpen := (flowVol < targetVol);\n                accumulated := flowVol;\n                IF flowVol >= targetVol THEN\n                    state := 2; // WAIT\n                    fillingDone := TRUE;\n                ELSE\n                    state := 1; // FILLING\n                END_IF\n            ELSE\n                valveOpen := FALSE;\n            END_IF\n\n        1: // FILLING\n            accumulated := accumulated + flowVol;\n            IF accumulated >= targetVol THEN\n                valveOpen   := FALSE;\n                fillingDone := TRUE;\n                state       := 2;\n            ELSE\n                valveOpen := TRUE;\n            END_IF\n\n        2: // WAIT for doneSensor confirmation\n            valveOpen := FALSE;\n            IF startBtnR THEN\n                accumulated := flowVol;\n                fillingDone := FALSE;\n                IF flowVol >= targetVol THEN\n                    state := 2;\n                    fillingDone := TRUE;\n                ELSE\n                    valveOpen := (flowVol < targetVol);\n                    state := 1;\n                END_IF\n            ELSIF doneSensor THEN\n                IF fillsToday < 32767 THEN\n                    fillsToday := fillsToday + 1;\n                END_IF\n                fillingDone := FALSE;\n                state := 0;\n            END_IF\n    END_CASE\nEND_IF\n\n// History update\nprevStartBtn  := startBtn;\nprevResetBtn  := resetBtn;\nprevValveOpen := valveOpen;\nprevTargetVol := targetVol;\nEND_FUNCTION_BLOCK",
