      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    Gap_Exceeded : BOOL;\n    Weld_E_Stop_NC : BOOL;\n    DebounceTime : TIME;\nEND_VAR\nVAR_OUTPUT\n    Operator_Alert : BOOL := FALSE;\n    Weld_Soft_Start_Active : BOOL := TRUE;\nEND_VAR\nVAR\n    First_Scan : BOOL := TRUE;\n    ConsecutiveCount : INT := 0;\n    InitScanCounter : INT := 0;\nEND_VAR\n\n    IF First_Scan THEN\n        First_Scan := FALSE;\n        Operator_Alert := FALSE;\n        Weld_Soft_Start_Active := TRUE;\n        ConsecutiveCount := 0;\n        InitScanCounter := 0;\n    ELSE\n        InitScanCounter := InitScanCounter + 1;\n\n        IF InitScanCounter <= 5 THEN\n            Weld_Soft_Start_Active := TRUE;\n            Operator_Alert := FALSE;\n            ConsecutiveCount := 0;\n        ELSE\n            Weld_Soft_Start_Active := FALSE;\n\n            IF NOT Weld_E_Stop_NC THEN\n                Operator_Alert := FALSE;\n                ConsecutiveCount := 0;\n            ELSIF Gap_Exceeded THEN\n                ConsecutiveCount := ConsecutiveCount + 1;\n                IF ConsecutiveCount >= 3 THEN\n                    Operator_Alert := TRUE;\n                ELSE\n                    Operator_Alert := FALSE;\n                END_IF\n            ELSE\n                ConsecutiveCount := 0;\n                Operator_Alert := FALSE;\n            END_IF\n        END_IF\n    END_IF\nEND_FUNCTION_BLOCK",
