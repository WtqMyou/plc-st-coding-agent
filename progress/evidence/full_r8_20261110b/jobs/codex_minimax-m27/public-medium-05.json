      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    Mode            : BOOL;\n    ForwardButton   : BOOL;\n    ReverseButton   : BOOL;\n    SensorA         : BOOL;\n    SensorB         : BOOL;\n    SensorC         : BOOL;\n    ButtonA         : BOOL;\n    ButtonB         : BOOL;\n    ButtonC         : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward    : BOOL;\n    MotorReverse    : BOOL;\n    CompletionLight : BOOL;\nEND_VAR\nVAR\n    phase           : INT;  // 0=idle, 1=atA, 2=AB, 3=atB, 4=BC, 5=atC\n    prevMode        : BOOL;\n    prevSensorC     : BOOL;\n    prevCompletionLight : BOOL;\nEND_VAR\n\n    prevMode := Mode;\n    prevSensorC := SensorC;\n    prevCompletionLight := CompletionLight;\n\n    IF phase = 0 THEN\n        MotorForward := FALSE;\n        IF Mode AND SensorA AND ButtonA THEN\n            phase := 2;\n        END_IF\n    ELSIF phase = 1 THEN\n        MotorForward := FALSE;\n        IF ButtonA THEN\n            phase := 2;\n        END_IF\n    ELSIF phase = 2 THEN\n        MotorForward := TRUE;\n        IF SensorB THEN\n            MotorForward := FALSE;\n            phase := 3;\n        END_IF\n    ELSIF phase = 3 THEN\n        MotorForward := FALSE;\n        IF ButtonB THEN\n            phase := 4;\n        END_IF\n    ELSIF phase = 4 THEN\n        MotorForward := TRUE;\n        IF SensorC THEN\n            MotorForward := FALSE;\n            phase := 5;\n        END_IF\n    ELSIF phase = 5 THEN\n        MotorForward := FALSE;\n        CompletionLight := Mode AND SensorC AND ButtonC;\n        IF NOT SensorC THEN\n            CompletionLight := FALSE;\n            phase := 0;\n        END_IF\n    END_IF\n\n    MotorReverse := FALSE;\n    IF NOT Mode THEN\n        IF ForwardButton AND NOT ReverseButton THEN\n            MotorForward := TRUE;\n        ELSIF ReverseButton AND NOT ForwardButton THEN\n            MotorReverse := TRUE;\n        ELSE\n            MotorForward := FALSE;\n        END_IF\n        IF prevMode THEN\n            phase := 0;\n        END_IF\n    END_IF\nEND_FUNCTION_BLOCK",
