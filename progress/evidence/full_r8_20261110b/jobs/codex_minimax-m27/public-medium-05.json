    {
      "idx": 1,
      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    Mode            : BOOL;\n    ForwardButton   : BOOL;\n    ReverseButton   : BOOL;\n    SensorA         : BOOL;\n    SensorB         : BOOL;\n    SensorC         : BOOL;\n    ButtonA         : BOOL;\n    ButtonB         : BOOL;\n    ButtonC         : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward    : BOOL;\n    MotorReverse    : BOOL;\n    CompletionLight : BOOL;\nEND_VAR\nVAR\n    phase           : INT;  // 0=idle, 1=waitA, 2=AtoB, 3=waitB, 4=BtoC, 5=waitC\n    prevMode        : BOOL;\nEND_VAR\n\n    prevMode := Mode;\n\n    // Mode transitions\n    IF NOT Mode THEN\n        phase := 0;\n    ELSIF prevMode THEN\n        // Already in auto, check sensor arrivals\n        IF phase = 2 AND SensorB THEN\n            phase := 3;\n        ELSIF phase = 4 AND SensorC THEN\n            phase := 5;\n        ELSIF phase = 5 AND NOT SensorC THEN\n            phase := 0;\n        END_IF\n    ELSE\n        // Rising edge into auto mode\n        IF SensorA AND ButtonA THEN\n            phase := 1;\n        END_IF\n    END_IF;\n\n    // Phase progression\n    IF phase = 1 AND NOT ButtonA THEN\n        phase := 2;\n    ELSIF phase = 3 AND NOT ButtonB THEN\n        phase := 4;\n    END_IF;\n\n    // Motor outputs\n    MotorForward := FALSE;\n    MotorReverse := FALSE;\n\n    IF NOT Mode THEN\n        // Manual mode with interlock\n        IF ForwardButton AND NOT ReverseButton THEN\n            MotorForward := TRUE;\n        ELSIF ReverseButton AND NOT ForwardButton THEN\n            MotorReverse := TRUE;\n        END_IF;\n    ELSE\n        // Automatic mode\n        IF phase = 2 THEN\n            MotorForward := TRUE;\n        ELSIF phase = 4 THEN\n            MotorForward := TRUE;\n        END_IF;\n    END_IF;\n\n    // Completion light\n    CompletionLight := FALSE;\n    IF Mode AND phase = 5 AND SensorC THEN\n        CompletionLight := TRUE;\n    END_IF;\nEND_FUNCTION_BLOCK",
