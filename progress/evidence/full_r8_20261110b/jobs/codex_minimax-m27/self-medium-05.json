      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enable       : BOOL;\n    resetBtn     : BOOL;\n    scanSeconds  : LREAL;\n    steamFlow    : LREAL;\n    fuelFlow     : LREAL;\n    steamTemp    : LREAL;\n    steamPressure: LREAL;\nEND_VAR\nVAR_OUTPUT\n    qualified    : BOOL;\n    dataFault    : BOOL;\n    qualifiedTon : LREAL;\n    fuelTon      : LREAL;\n    revenue      : LREAL;\n    cost         : LREAL;\n    netProfit    : LREAL;\nEND_VAR\nVAR\n    prevResetBtn : BOOL := FALSE;\nEND_VAR\n// ---- 边沿检测 ----\nresetRising := resetBtn AND NOT prevResetBtn;\n\n// ---- 合格判据（闭区间） ----\nqualified := (steamTemp >= 447.0) AND (steamTemp <= 453.0)\n             AND (steamPressure >= 3750.0) AND (steamPressure <= 3850.0);\n\n// ---- 数据故障判据 ----\ndataFault := (scanSeconds <= 0.0) OR (scanSeconds > 10.0)\n             OR (steamFlow < 0.0) OR (steamFlow > 90.0)\n             OR (fuelFlow < 0.0) OR (fuelFlow > 6.0);\n\n// ---- 累计（复位上升沿优先于故障冻结） ----\nIF resetRising THEN\n    qualifiedTon := 0.0;\n    fuelTon      := 0.0;\nELSIF enable AND NOT dataFault THEN\n    qualifiedTon := qualifiedTon + steamFlow * scanSeconds / 1000.0;\n    fuelTon      := fuelTon      + fuelFlow    * scanSeconds / 1000.0;\nEND_IF;\n\n// ---- 金额计算（每拍更新） ----\nrevenue   := qualifiedTon * 280.0;\ncost      := fuelTon      * 1500.0;\nnetProfit := revenue - cost;\n\n// ---- 更新历史变量 ----\nprevResetBtn := resetBtn;\nEND_FUNCTION_BLOCK",
