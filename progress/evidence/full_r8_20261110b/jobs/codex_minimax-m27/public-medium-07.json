      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    OCCUPANCY_DETECTED    : BOOL;\n    ENERGY_SAVING_MODE    : BOOL;\n    HVAC_MODE_SELECTOR    : INT;\nEND_VAR\nVAR_OUTPUT\n    SUPPLY_FAN_RUN        : BOOL := FALSE;\n    TEMP_SETPOINT_ADJUST  : INT  := 0;\nEND_VAR\nVAR\n    OccupancyCounter      : INT := 0;\nEND_VAR\n\n// Temperature setpoint adjustment (initialized at power-up)\nIF HVAC_MODE_SELECTOR = 0 THEN\n    IF OCCUPANCY_DETECTED THEN\n        TEMP_SETPOINT_ADJUST := 0;\n    ELSIF ENERGY_SAVING_MODE THEN\n        TEMP_SETPOINT_ADJUST := 3;\n    ELSE\n        TEMP_SETPOINT_ADJUST := 2;\n    END_IF\nELSIF HVAC_MODE_SELECTOR = 1 THEN\n    IF OCCUPANCY_DETECTED THEN\n        TEMP_SETPOINT_ADJUST := 0;\n    ELSE\n        TEMP_SETPOINT_ADJUST := 1;\n    END_IF\nELSIF HVAC_MODE_SELECTOR = 2 THEN\n    IF OCCUPANCY_DETECTED THEN\n        TEMP_SETPOINT_ADJUST := 0;\n    ELSE\n        TEMP_SETPOINT_ADJUST := 4;\n    END_IF\nELSE\n    TEMP_SETPOINT_ADJUST := 4;\nEND_IF\n\nIF TEMP_SETPOINT_ADJUST > 4 THEN\n    TEMP_SETPOINT_ADJUST := 4;\nELSIF TEMP_SETPOINT_ADJUST < -4 THEN\n    TEMP_SETPOINT_ADJUST := -4;\nEND_IF;\n\n// Supply fan delay control: 30-scan delay, level-reset\nIF OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3 THEN\n    IF OccupancyCounter < 30 THEN\n        OccupancyCounter := OccupancyCounter + 1;\n    END_IF;\n    IF OccupancyCounter >= 30 THEN\n        SUPPLY_FAN_RUN := TRUE;\n    ELSE\n        SUPPLY_FAN_RUN := FALSE;\n    END_IF;\nELSE\n    OccupancyCounter := 0;\n    SUPPLY_FAN_RUN := FALSE;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
