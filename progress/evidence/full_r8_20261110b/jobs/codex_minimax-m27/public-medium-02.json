      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    count : DINT;\nEND_VAR\nVAR_IN_OUT\n    analogValues : ARRAY[1..8] OF INT;\n    channels : ARRAY[1..8] OF ST_AnalogChannel;\nEND_VAR\nVAR\n    i : INT;\nEND_VAR\n\nIF count < 1 THEN\n    RETURN;\nEND_IF;\n\nFOR i := 1 TO INT_OF_DINT(count) DO\n    IF NOT channels[i].enable THEN\n        CONTINUE;\n    END_IF;\n\n    IF channels[i].measuringMode < 0 OR channels[i].measuringMode > 2 THEN\n        channels[i].retVal := 16#8001;\n        CONTINUE;\n    END_IF;\n\n    IF channels[i].hiLIM <= channels[i].loLIM THEN\n        channels[i].retVal := 16#8002;\n        CONTINUE;\n    END_IF;\n\n    CASE channels[i].measuringMode OF\n        0:\n            IF channels[i].bipolar THEN\n                channels[i].outputValue := channels[i].loLIM +\n                    (INT_TO_REAL(analogValues[i]) + 27648.0) *\n                    (channels[i].hiLIM - channels[i].loLIM) / 55296.0;\n            ELSE\n                channels[i].outputValue := channels[i].loLIM +\n                    INT_TO_REAL(analogValues[i]) *\n                    (channels[i].hiLIM - channels[i].loLIM) / 27648.0;\n            END_IF;\n        1:\n            channels[i].outputValue := INT_TO_REAL(analogValues[i]) / 10.0;\n        2:\n            channels[i].outputValue := INT_TO_REAL(analogValues[i]) / 100.0;\n    END_CASE;\n\n    channels[i].retVal := 16#0000;\nEND_FOR;\n\nEND_FUNCTION_BLOCK",
