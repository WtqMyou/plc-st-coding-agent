      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    flowLow   : BOOL;\n    ackBtn    : BOOL;\n    sensorOK  : BOOL;\nEND_VAR\nVAR_OUTPUT\n    alarmActive : BOOL;\n    alarmAcked  : BOOL;\n    highHigh    : BOOL;\nEND_VAR\nVAR\n    prev_flowLow : BOOL := FALSE;\n    prev_ackBtn  : BOOL := FALSE;\n    state        : INT := 0;\nEND_VAR\n\n    highHigh := NOT sensorOK;\n\n    IF state = 0 THEN\n        IF flowLow THEN\n            alarmActive := TRUE;\n            alarmAcked := FALSE;\n            state := 1;\n        ELSE\n            alarmActive := FALSE;\n            alarmAcked := FALSE;\n        END_IF\n    ELSIF state = 1 THEN\n        IF NOT flowLow AND prev_flowLow THEN\n            alarmActive := TRUE;\n            alarmAcked := TRUE;\n        ELSIF ackBtn AND NOT prev_ackBtn AND flowLow THEN\n            alarmActive := FALSE;\n            alarmAcked := FALSE;\n            state := 0;\n        ELSE\n            alarmActive := TRUE;\n            alarmAcked := (flowLow AND ackBtn AND NOT prev_ackBtn) OR alarmAcked;\n        END_IF\n    END_IF\n\n    prev_flowLow := flowLow;\n    prev_ackBtn := ackBtn;\nEND_FUNCTION_BLOCK",
