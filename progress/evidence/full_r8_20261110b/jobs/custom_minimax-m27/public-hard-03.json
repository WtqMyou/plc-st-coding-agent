      "code": "TYPE ST_Recipe :\nSTRUCT\n    recipeID                : INT;\n    ingredientType          : INT;\n    ingredientRatio         : REAL;\n    productionTemperature   : REAL;\nEND_STRUCT\nEND_TYPE\n\nFUNCTION_BLOCK FB\nVAR_INPUT\n    addRecipe      : BOOL;\n    deleteRecipe   : BOOL;\n    modifyRecipe   : BOOL;\n    queryRecipe    : BOOL;\n    recipeIn       : ST_Recipe;\nEND_VAR\nVAR_OUTPUT\n    recipeAdded          : BOOL;\n    recipeDeleted        : BOOL;\n    recipeModified       : BOOL;\n    recipeQueryResult    : ST_Recipe;\n    error                : BOOL;\n    status               : WORD;\nEND_VAR\nVAR_IN_OUT\n    recipe : ARRAY[1..10] OF ST_Recipe;\nEND_VAR\nVAR\n    prevAddRecipe    : BOOL := FALSE;\n    prevDeleteRecipe : BOOL := FALSE;\n    prevModifyRecipe : BOOL := FALSE;\n    prevQueryRecipe  : BOOL := FALSE;\n    risingAdd        : BOOL;\n    risingDelete     : BOOL;\n    risingModify     : BOOL;\n    risingQuery      : BOOL;\nEND_VAR\n\nCONST\n    STATUS_OK       : WORD := 16#0000;\n    ERR_NOT_FOUND   : WORD := 16#8001;\n    ERR_DUPLICATE   : WORD := 16#8002;\n    ERR_FULL        : WORD := 16#8003;\n    ERR_DEL_NOT_FND : WORD := 16#8004;\n    ERR_MOD_NOT_FND : WORD := 16#8005;\nEND_CONST\n\n    risingAdd    := addRecipe AND NOT prevAddRecipe;\n    risingDelete := deleteRecipe AND NOT prevDeleteRecipe;\n    risingModify := modifyRecipe AND NOT prevModifyRecipe;\n    risingQuery  := queryRecipe AND NOT prevQueryRecipe;\n\n    prevAddRecipe    := addRecipe;\n    prevDeleteRecipe := deleteRecipe;\n    prevModifyRecipe := modifyRecipe;\n    prevQueryRecipe  := queryRecipe;\n\n    recipeAdded     := FALSE;\n    recipeDeleted   := FALSE;\n    recipeModified  := FALSE;\n    recipeQueryResult.recipeID := 0;\n    error           := FALSE;\n    status          := STATUS_OK;\n\n    IF risingQuery THEN\n        error := TRUE;\n        status := ERR_NOT_FOUND;\n        IF recipeIn.recipeID <> 0 THEN\n            FOR i := 1 TO 10 DO\n                IF recipe[i].recipeID = recipeIn.recipeID THEN\n                    recipeQueryResult := recipe[i];\n                    error   := FALSE;\n                    status  := STATUS_OK;\n                    EXIT;\n                END_IF\n            END_FOR\n        END_IF\n    ELSIF risingAdd THEN\n        IF recipeIn.recipeID <> 0 THEN\n            duplicateFound := FALSE;\n            emptySlotIndex := 0;\n            FOR i := 1 TO 10 DO\n                IF recipe[i].recipeID = recipeIn.recipeID THEN\n                    duplicateFound := TRUE;\n                    EXIT;\n                END_IF\n            END_FOR\n            IF duplicateFound THEN\n                error  := TRUE;\n                status := ERR_DUPLICATE;\n            ELSE\n                FOR i := 1 TO 10 DO\n                    IF recipe[i].recipeID = 0 THEN\n                        emptySlotIndex := i;\n                        EXIT;\n                    END_IF\n                END_FOR\n                IF emptySlotIndex = 0 THEN\n                    error  := TRUE;\n                    status := ERR_FULL;\n                ELSE\n                    recipe[emptySlotIndex] := recipeIn;\n                    recipeAdded := TRUE;\n                END_IF\n            END_IF\n        END_IF\n    ELSIF risingDelete THEN\n        IF recipeIn.recipeID <> 0 THEN\n            found := FALSE;\n            FOR i := 1 TO 10 DO\n                IF recipe[i].recipeID = recipeIn.recipeID THEN\n                    recipe[i].recipeID := 0;\n                    recipeDeleted := TRUE;\n                    found := TRUE;\n                    EXIT;\n                END_IF\n            END_FOR\n            IF NOT found THEN\n                error  := TRUE;\n                status := ERR_DEL_NOT_FND;\n            END_IF\n        END_IF\n    ELSIF risingModify THEN\n        IF recipeIn.recipeID <> 0 THEN\n            found := FALSE;\n            FOR i := 1 TO 10 DO\n                IF recipe[i].recipeID = recipeIn.recipeID THEN\n                    recipe[i] := recipeIn;\n                    recipeModified := TRUE;\n                    found := TRUE;\n                    EXIT;\n                END_IF\n            END_FOR\n            IF NOT found THEN\n                error  := TRUE;\n                status := ERR_MOD_NOT_FND;\n            END_IF\n        END_IF\n    END_IF\nEND_FUNCTION_BLOCK",
