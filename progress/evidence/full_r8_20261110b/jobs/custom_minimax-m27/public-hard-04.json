      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    enqueue  : BOOL;\n    dequeue  : BOOL;\n    reset    : BOOL;\n    capacity : DINT;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT := 0;\n    status       : WORD  := 16#0000;\nEND_VAR\nVAR_IN_OUT\n    item   : DINT;\n    buffer : ARRAY[1..4] OF DINT;\nEND_VAR\nVAR\n    head       : DINT := 0;\n    tail       : DINT := 0;\n    prevEnqueue : BOOL := FALSE;\n    prevDequeue : BOOL := FALSE;\nEND_VAR\n\n// Priority 1: Reset (level-triggered, takes precedence)\nIF reset THEN\n    elementCount := 0;\n    head := 0;\n    tail := 0;\n    status := 16#0000;\n// Priority 2: Enqueue (rising edge, rejected if dequeue is active)\nELSIF enqueue AND NOT prevEnqueue AND NOT dequeue THEN\n    IF elementCount < capacity THEN\n        buffer[tail + 1] := item;\n        tail := (tail + 1) MOD capacity;\n        elementCount := elementCount + 1;\n        status := 16#0000;\n    ELSE\n        status := 16#8002;\n    END_IF;\n// Priority 3: Dequeue (rising edge, rejected if enqueue is active)\nELSIF dequeue AND NOT prevDequeue AND NOT enqueue THEN\n    IF elementCount > 0 THEN\n        item := buffer[head + 1];\n        head := (head + 1) MOD capacity;\n        elementCount := elementCount - 1;\n        status := 16#0000;\n    ELSE\n        status := 16#8001;\n    END_IF;\nELSE\n    status := 16#0000;\nEND_IF;\n\n// Update edge-detection history\nprevEnqueue := enqueue;\nprevDequeue := dequeue;\n\nEND_FUNCTION_BLOCK",
