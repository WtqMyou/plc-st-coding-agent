      "code": "FUNCTION_BLOCK FB\nVAR_INPUT\n    startBtn    : BOOL;\n    resetBtn    : BOOL;\n    doneSensor  : BOOL;\n    targetVol   : REAL;\n    flowVol     : REAL;\nEND_VAR\nVAR_OUTPUT\n    valveOpen   : BOOL;\n    fillsToday  : INT := 0;\nEND_VAR\nVAR\n    prevStartBtn    : BOOL := FALSE;\n    prevResetBtn    : BOOL := FALSE;\n    accumulatedVol  : REAL := 0.0;\n    state           : INT := 0; // 0=IDLE, 1=FILLING, 2=WAIT_CONFIRM\nEND_VAR\nVAR_CONSTANT\n    IDLE           : INT := 0;\n    FILLING        : INT := 1;\n    WAIT_CONFIRM   : INT := 2;\nEND_VAR\n\n    // Detect rising edges\n    VAR\n        startRising  : BOOL;\n        resetRising  : BOOL;\n    END_VAR\n    startRising  := startBtn AND NOT prevStartBtn;\n    resetRising  := resetBtn AND NOT prevResetBtn;\n\n    // S7 / N10-S7: reset edge has highest priority - clears all immediately\n    IF resetRising THEN\n        fillsToday      := 0;\n        accumulatedVol  := 0.0;\n        state           := IDLE;\n    END_IF\n\n    // State machine\n    IF state = IDLE THEN\n        IF startRising THEN\n            accumulatedVol  := flowVol;\n            state           := FILLING;\n        END_IF\n\n    ELSIF state = FILLING THEN\n        accumulatedVol := accumulatedVol + flowVol;\n        IF accumulatedVol >= targetVol THEN\n            state := WAIT_CONFIRM;\n        END_IF\n\n    ELSIF state = WAIT_CONFIRM THEN\n        // N10-S10: valve closed this scan AND sensor confirmed AND not saturated\n        IF doneSensor AND (fillsToday < 32767) THEN\n            fillsToday := fillsToday + 1;\n            state      := IDLE;\n        END_IF\n    END_IF\n\n    // Valve output: open when filling, closed otherwise\n    valveOpen := (state = FILLING);\n\n    // Reset overrides: close valve and clear on reset edge (redundant safety)\n    IF resetRising THEN\n        valveOpen := FALSE;\n    END_IF\n\n    // Update previous-cycle values for next scan edge detection\n    prevStartBtn  := startBtn;\n    prevResetBtn  := resetBtn;\nEND_FUNCTION_BLOCK",
