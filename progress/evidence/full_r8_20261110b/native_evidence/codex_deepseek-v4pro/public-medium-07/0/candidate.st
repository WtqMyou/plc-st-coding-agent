FUNCTION_BLOCK FB
VAR_INPUT
    OCCUPANCY_DETECTED : BOOL;
    ENERGY_SAVING_MODE : BOOL;
    HVAC_MODE_SELECTOR : INT;
END_VAR
VAR_OUTPUT
    SUPPLY_FAN_RUN : BOOL;
    TEMP_SETPOINT_ADJUST : INT;
END_VAR
VAR
    FAN_START_COUNTER : INT := 0;
END_VAR

SUPPLY_FAN_RUN := FALSE;
TEMP_SETPOINT_ADJUST := 0;

IF OCCUPANCY_DETECTED AND (HVAC_MODE_SELECTOR >= 0) AND (HVAC_MODE_SELECTOR <= 2) THEN
    IF FAN_START_COUNTER < 30 THEN
        FAN_START_COUNTER := FAN_START_COUNTER + 1;
    END_IF;
ELSE
    FAN_START_COUNTER := 0;
END_IF;

SUPPLY_FAN_RUN := FAN_START_COUNTER >= 30;

IF HVAC_MODE_SELECTOR = 3 THEN
    TEMP_SETPOINT_ADJUST := 4;
ELSIF OCCUPANCY_DETECTED THEN
    TEMP_SETPOINT_ADJUST := 0;
ELSIF HVAC_MODE_SELECTOR = 0 THEN
    IF ENERGY_SAVING_MODE THEN
        TEMP_SETPOINT_ADJUST := 3;
    ELSE
        TEMP_SETPOINT_ADJUST := 2;
    END_IF;
ELSIF HVAC_MODE_SELECTOR = 1 THEN
    TEMP_SETPOINT_ADJUST := 1;
ELSIF HVAC_MODE_SELECTOR = 2 THEN
    TEMP_SETPOINT_ADJUST := 4;
ELSE
    TEMP_SETPOINT_ADJUST := 0;
END_IF;

END_FUNCTION_BLOCK