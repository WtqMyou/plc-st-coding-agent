FUNCTION_BLOCK FB
VAR_INPUT
    DO_LOW: BOOL;
    AERATION_E_STOP_NC: BOOL;
END_VAR
VAR_OUTPUT
    BLOWER_RUN: BOOL;
    AERATION_BLOWER_CYCLE_COUNT: UINT;
END_VAR
VAR
    delayCounter: UINT;
    prevBLOWER_RUN: BOOL;
END_VAR

IF NOT (DO_LOW AND AERATION_E_STOP_NC) THEN
    BLOWER_RUN := FALSE;
    delayCounter := 0;
ELSE
    IF delayCounter < 5 THEN
        delayCounter := delayCounter + 1;
    END_IF;
    IF delayCounter >= 5 THEN
        BLOWER_RUN := TRUE;
    ELSE
        BLOWER_RUN := FALSE;
    END_IF;
END_IF;

IF BLOWER_RUN AND NOT prevBLOWER_RUN THEN
    IF AERATION_BLOWER_CYCLE_COUNT < 65535 THEN
        AERATION_BLOWER_CYCLE_COUNT := AERATION_BLOWER_CYCLE_COUNT + 1;
    END_IF;
END_IF;

prevBLOWER_RUN := BLOWER_RUN;

END_FUNCTION_BLOCK