FUNCTION_BLOCK FB
VAR_INPUT
    OCCUPANCY_DETECTED    : BOOL;
    ENERGY_SAVING_MODE    : BOOL;
    HVAC_MODE_SELECTOR    : INT;
END_VAR
VAR_OUTPUT
    SUPPLY_FAN_RUN        : BOOL := FALSE;
    TEMP_SETPOINT_ADJUST  : INT  := 0;
END_VAR
VAR
    OccupancyCounter      : INT := 0;
    FanRunning            : BOOL := FALSE;
END_VAR

// Temperature setpoint adjustment
IF HVAC_MODE_SELECTOR = 0 THEN
    IF OCCUPANCY_DETECTED THEN
        TEMP_SETPOINT_ADJUST := 0;
    ELSIF ENERGY_SAVING_MODE THEN
        TEMP_SETPOINT_ADJUST := 3;
    ELSE
        TEMP_SETPOINT_ADJUST := 2;
    END_IF
ELSIF HVAC_MODE_SELECTOR = 1 THEN
    IF OCCUPANCY_DETECTED THEN
        TEMP_SETPOINT_ADJUST := 0;
    ELSE
        TEMP_SETPOINT_ADJUST := 1;
    END_IF
ELSIF HVAC_MODE_SELECTOR = 2 THEN
    IF OCCUPANCY_DETECTED THEN
        TEMP_SETPOINT_ADJUST := 0;
    ELSE
        TEMP_SETPOINT_ADJUST := 4;
    END_IF
ELSE
    TEMP_SETPOINT_ADJUST := 4;
END_IF

IF TEMP_SETPOINT_ADJUST > 4 THEN
    TEMP_SETPOINT_ADJUST := 4;
ELSIF TEMP_SETPOINT_ADJUST < -4 THEN
    TEMP_SETPOINT_ADJUST := -4;
END_IF;

// Fan control with 30-scan startup latch
IF OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3 THEN
    IF NOT FanRunning THEN
        OccupancyCounter := OccupancyCounter + 1;
        IF OccupancyCounter >= 30 THEN
            FanRunning := TRUE;
        END_IF
    END_IF
ELSE
    OccupancyCounter := 0;
    FanRunning := FALSE;
END_IF

SUPPLY_FAN_RUN := FanRunning AND OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3;

END_FUNCTION_BLOCK