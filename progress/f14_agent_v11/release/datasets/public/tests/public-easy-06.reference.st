FUNCTION_BLOCK FB_AerationBlower
VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR
VAR_OUTPUT
    BLOWER_RUN : BOOL;
    AERATION_BLOWER_CYCLE_COUNT : UINT;
END_VAR
VAR
    startDelay : TON;
    wasRunning : BOOL;
END_VAR
startDelay(IN := DO_LOW AND AERATION_E_STOP_NC, PT := T#5s);
BLOWER_RUN := startDelay.Q;
IF BLOWER_RUN AND NOT wasRunning AND AERATION_BLOWER_CYCLE_COUNT < 65535 THEN
    AERATION_BLOWER_CYCLE_COUNT := AERATION_BLOWER_CYCLE_COUNT + 1;
END_IF;
wasRunning := BLOWER_RUN;
END_FUNCTION_BLOCK
